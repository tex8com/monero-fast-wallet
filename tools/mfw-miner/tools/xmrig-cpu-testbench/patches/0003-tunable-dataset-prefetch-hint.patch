+++ b/src/crypto/randomx/jit_compiler_x86_static.S
@@ -74,6 +74,10 @@ SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
 
 #define db .byte
 
+#ifndef XMRIG_DATASET_PREFETCH_MODE
+#define XMRIG_DATASET_PREFETCH_MODE 2
+#endif
+
 DECL(randomx_prefetch_scratchpad):
 	mov rdx, rax
 	and eax, RANDOMX_SCRATCHPAD_MASK
@@ -147,7 +151,13 @@ DECL(randomx_program_read_dataset):
 	#include "asm/program_read_dataset.inc"
 
 DECL(randomx_program_read_dataset_v2):
+#if XMRIG_DATASET_PREFETCH_MODE == 0
+	#include "asm/program_read_dataset_v2_none.inc"
+#elif XMRIG_DATASET_PREFETCH_MODE == 1
+	#include "asm/program_read_dataset_v2_t0.inc"
+#else
 	#include "asm/program_read_dataset_v2.inc"
+#endif
 
 DECL(randomx_program_read_dataset_sshash_init):
 	#include "asm/program_read_dataset_sshash_init.inc"
diff --git a/src/crypto/randomx/asm/program_read_dataset_v2_none.inc b/src/crypto/randomx/asm/program_read_dataset_v2_none.inc
new file mode 100644
--- /dev/null
+++ b/src/crypto/randomx/asm/program_read_dataset_v2_none.inc
@@ -0,0 +1,15 @@
+	mov ecx, ebp                       ;# ecx = ma
+	and ecx, RANDOMX_DATASET_BASE_MASK
+	xor r8, qword ptr [rdi+rcx]
+	xor rbp, rax                       ;# modify "ma"
+	mov edx, ebp                       ;# edx = "ma"
+	ror rbp, 32                        ;# swap "ma" and "mx"
+	and edx, RANDOMX_DATASET_BASE_MASK
+	.byte 0x0f, 0x1f, 0x40, 0x00       ;# 4-byte nop replaces prefetch
+	xor r9,  qword ptr [rdi+rcx+8]
+	xor r10, qword ptr [rdi+rcx+16]
+	xor r11, qword ptr [rdi+rcx+24]
+	xor r12, qword ptr [rdi+rcx+32]
+	xor r13, qword ptr [rdi+rcx+40]
+	xor r14, qword ptr [rdi+rcx+48]
+	xor r15, qword ptr [rdi+rcx+56]
