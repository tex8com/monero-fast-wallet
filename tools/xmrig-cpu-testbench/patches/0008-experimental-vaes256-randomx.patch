+#include <cstddef>
+#include <cstdint>
+#include <immintrin.h>
+
+
+#ifndef XMRIG_AES_PREFETCH_DISTANCE
+#define XMRIG_AES_PREFETCH_DISTANCE 7168
+#endif
+
+
+#define REVERSE_4(A, B, C, D) D, C, B, A
+
+
+alignas(64) static const uint32_t AES_HASH_1R_STATE_256[] = {
+	REVERSE_4(0xd7983aad, 0xcc82db47, 0x9fa856de, 0x92b52c0d),
+	REVERSE_4(0xace78057, 0xf59e125a, 0x15c7b798, 0x338d996e),
+	REVERSE_4(0xe8a07ce4, 0x5079506b, 0xae62c7d0, 0x6a770017),
+	REVERSE_4(0x7e994948, 0x79a10005, 0x07ad828d, 0x630a240c)
+};
+
+
+alignas(64) static const uint32_t AES_GEN_1R_KEY_256[] = {
+	REVERSE_4(0xb4f44917, 0xdbb5552b, 0x62716609, 0x6daca553),
+	REVERSE_4(0x0da1dc4e, 0x1725d378, 0x846a710d, 0x6d7caf07),
+	REVERSE_4(0x3e20e345, 0xf4c0794f, 0x9f947ec6, 0x3f1262f1),
+	REVERSE_4(0x49169154, 0x16314c88, 0xb1ba317c, 0x6aef8135)
+};
+
+
+alignas(16) static const uint32_t AES_HASH_1R_XKEY0_256[] = {
+	REVERSE_4(0x06890201, 0x90dc56bf, 0x8b24949f, 0xf6fa8389)
+};
+
+
+alignas(16) static const uint32_t AES_HASH_1R_XKEY1_256[] = {
+	REVERSE_4(0xed18f99b, 0xee1043c6, 0x51f4e03c, 0x61b263d1)
+};
+
+
+static inline __m256i even_lanes(const __m256i first, const __m256i second)
+{
+	return _mm256_permute2x128_si256(first, second, 0x20);
+}
+
+
+static inline __m256i odd_lanes(const __m256i first, const __m256i second)
+{
+	return _mm256_permute2x128_si256(first, second, 0x31);
+}
+
+
+void hashAndFillAes1Rx4_VAES256(void *scratchpad, size_t scratchpadSize, void *hash, void *fill_state)
+{
+	uint8_t *scratchpadPtr = static_cast<uint8_t *>(scratchpad);
+	const uint8_t *scratchpadEnd = scratchpadPtr + scratchpadSize;
+
+	const __m256i hash01 = _mm256_load_si256(reinterpret_cast<const __m256i *>(AES_HASH_1R_STATE_256));
+	const __m256i hash23 = _mm256_load_si256(reinterpret_cast<const __m256i *>(AES_HASH_1R_STATE_256 + 8));
+	__m256i hashEnc = even_lanes(hash01, hash23);
+	__m256i hashDec = odd_lanes(hash01, hash23);
+
+	const __m256i key01 = _mm256_load_si256(reinterpret_cast<const __m256i *>(AES_GEN_1R_KEY_256));
+	const __m256i key23 = _mm256_load_si256(reinterpret_cast<const __m256i *>(AES_GEN_1R_KEY_256 + 8));
+	const __m256i fillDecKey = even_lanes(key01, key23);
+	const __m256i fillEncKey = odd_lanes(key01, key23);
+
+	const __m256i fill01 = _mm256_load_si256(static_cast<const __m256i *>(fill_state));
+	const __m256i fill23 = _mm256_load_si256(static_cast<const __m256i *>(fill_state) + 1);
+	__m256i fillDec = even_lanes(fill01, fill23);
+	__m256i fillEnc = odd_lanes(fill01, fill23);
+
+	constexpr int PREFETCH_DISTANCE = XMRIG_AES_PREFETCH_DISTANCE;
+	static_assert(PREFETCH_DISTANCE > 0 && PREFETCH_DISTANCE % 64 == 0,
+		"XMRIG_AES_PREFETCH_DISTANCE must be a positive multiple of 64");
+
+	const uint8_t *prefetchPtr = scratchpadPtr + PREFETCH_DISTANCE;
+	scratchpadEnd -= PREFETCH_DISTANCE;
+
+	for (int i = 0; i < 2; ++i) {
+		while (scratchpadPtr < scratchpadEnd) {
+			const __m256i scratchpad01 = _mm256_load_si256(reinterpret_cast<const __m256i *>(scratchpadPtr));
+			const __m256i scratchpad23 = _mm256_load_si256(reinterpret_cast<const __m256i *>(scratchpadPtr + 32));
+
+			hashEnc = _mm256_aesenc_epi128(hashEnc, even_lanes(scratchpad01, scratchpad23));
+			hashDec = _mm256_aesdec_epi128(hashDec, odd_lanes(scratchpad01, scratchpad23));
+			fillDec = _mm256_aesdec_epi128(fillDec, fillDecKey);
+			fillEnc = _mm256_aesenc_epi128(fillEnc, fillEncKey);
+
+			_mm256_store_si256(
+				reinterpret_cast<__m256i *>(scratchpadPtr),
+				even_lanes(fillDec, fillEnc)
+			);
+			_mm256_store_si256(
+				reinterpret_cast<__m256i *>(scratchpadPtr + 32),
+				odd_lanes(fillDec, fillEnc)
+			);
+
+			_mm_prefetch(reinterpret_cast<const char *>(prefetchPtr), _MM_HINT_T0);
+
+			scratchpadPtr += 64;
+			prefetchPtr += 64;
+		}
+
+		prefetchPtr = static_cast<const uint8_t *>(scratchpad);
+		scratchpadEnd += PREFETCH_DISTANCE;
+	}
+
+	_mm256_store_si256(static_cast<__m256i *>(fill_state), even_lanes(fillDec, fillEnc));
+	_mm256_store_si256(static_cast<__m256i *>(fill_state) + 1, odd_lanes(fillDec, fillEnc));
+
+	const __m256i xkey0 = _mm256_broadcastsi128_si256(
+		_mm_load_si128(reinterpret_cast<const __m128i *>(AES_HASH_1R_XKEY0_256))
+	);
+	const __m256i xkey1 = _mm256_broadcastsi128_si256(
+		_mm_load_si128(reinterpret_cast<const __m128i *>(AES_HASH_1R_XKEY1_256))
+	);
+
+	hashEnc = _mm256_aesenc_epi128(hashEnc, xkey0);
+	hashDec = _mm256_aesdec_epi128(hashDec, xkey0);
+	hashEnc = _mm256_aesenc_epi128(hashEnc, xkey1);
+	hashDec = _mm256_aesdec_epi128(hashDec, xkey1);
+
+	_mm256_store_si256(static_cast<__m256i *>(hash), even_lanes(hashEnc, hashDec));
+	_mm256_store_si256(static_cast<__m256i *>(hash) + 1, odd_lanes(hashEnc, hashDec));
+
+	_mm256_zeroupper();
+}
