[Unit]
Description=Privacy-minimised Monero Fast Wallet download gateway
After=network.target

[Service]
Type=simple
User=mfw-download-gateway
Group=mfw-download-gateway
StateDirectory=mfw-download-gateway
StateDirectoryMode=0700
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /usr/local/libexec/mfw-download-gateway serve --listen 127.0.0.1 --port 8097 --database /var/lib/mfw-download-gateway/metrics.sqlite3 --manifest /var/www/mfw-downloads/releases.json --artifact-root /var/www/mfw-downloads --geoip-database /usr/share/GeoIP/GeoLite2-Country.mmdb
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/mfw-download-gateway
ReadOnlyPaths=/var/www/mfw-downloads
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
