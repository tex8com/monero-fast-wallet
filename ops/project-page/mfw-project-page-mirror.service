[Unit]
Description=Mirror the verified Monero Fast Wallet project page
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=MFW_MIRROR_ORIGIN=https://xmr.tex8.com
ExecStart=/usr/local/sbin/mfw-project-page-pull
ExecStart=/usr/local/sbin/mfw-download-mirror-pull
User=root
Group=root
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/www /run/lock
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
