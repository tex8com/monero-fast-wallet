[Unit]
Description=Monero Fast Wallet Notify Scanner
Documentation=https://github.com/tex8com/monero-fast-wallet
Wants=network-online.target
After=network-online.target cuprate.service

[Service]
Type=simple
User=server
Group=server
SupplementaryGroups=cuprate
WorkingDirectory=/srv/monero-fast-wallet/monero-fast-wallet-runtime
EnvironmentFile=/srv/monero-fast-wallet/monero-fast-wallet-runtime/notify-scanner.env
ExecStart=/srv/monero-fast-wallet/monero-fast-wallet-runtime/bin/notify-scanner
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/monero-fast-wallet/monero-fast-wallet-runtime
ReadOnlyPaths=/var/lib/cuprate/wallet-scan-cache-100k
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
