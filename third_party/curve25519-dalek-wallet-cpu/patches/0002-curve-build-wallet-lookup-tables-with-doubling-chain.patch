     /// Perform constant-time, variable-base scalar multiplication using an
     /// already computed signed radix-16 representation of the scalar.
     pub fn mul_precomputed(point: &EdwardsPoint, scalar_digits: &[i8; 64]) -> EdwardsPoint {
-        // Construct a lookup table of [P,2P,3P,4P,5P,6P,7P,8P]
-        let lookup_table = LookupTable::<CachedPoint>::from(point);
+        let lookup_table = lookup_table_by_doubling(point);
+        mul_with_lookup_table(&lookup_table, scalar_digits)
+    }
+
+    fn lookup_table_by_doubling(point: &EdwardsPoint) -> LookupTable<CachedPoint> {
+        let p1 = ExtendedPoint::from(*point);
+        let p2 = p1.double();
+        let p3 = &p1 + &CachedPoint::from(p2);
+        let p4 = p2.double();
+        let p5 = &p1 + &CachedPoint::from(p4);
+        let p6 = p3.double();
+        let p7 = &p1 + &CachedPoint::from(p6);
+        let p8 = p4.double();
+
+        LookupTable([
+            CachedPoint::from(p1),
+            CachedPoint::from(p2),
+            CachedPoint::from(p3),
+            CachedPoint::from(p4),
+            CachedPoint::from(p5),
+            CachedPoint::from(p6),
+            CachedPoint::from(p7),
+            CachedPoint::from(p8),
+        ])
+    }
+
+    fn mul_with_lookup_table(
+        lookup_table: &LookupTable<CachedPoint>,
+        scalar_digits: &[i8; 64],
+    ) -> EdwardsPoint {
