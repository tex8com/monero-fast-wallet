+/// Perform two independent constant-time variable-base scalar
+/// multiplications with a precomputed signed radix-16 scalar.
+pub fn variable_base_mul_precomputed_pair(
+    points: [&EdwardsPoint; 2],
+    scalar_digits: &[i8; 64],
+) -> [EdwardsPoint; 2] {
+    match get_selected_backend() {
+        #[cfg(curve25519_dalek_backend = "simd")]
+        BackendKind::Avx2 => [
+            vector::scalar_mul::variable_base::spec_avx2::mul_precomputed(points[0], scalar_digits),
+            vector::scalar_mul::variable_base::spec_avx2::mul_precomputed(points[1], scalar_digits),
+        ],
+        #[cfg(all(curve25519_dalek_backend = "simd", curve25519_dalek_avx512))]
+        BackendKind::Avx512 => [
+            vector::scalar_mul::variable_base::spec_avx512ifma_avx512vl::mul_precomputed(
+                points[0],
+                scalar_digits,
+            ),
+            vector::scalar_mul::variable_base::spec_avx512ifma_avx512vl::mul_precomputed(
+                points[1],
+                scalar_digits,
+            ),
+        ],
+        BackendKind::Serial => {
+            serial::scalar_mul::variable_base::mul_precomputed_pair(points, scalar_digits)
+        }
+    }
+}
