+/// A scalar prepared for repeated constant-time multiplication with distinct
+/// Edwards points.
+///
+/// This is useful for batch protocols that multiply many different points by
+/// one secret scalar. Preparing it once avoids repeating the scalar's signed
+/// radix-16 decomposition for every point. Point lookup and selection remain
+/// constant time with respect to the scalar.
+pub struct PreparedVariableBaseScalar {
+    radix_16: [i8; 64],
+}
+
+impl PreparedVariableBaseScalar {
+    /// Prepare a scalar for repeated variable-base multiplication.
+    pub fn new(scalar: &Scalar) -> Self {
+        Self {
+            radix_16: scalar.as_radix_16(),
+        }
+    }
+
+    /// Multiply `point` by this prepared scalar in constant time.
+    pub fn mul(&self, point: &EdwardsPoint) -> EdwardsPoint {
+        crate::backend::variable_base_mul_precomputed(point, &self.radix_16)
+    }
+}
+
+#[cfg(feature = "zeroize")]
+impl Drop for PreparedVariableBaseScalar {
+    fn drop(&mut self) {
+        self.radix_16.zeroize();
+    }
+}
