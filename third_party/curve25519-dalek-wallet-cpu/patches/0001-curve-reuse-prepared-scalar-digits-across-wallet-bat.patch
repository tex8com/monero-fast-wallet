+/// Perform constant-time, variable-base scalar multiplication with a
+/// precomputed signed radix-16 scalar.
+pub fn variable_base_mul_precomputed(
+    point: &EdwardsPoint,
+    scalar_digits: &[i8; 64],
+) -> EdwardsPoint {
+    match get_selected_backend() {
+        #[cfg(curve25519_dalek_backend = "simd")]
+        BackendKind::Avx2 => {
+            vector::scalar_mul::variable_base::spec_avx2::mul_precomputed(point, scalar_digits)
+        }
+        #[cfg(all(curve25519_dalek_backend = "simd", nightly))]
+        BackendKind::Avx512 => {
+            vector::scalar_mul::variable_base::spec_avx512ifma_avx512vl::mul_precomputed(
+                point,
+                scalar_digits,
+            )
+        }
+        BackendKind::Serial => {
+            serial::scalar_mul::variable_base::mul_precomputed(point, scalar_digits)
+        }
+    }
+}
