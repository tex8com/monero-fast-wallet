+
+    let hashes = tx_infos_table
+        .iter()?
+        .filter_map(|info| match info {
+            Ok((tx_hash, info)) if tx_is_visible(&info, include_sensitive_txs) => Some(Ok(tx_hash)),
+            Ok(_) => None,
