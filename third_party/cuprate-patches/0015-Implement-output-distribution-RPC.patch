+fn output_distribution_data_to_rpc(
+    data: OutputDistributionData,
+    binary: bool,
+    compress: bool,
+) -> Distribution {
+    let OutputDistributionData {
+        amount,
+        distribution,
+        start_height,
+        base,
+    } = data;
+
+    if compress {
+        Distribution::CompressedBinary(DistributionCompressedBinary {
+            start_height,
+            base,
+            distribution,
+            amount,
+        })
+    } else {
+        Distribution::Uncompressed(DistributionUncompressed {
+            start_height,
+            base,
+            distribution,
+            amount,
+            binary,
+        })
+    }
+}
