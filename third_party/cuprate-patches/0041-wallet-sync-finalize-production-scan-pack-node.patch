+fn set_grpc_tcp_congestion_control(
+    _stream: &tokio::net::TcpStream,
+    _algorithm: &str,
+) -> std::io::Result<()> {
+    Err(std::io::Error::new(
+        std::io::ErrorKind::Unsupported,
+        "per-socket TCP congestion control is only implemented for Linux",
+    ))
+}
