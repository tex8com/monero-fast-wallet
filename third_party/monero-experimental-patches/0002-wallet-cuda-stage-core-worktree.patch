+                const bool written = write_all(entry.spool_writer,
+                    payload.data(), payload.size());
+                if (!written) {
+                    release_spool_bytes(record.file_bytes);
+                    {
+                        std::lock_guard<std::mutex> lock(entry.spool_mu);
+                        entry.spool_done = true;
