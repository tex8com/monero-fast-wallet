diff --git a/src/wallet/grpc_stream/grpc_spool_queue_wait.h b/src/wallet/grpc_stream/grpc_spool_queue_wait.h
new file mode 100644
index 0000000..ddbc513
--- /dev/null
+++ b/src/wallet/grpc_stream/grpc_spool_queue_wait.h
@@ -0,0 +1,41 @@
+#pragma once
+
+#include <chrono>
+
+namespace cuprate_grpc_stream {
+
+enum class spool_write_result { stored, quota_full, unavailable };
+enum class chunk_queue_storage { memory, disk, cancelled };
+
+// A different lane can release the process-wide disk quota without freeing
+// this lane's single RAM slot. Bound that cross-lane wakeup delay without
+// adding another receiver, changing queue order, or retaining another payload.
+constexpr std::chrono::milliseconds kSpoolQuotaRetryInterval{25};
+
+// Callbacks run with the caller's queue lock held. try_spool may temporarily
+// release that lock for disk I/O; wait releases it as a condition-variable wait.
+// Only quota exhaustion is retryable. A real disk failure must keep the former
+// RAM-only fallback instead of repeatedly writing to an unhealthy filesystem.
+template <typename MemoryAvailable, typename Cancelled, typename TrySpool,
+          typename Wait>
+chunk_queue_storage await_chunk_queue_storage(
+    MemoryAvailable memory_available, Cancelled cancelled,
+    TrySpool try_spool, Wait wait)
+{
+    bool disk_unavailable = false;
+    for (;;) {
+        if (cancelled())
+            return chunk_queue_storage::cancelled;
+        if (memory_available())
+            return chunk_queue_storage::memory;
+        if (!disk_unavailable) {
+            const spool_write_result result = try_spool();
+            if (result == spool_write_result::stored)
+                return chunk_queue_storage::disk;
+            disk_unavailable = result == spool_write_result::unavailable;
+        }
+        wait(!disk_unavailable);
+    }
+}
+
+} // namespace cuprate_grpc_stream
diff --git a/src/wallet/grpc_stream/test_spool_queue_wait.cpp b/src/wallet/grpc_stream/test_spool_queue_wait.cpp
new file mode 100644
index 0000000..ccca132
--- /dev/null
+++ b/src/wallet/grpc_stream/test_spool_queue_wait.cpp
@@ -0,0 +1,157 @@
+#include "grpc_spool_queue_wait.h"
+
+#include <atomic>
+#include <condition_variable>
+#include <future>
+#include <iostream>
+#include <mutex>
+#include <stdexcept>
+#include <thread>
+
+using namespace cuprate_grpc_stream;
+
+namespace {
+void require(bool value, const char* message)
+{
+    if (!value)
+        throw std::runtime_error(message);
+}
+
+void ready_memory_does_not_write_disk()
+{
+    unsigned writes = 0;
+    const auto result = await_chunk_queue_storage(
+        [] { return true; }, [] { return false; },
+        [&] { ++writes; return spool_write_result::stored; },
+        [](bool) { throw std::runtime_error("unexpected wait"); });
+    require(result == chunk_queue_storage::memory && writes == 0,
+        "available RAM must not spill another chunk");
+}
+
+void available_disk_does_not_need_ram()
+{
+    const auto result = await_chunk_queue_storage(
+        [] { return false; }, [] { return false; },
+        [] { return spool_write_result::stored; },
+        [](bool) { throw std::runtime_error("unexpected wait"); });
+    require(result == chunk_queue_storage::disk,
+        "available disk must accept a chunk with full RAM");
+}
+
+void another_lane_releases_quota_without_ram_drain()
+{
+    std::mutex queue_mutex;
+    std::condition_variable queue_cv;
+    bool memory_available = false;
+    bool cancelled = false;
+    std::atomic<bool> disk_quota_available{false};
+    std::atomic<unsigned> attempts{0};
+    std::promise<void> first_attempt;
+    auto first = first_attempt.get_future();
+    std::promise<chunk_queue_storage> completed;
+    auto result = completed.get_future();
+    std::thread receiver([&] {
+        std::unique_lock<std::mutex> lock(queue_mutex);
+        const auto can_wake = [&] { return memory_available || cancelled; };
+        completed.set_value(await_chunk_queue_storage(
+            [&] { return memory_available; }, [&] { return cancelled; },
+            [&] {
+                const bool quota_available = disk_quota_available.load();
+                if (attempts.fetch_add(1) == 0)
+                    first_attempt.set_value();
+                return quota_available
+                    ? spool_write_result::stored : spool_write_result::quota_full;
+            },
+            [&](bool retry_quota) {
+                if (retry_quota)
+                    queue_cv.wait_for(lock, kSpoolQuotaRetryInterval, can_wake);
+                else
+                    queue_cv.wait(lock, can_wake);
+            }));
+    });
+
+    const bool attempted = first.wait_for(std::chrono::seconds(2))
+        == std::future_status::ready;
+    // Simulate another lane popping one of its disk chunks. This neither
+    // consumes our RAM chunk behind the disk backlog nor notifies our queue.
+    disk_quota_available.store(true);
+    const bool resumed = result.wait_for(std::chrono::seconds(2))
+        == std::future_status::ready;
+    if (!resumed) {
+        std::lock_guard<std::mutex> lock(queue_mutex);
+        cancelled = true;
+    }
+    queue_cv.notify_all();
+    receiver.join();
+    require(attempted && resumed, "disk quota release did not resume receiver");
+    require(result.get() == chunk_queue_storage::disk && !memory_available
+        && attempts.load() >= 2,
+        "quota must be retried without draining the occupied RAM slot");
+}
+
+void disk_failure_does_not_retry_io()
+{
+    bool memory_available = false;
+    unsigned attempts = 0;
+    unsigned waits = 0;
+    const auto result = await_chunk_queue_storage(
+        [&] { return memory_available; }, [] { return false; },
+        [&] { ++attempts; return spool_write_result::unavailable; },
+        [&](bool retry_quota) {
+            require(!retry_quota, "real disk failure must use RAM-only wait");
+            ++waits;
+            memory_available = true;
+        });
+    require(result == chunk_queue_storage::memory && attempts == 1 && waits == 1,
+        "disk failures must not become repeated I/O attempts");
+}
+
+void cancellation_stops_quota_retries()
+{
+    bool cancelled = false;
+    unsigned attempts = 0;
+    unsigned waits = 0;
+    const auto result = await_chunk_queue_storage(
+        [] { return false; }, [&] { return cancelled; },
+        [&] { ++attempts; return spool_write_result::quota_full; },
+        [&](bool retry_quota) {
+            require(retry_quota, "full quota must use bounded wait");
+            ++waits;
+            cancelled = true;
+        });
+    require(result == chunk_queue_storage::cancelled && attempts == 1 && waits == 1,
+        "cancelled receivers must not retry or enqueue a chunk");
+}
+
+void free_ram_wins_after_quota_wait()
+{
+    bool memory_available = false;
+    unsigned attempts = 0;
+    const auto result = await_chunk_queue_storage(
+        [&] { return memory_available; }, [] { return false; },
+        [&] { ++attempts; return spool_write_result::quota_full; },
+        [&](bool retry_quota) {
+            require(retry_quota, "full quota must be retryable");
+            memory_available = true;
+        });
+    require(result == chunk_queue_storage::memory && attempts == 1,
+        "a newly available RAM slot must avoid an unnecessary spool write");
+}
+} // namespace
+
+int main()
+{
+    try {
+        ready_memory_does_not_write_disk();
+        available_disk_does_not_need_ram();
+        another_lane_releases_quota_without_ram_drain();
+        disk_failure_does_not_retry_io();
+        cancellation_stops_quota_retries();
+        free_ram_wins_after_quota_wait();
+        std::cout << "6 spool queue wait regression groups passed\n";
+        return 0;
+    } catch (const std::exception& error) {
+        std::cerr << error.what() << '\n';
+        return 1;
+    }
+}
