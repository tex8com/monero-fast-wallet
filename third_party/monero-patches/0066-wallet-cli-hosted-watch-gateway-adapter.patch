+  persisted_hosted_watch new_pending_hosted_watch(const persisted_fast_wallet& metadata,
+                                                  const persisted_paired_worker& paired,
+                                                  const std::uint32_t stage)
+  {
+    persisted_hosted_watch state{};
+    std::memcpy(state.magic, hosted_watch_magic, sizeof(state.magic));
+    state.disk_version = hosted_watch_disk_version;
+    state.network = metadata.network;
+    state.enrollment_stage = stage;
+    state.generation = 1;
+    state.created_at = unix_seconds();
+    state.updated_at = state.created_at;
+    state.assignment_epoch = 1;
+    std::array<unsigned char, 16> installation_suffix{};
+    crypto::rand(installation_suffix.size(), installation_suffix.data());
+    const std::string id = std::string("mwp_desktop_") +
+      hex_encode(installation_suffix.data(), installation_suffix.size());
+    std::copy(id.begin(), id.end(), state.installation_id.begin());
+    crypto::rand(state.installation_auth.size(), state.installation_auth.data());
+    crypto::rand(state.assignment_handle.size(), state.assignment_handle.data());
+    state.worker_root_id = paired.worker_root_id;
+    std::fill(installation_suffix.begin(), installation_suffix.end(), 0);
+    return state;
+  }
