+  std::string relay_origin_from_descriptor(const std::vector<unsigned char>& descriptor,
+                                           const Monero::NetworkType network, const std::uint64_t now)
+  {
+    std::array<unsigned char, 256> origin{};
+    std::size_t length = origin.size();
+    if (tex8_fast_wallet_protocol_descriptor_relay_origin_v1(descriptor.data(), descriptor.size(),
+        static_cast<std::uint8_t>(network), now, origin.data(), &length) != TEX8_FAST_WALLET_PROTOCOL_OK ||
+        length == 0 || length > origin.size())
+      throw std::runtime_error("Worker descriptor does not contain a valid Relay origin");
+    return require_https_origin(std::string(reinterpret_cast<const char*>(origin.data()), length), "Worker Relay origin");
+  }
+
+  void submit_watch_to_relay(const persisted_hosted_watch& state, const std::string& relay_origin)
+  {
+    const std::string body = "{\"envelope\":\"" + hex_encode(state.envelope.data(), state.envelope.size()) + "\"}";
+    // The Worker Relay is independently pinned by its signed descriptor. It
+    // must receive only the encrypted watch, never the Gateway installation
+    // capability or any other management credential.
+    const http_response response = https_request(relay_origin, "POST", "/v1/envelopes", body, nullptr);
+    const std::size_t key = response.body.find("\"messageId\"");
+    if ((response.status != 200 && response.status != 201) || key == std::string::npos)
+      throw std::runtime_error("Fast Wallet Worker Relay rejected the encrypted watch");
+    const std::size_t first_quote = response.body.find('"', response.body.find(':', key));
+    const std::size_t second_quote = first_quote == std::string::npos ? std::string::npos : response.body.find('"', first_quote + 1);
+    if (second_quote == std::string::npos || second_quote - first_quote - 1 != 64 ||
+        !std::all_of(response.body.begin() + first_quote + 1, response.body.begin() + second_quote, is_lowercase_hex))
+      throw std::runtime_error("Fast Wallet Worker Relay returned an invalid acknowledgement");
+  }
+
+  std::array<unsigned char, 32> descriptor_hash(const std::vector<unsigned char>& descriptor)
+  {
+    if (descriptor.empty()) throw std::runtime_error("Worker descriptor is invalid");
+    const crypto::hash hash = crypto::cn_fast_hash(descriptor.data(), descriptor.size());
+    std::array<unsigned char, 32> output{};
+    std::memcpy(output.data(), hash.data, output.size());
+    return output;
+  }
