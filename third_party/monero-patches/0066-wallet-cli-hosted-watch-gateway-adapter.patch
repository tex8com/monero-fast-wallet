+  bool bytes_are_zero(const unsigned char* bytes, const std::size_t length)
+  {
+    return std::all_of(bytes, bytes + length, [](const unsigned char value) { return value == 0; });
+  }
+
+  bool is_lowercase_hex(const char value)
+  {
+    return (value >= '0' && value <= '9') || (value >= 'a' && value <= 'f');
+  }
+
+  bool valid_installation_id(const std::array<char, 45>& value)
+  {
+    static constexpr char prefix[] = "mwp_desktop_";
+    constexpr std::size_t prefix_length = sizeof(prefix) - 1;
+    if (std::memcmp(value.data(), prefix, prefix_length) != 0 || value.back() != '\0') return false;
+    return std::all_of(value.begin() + prefix_length, value.end() - 1, is_lowercase_hex);
+  }
+
+  bool valid_hosting_stage(const std::uint32_t stage)
+  {
+    return stage == MFW_FAST_WALLET_HOSTING_STAGE_NONE ||
+      stage == MFW_FAST_WALLET_HOSTING_STAGE_PENDING_LOCAL ||
+      stage == MFW_FAST_WALLET_HOSTING_STAGE_INSTALLATION_REGISTERED ||
+      stage == MFW_FAST_WALLET_HOSTING_STAGE_ASSIGNMENT_ACCEPTED ||
+      stage == MFW_FAST_WALLET_HOSTING_STAGE_DELIVERY_ENABLED ||
+      stage == MFW_FAST_WALLET_HOSTING_STAGE_WATCH_SEALED ||
+      stage == MFW_FAST_WALLET_HOSTING_STAGE_RELAY_ACCEPTED ||
+      stage == MFW_FAST_WALLET_HOSTING_STAGE_ACTIVE ||
+      stage == MFW_FAST_WALLET_HOSTING_STAGE_REVOCATION_REMOTE_DELETED;
+  }
+
+  void validate_hosted_watch(const persisted_hosted_watch& state)
+  {
+    if (std::memcmp(state.magic, hosted_watch_magic, sizeof(hosted_watch_magic)) != 0 ||
+        state.disk_version != hosted_watch_disk_version || state.reserved != 0 ||
+        state.generation == 0 || state.created_at == 0 || state.updated_at < state.created_at ||
+        state.network > static_cast<std::uint32_t>(Monero::STAGENET) ||
+        !valid_hosting_stage(state.enrollment_stage))
+      throw std::runtime_error("Fast Wallet hosted-watch state is corrupt or unsupported");
+
+    if (state.enrollment_stage == MFW_FAST_WALLET_HOSTING_STAGE_NONE) return;
+    if (!valid_installation_id(state.installation_id) || state.assignment_epoch == 0 ||
+        bytes_are_zero(state.installation_auth.data(), state.installation_auth.size()) ||
+        bytes_are_zero(state.assignment_handle.data(), state.assignment_handle.size()) ||
+        bytes_are_zero(state.worker_root_id.data(), state.worker_root_id.size()))
+      throw std::runtime_error("Fast Wallet hosted-watch state is invalid");
+    if (state.enrollment_stage >= MFW_FAST_WALLET_HOSTING_STAGE_ASSIGNMENT_ACCEPTED &&
+        (state.assignment_expires_at == 0 ||
+         bytes_are_zero(state.descriptor_hash.data(), state.descriptor_hash.size())))
+      throw std::runtime_error("Fast Wallet hosted-watch assignment expiry is invalid");
+    if ((state.enrollment_stage == MFW_FAST_WALLET_HOSTING_STAGE_WATCH_SEALED ||
+         state.enrollment_stage == MFW_FAST_WALLET_HOSTING_STAGE_RELAY_ACCEPTED) &&
+        bytes_are_zero(state.envelope.data(), state.envelope.size()))
+      throw std::runtime_error("Fast Wallet hosted-watch envelope is missing");
+  }
+
+  persisted_hosted_watch read_hosted_watch(const options& input)
+  {
+    const auto path = hosted_watch_path(input);
+    require_private_regular_file(path, "Fast Wallet hosted-watch state");
+    if (boost::filesystem::file_size(path) != sizeof(persisted_hosted_watch))
+      throw std::runtime_error("Fast Wallet hosted-watch state has an invalid size");
+    std::ifstream stream(path.string(), std::ios::binary);
+    persisted_hosted_watch state{};
+    stream.read(reinterpret_cast<char*>(&state), sizeof(state));
+    if (!stream || stream.peek() != std::ifstream::traits_type::eof())
+      throw std::runtime_error("Fast Wallet hosted-watch state could not be read");
+    validate_hosted_watch(state);
+    return state;
+  }
+
+  void wipe_hosted_watch(persisted_hosted_watch& state);
+
+  bool has_hosted_watch(const options& input)
+  {
+    const auto path = hosted_watch_path(input);
+    if (!boost::filesystem::exists(path) || boost::filesystem::is_symlink(path)) return false;
+    persisted_hosted_watch state = read_hosted_watch(input);
+    wipe_hosted_watch(state);
+    return true;
+  }
+
+  void write_hosted_watch(const options& input, persisted_hosted_watch state)
+  {
+    validate_hosted_watch(state);
+    const auto path = hosted_watch_path(input);
+    const auto parent = path.parent_path().empty() ? boost::filesystem::current_path() : path.parent_path();
+    const auto temporary = boost::filesystem::path(path.string() + ".tmp");
+    if (boost::filesystem::is_symlink(parent) || boost::filesystem::is_symlink(path))
+      throw std::runtime_error("Fast Wallet hosted-watch state path is unsafe");
+    if (boost::filesystem::exists(temporary)) boost::filesystem::remove(temporary);
+    ++state.generation;
+    state.updated_at = unix_seconds();
+    {
+      std::ofstream output(temporary.string(), std::ios::binary | std::ios::trunc);
+      output.write(reinterpret_cast<const char*>(&state), sizeof(state));
+      output.flush();
+      if (!output) throw std::runtime_error("Fast Wallet hosted-watch state could not be written");
+    }
+#ifndef _WIN32
+    ::chmod(temporary.string().c_str(), S_IRUSR | S_IWUSR);
+#endif
+    sync_path(temporary);
+#ifdef _WIN32
+    if (!MoveFileExW(temporary.wstring().c_str(), path.wstring().c_str(),
+                     MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH))
+      throw std::runtime_error("Fast Wallet hosted-watch state could not be committed");
+#else
+    if (::rename(temporary.string().c_str(), path.string().c_str()) != 0)
+      throw std::runtime_error("Fast Wallet hosted-watch state could not be committed");
+    sync_path(parent);
+#endif
+    persisted_hosted_watch verified = read_hosted_watch(input);
+    if (verified.generation != state.generation || verified.enrollment_stage != state.enrollment_stage)
+      throw std::runtime_error("Fast Wallet hosted-watch state commit could not be verified");
+    std::fill(verified.installation_auth.begin(), verified.installation_auth.end(), 0);
+    std::fill(verified.assignment_handle.begin(), verified.assignment_handle.end(), 0);
+    std::fill(verified.envelope.begin(), verified.envelope.end(), 0);
+  }
+
+  void wipe_hosted_watch(persisted_hosted_watch& state)
+  {
+    volatile unsigned char* bytes = reinterpret_cast<volatile unsigned char*>(&state);
+    for (std::size_t index = 0; index < sizeof(state); ++index) bytes[index] = 0;
+  }
