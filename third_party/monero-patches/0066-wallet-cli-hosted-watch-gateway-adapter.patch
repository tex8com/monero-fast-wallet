+  bool json_accepted(const std::string& body)
+  {
+    const std::size_t key = body.find("\"accepted\"");
+    if (key == std::string::npos) return false;
+    std::size_t cursor = key + 10;
+    while (cursor < body.size() && (body[cursor] == ' ' || body[cursor] == '\t' ||
+                                   body[cursor] == '\r' || body[cursor] == '\n')) ++cursor;
+    if (cursor == body.size() || body[cursor++] != ':') return false;
+    while (cursor < body.size() && (body[cursor] == ' ' || body[cursor] == '\t' ||
+                                   body[cursor] == '\r' || body[cursor] == '\n')) ++cursor;
+    return body.compare(cursor, 4, "true") == 0 &&
+      (cursor + 4 == body.size() || !std::isalnum(static_cast<unsigned char>(body[cursor + 4])));
+  }
+
+  std::uint64_t json_unsigned(const std::string& body, const char* name)
+  {
+    const std::string key = std::string("\"") + name + "\"";
+    const std::size_t found = body.find(key);
+    if (found == std::string::npos) throw std::runtime_error("Fast Wallet Gateway response was invalid");
+    std::size_t cursor = found + key.size();
+    while (cursor < body.size() && std::isspace(static_cast<unsigned char>(body[cursor]))) ++cursor;
+    if (cursor == body.size() || body[cursor++] != ':') throw std::runtime_error("Fast Wallet Gateway response was invalid");
+    while (cursor < body.size() && std::isspace(static_cast<unsigned char>(body[cursor]))) ++cursor;
+    const std::size_t first_digit = cursor;
+    while (cursor < body.size() && body[cursor] >= '0' && body[cursor] <= '9') ++cursor;
+    std::uint64_t value = 0;
+    if (cursor == first_digit || !parse_unsigned(body.substr(first_digit, cursor - first_digit), value))
+      throw std::runtime_error("Fast Wallet Gateway response was invalid");
+    return value;
+  }
