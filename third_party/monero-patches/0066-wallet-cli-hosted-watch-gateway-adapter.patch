+  std::uint64_t sponsor_gateway_assignment(const options& input, const persisted_hosted_watch& state,
+                                           const std::vector<unsigned char>& descriptor,
+                                           const std::uint64_t requested_expiry, const std::uint64_t now)
+  {
+    const std::string body = "{\"workerDescriptor\":\"" + hex_encode(descriptor.data(), descriptor.size()) +
+      "\",\"assignmentHandle\":\"" + hex_encode(state.assignment_handle.data(), state.assignment_handle.size()) +
