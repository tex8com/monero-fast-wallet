+  std::string require_https_origin(const std::string& value, const char* description)
+  {
+    std::string origin = value;
+    while (!origin.empty() && origin.back() == '/') origin.pop_back();
+    if (origin.size() <= 8 || origin.size() > 256 || origin.compare(0, 8, "https://") != 0 ||
+        origin.find_first_of(" \t\r\n?#@") != std::string::npos ||
+        origin.find('/', 8) != std::string::npos)
+      throw std::runtime_error(std::string(description) + " must be a bare HTTPS origin");
+    return origin;
+  }
+
+  struct http_response
+  {
+    long status = 0;
+    std::string body;
+  };
+
+  std::size_t bounded_curl_write(char* data, const std::size_t size,
+                                 const std::size_t count, void* context)
+  {
+    if (count != 0 && size > maximum_gateway_response_bytes / count) return 0;
+    const std::size_t length = size * count;
+    http_response* response = static_cast<http_response*>(context);
+    if (length > maximum_gateway_response_bytes - response->body.size()) return 0;
+    response->body.append(data, length);
+    return length;
+  }
+
+  void require_curl_runtime()
+  {
+    static std::once_flag initialized;
+    static CURLcode result = CURLE_FAILED_INIT;
+    std::call_once(initialized, [] { result = curl_global_init(CURL_GLOBAL_DEFAULT); });
+    if (result != CURLE_OK) throw std::runtime_error("Fast Wallet HTTPS client is unavailable");
+  }
+
+  http_response https_request(const std::string& origin, const char* method,
+                              const char* path, const std::string& body,
+                              const persisted_hosted_watch* state)
+  {
+    require_curl_runtime();
+    const std::string safe_origin = require_https_origin(origin, "--gateway-origin");
+    if (path == nullptr || path[0] != '/')
+      throw std::runtime_error("Fast Wallet HTTPS request path is invalid");
+    CURL* client = curl_easy_init();
+    if (client == nullptr) throw std::runtime_error("Fast Wallet HTTPS client is unavailable");
+    http_response response;
+    struct curl_slist* headers = nullptr;
+    headers = curl_slist_append(headers, "accept: application/json");
+    headers = curl_slist_append(headers, "content-type: application/json");
+    if (state != nullptr)
+    {
+      const std::string installation_id(state->installation_id.data());
+      const std::string auth = hex_encode(state->installation_auth.data(), state->installation_auth.size());
+      const std::string id_header = "x-fast-wallet-installation-id: " + installation_id;
+      const std::string auth_header = "x-fast-wallet-installation-auth: " + auth;
+      headers = curl_slist_append(headers, id_header.c_str());
+      headers = curl_slist_append(headers, auth_header.c_str());
+    }
+    const std::string url = safe_origin + path;
+    const bool setup_failed =
+      curl_easy_setopt(client, CURLOPT_URL, url.c_str()) ||
+      curl_easy_setopt(client, CURLOPT_HTTPHEADER, headers) ||
+      curl_easy_setopt(client, CURLOPT_CUSTOMREQUEST, method) ||
+      curl_easy_setopt(client, CURLOPT_NOSIGNAL, 1L) ||
+      curl_easy_setopt(client, CURLOPT_CONNECTTIMEOUT, 5L) ||
+      curl_easy_setopt(client, CURLOPT_TIMEOUT, 12L) ||
+      curl_easy_setopt(client, CURLOPT_FOLLOWLOCATION, 0L) ||
+      curl_easy_setopt(client, CURLOPT_PROTOCOLS, CURLPROTO_HTTPS) ||
+      curl_easy_setopt(client, CURLOPT_SSL_VERIFYPEER, 1L) ||
+      curl_easy_setopt(client, CURLOPT_SSL_VERIFYHOST, 2L) ||
+      curl_easy_setopt(client, CURLOPT_WRITEFUNCTION, bounded_curl_write) ||
+      curl_easy_setopt(client, CURLOPT_WRITEDATA, &response) ||
+      curl_easy_setopt(client, CURLOPT_POSTFIELDS, body.empty() ? nullptr : body.data()) ||
+      curl_easy_setopt(client, CURLOPT_POSTFIELDSIZE, static_cast<long>(body.size()));
+    if (setup_failed)
+    {
+      curl_slist_free_all(headers);
+      curl_easy_cleanup(client);
+      throw std::runtime_error("Fast Wallet HTTPS request could not be configured");
+    }
+    const CURLcode result = curl_easy_perform(client);
+    if (result == CURLE_OK) curl_easy_getinfo(client, CURLINFO_RESPONSE_CODE, &response.status);
+    curl_slist_free_all(headers);
+    curl_easy_cleanup(client);
+    if (result != CURLE_OK || response.body.size() > maximum_gateway_response_bytes)
+      throw std::runtime_error("Fast Wallet Gateway or Relay request failed");
+    return response;
+  }
