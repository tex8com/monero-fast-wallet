diff --git a/src/wallet/api/wallet.cpp b/src/wallet/api/wallet.cpp
index abc60b7..9032899 100644
--- a/src/wallet/api/wallet.cpp
+++ b/src/wallet/api/wallet.cpp
@@ -1137,6 +1137,15 @@ bool WalletImpl::prepareHardwareWalletScanFromViewOnly(
             setStatusError(tr("Ledger could not enter device-token derivation mode"));
             return false;
         }
+        // The encrypted companion is the one canonical scanner. Atomically
+        // adopt its exact cursor and full public wallet cache, while the Core
+        // method re-derives and compares every Key Image on this Ledger before
+        // accepting any copied spent state. This replaces the old second
+        // historical signing-wallet scan without weakening device or output
+        // ownership checks.
+        m_wallet->adopt_view_only_scan_state(*view_only->m_wallet);
+        m_history->refresh();
+        m_synchronized = view_only->m_synchronized.load();
         return true;
     } catch (const std::exception &e) {
         setStatusError(e.what());
diff --git a/src/wallet/api/wallet2_api.h b/src/wallet/api/wallet2_api.h
index 9c7d91d..b7594a2 100644
--- a/src/wallet/api/wallet2_api.h
+++ b/src/wallet/api/wallet2_api.h
@@ -559,8 +559,10 @@ struct Wallet
     virtual bool prepareHardwareWalletScan() = 0;
     /*!
      * \brief prepareHardwareWalletScanFromViewOnly - primes a Ledger scanner
-     * from an already-approved, encrypted local view-only wallet. The private
-     * view key never leaves the native Wallet implementation.
+     * and atomically adopts the already-approved encrypted companion's exact
+     * scan state. The private view key never leaves the native Wallet
+     * implementation; every copied owned output is rebound to the connected
+     * Ledger and its Key Image must match before spent state is accepted.
      */
     virtual bool prepareHardwareWalletScanFromViewOnly(
         const Wallet &viewOnlyWallet) = 0;
