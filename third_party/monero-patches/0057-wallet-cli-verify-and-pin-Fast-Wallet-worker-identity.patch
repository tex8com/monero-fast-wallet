+  void validate_paired_worker(const persisted_paired_worker& state)
+  {
+    const bool all_zero = std::all_of(state.worker_root_id.begin(), state.worker_root_id.end(),
+      [](const unsigned char value) { return value == 0; });
+    if (std::memcmp(state.magic, paired_worker_magic, sizeof(paired_worker_magic)) != 0 ||
+        state.disk_version != paired_worker_disk_version || state.reserved != 0 ||
+        state.generation == 0 || state.paired_at == 0 || state.updated_at < state.paired_at ||
+        state.network > static_cast<std::uint32_t>(Monero::STAGENET) || all_zero)
+      throw std::runtime_error("Fast Wallet Worker pairing metadata is corrupt or unsupported");
+  }
+
+  persisted_paired_worker read_paired_worker(const options& input)
+  {
+    const auto path = paired_worker_path(input);
+    require_private_regular_file(path, "Fast Wallet Worker pairing metadata");
+    std::ifstream stream(path.string(), std::ios::binary);
+    persisted_paired_worker state{};
+    stream.read(reinterpret_cast<char*>(&state), sizeof(state));
+    if (!stream || stream.peek() != std::ifstream::traits_type::eof())
+      throw std::runtime_error("Fast Wallet Worker pairing metadata has an invalid size");
+    validate_paired_worker(state);
+    return state;
+  }
+
+  bool has_paired_worker(const options& input)
+  {
+    const auto path = paired_worker_path(input);
+    if (!boost::filesystem::exists(path) || boost::filesystem::is_symlink(path)) return false;
+    static_cast<void>(read_paired_worker(input));
+    return true;
+  }
+
+  void write_paired_worker(const options& input, persisted_paired_worker state)
+  {
+    validate_paired_worker(state);
+    const auto path = paired_worker_path(input);
+    const auto parent = path.parent_path().empty() ? boost::filesystem::current_path() : path.parent_path();
+    const auto temporary = boost::filesystem::path(path.string() + ".tmp");
+    if (boost::filesystem::is_symlink(parent) || boost::filesystem::is_symlink(path))
+      throw std::runtime_error("Fast Wallet Worker pairing metadata path is unsafe");
+    if (boost::filesystem::exists(temporary)) boost::filesystem::remove(temporary);
+    ++state.generation;
+    // `--now` makes signed-descriptor verification reproducible. A durable
+    // record must never regress its logical timestamp merely because a public
+    // test descriptor is verified against a future fixture time.
+    state.updated_at = std::max(state.updated_at, unix_seconds());
+    {
+      std::ofstream output(temporary.string(), std::ios::binary | std::ios::trunc);
+      output.write(reinterpret_cast<const char*>(&state), sizeof(state));
+      output.flush();
+      if (!output) throw std::runtime_error("Fast Wallet Worker pairing metadata could not be written");
+    }
+#ifndef _WIN32
+    ::chmod(temporary.string().c_str(), S_IRUSR | S_IWUSR);
+#endif
+    sync_path(temporary);
+#ifdef _WIN32
+    if (!MoveFileExW(temporary.wstring().c_str(), path.wstring().c_str(),
+                     MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH))
+      throw std::runtime_error("Fast Wallet Worker pairing metadata could not be committed");
+#else
+    if (::rename(temporary.string().c_str(), path.string().c_str()) != 0)
+      throw std::runtime_error("Fast Wallet Worker pairing metadata could not be committed");
+    sync_path(parent);
+#endif
+    const persisted_paired_worker verified = read_paired_worker(input);
+    if (verified.generation != state.generation || verified.worker_root_id != state.worker_root_id)
+      throw std::runtime_error("Fast Wallet Worker pairing metadata commit could not be verified");
+  }
+
+  std::string hex_encode(const unsigned char* bytes, const std::size_t length)
+  {
+    static constexpr char alphabet[] = "0123456789abcdef";
+    std::string output(length * 2, '0');
+    for (std::size_t index = 0; index < length; ++index)
+    {
+      output[index * 2] = alphabet[bytes[index] >> 4];
+      output[index * 2 + 1] = alphabet[bytes[index] & 0x0f];
+    }
+    return output;
+  }
