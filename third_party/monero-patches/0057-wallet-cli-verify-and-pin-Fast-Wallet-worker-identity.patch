+
+  void print_worker_status(const options& input)
+  {
+    if (!has_paired_worker(input))
+    {
+      if (input.json)
+        std::cout << "{\"schema_version\":1,\"worker_paired\":false,\"worker_enrolled\":false}\n";
+      else
+        std::cout << "Fast Wallet Worker: not paired; no watch is enrolled.\n";
+      return;
+    }
+    const persisted_paired_worker worker = read_paired_worker(input);
+    const std::string root_id = hex_encode(worker.worker_root_id.data(), worker.worker_root_id.size());
+    if (input.json)
+      std::cout << "{\"schema_version\":1,\"worker_paired\":true,\"worker_enrolled\":false,\"network\":\""
+                << network_name(static_cast<Monero::NetworkType>(worker.network))
+                << "\",\"worker_root_id\":\"" << root_id << "\"}\n";
+    else
+      std::cout << "Fast Wallet Worker: paired; no watch enrolled; signed Worker root: "
+                << root_id << ".\n";
+  }
+
+  void pair_worker(const options& input)
+  {
+    const persisted_fast_wallet wallet = read_metadata(input);
+    const Monero::NetworkType wallet_network = static_cast<Monero::NetworkType>(wallet.network);
+    if (input.network_explicit && input.network != wallet_network)
+      throw std::runtime_error("--network does not match the Fast Wallet network");
+    static_cast<void>(plan(MFW_FAST_WALLET_OPERATION_PAIR_WORKER, &wallet));
+    const std::vector<unsigned char> descriptor = read_public_bounded_file(
+      input.descriptor_file, "Worker descriptor file", 4096);
+    const std::uint64_t now = input.now == 0 ? unix_seconds() : input.now;
+    persisted_paired_worker paired{};
+    std::memcpy(paired.magic, paired_worker_magic, sizeof(paired_worker_magic));
+    paired.disk_version = paired_worker_disk_version;
+    paired.network = wallet.network;
+    paired.generation = 1;
+    paired.paired_at = now;
+    paired.updated_at = now;
+    const std::int32_t result = tex8_fast_wallet_protocol_descriptor_worker_root_id_v1(
+      descriptor.data(), descriptor.size(), static_cast<std::uint8_t>(wallet.network), now,
+      paired.worker_root_id.data(), paired.worker_root_id.size());
+    if (result != TEX8_FAST_WALLET_PROTOCOL_OK)
+      throw std::runtime_error("Worker descriptor is invalid, expired, non-canonical, or for another network");
+    write_paired_worker(input, paired);
+    print_worker_status(input);
+  }
 }
 
