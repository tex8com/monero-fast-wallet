@@ -0,0 +1,125 @@
+// Copyright (c) 2026, The Monero Project
+// All rights reserved.
+// SPDX-License-Identifier: BSD-3-Clause
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <unordered_map>
+#include <unordered_set>
+
+namespace tools { namespace confirmed_spent_state {
+
+inline bool valid_height(std::uint64_t height, std::uint64_t chain_size)
+{
+  return height > 0 && height < chain_size;
+}
+
+// A pool observation is weaker than a locally confirmed spend. Keep the
+// confirmation height so detach_blockchain can undo it at the correct fork.
+inline std::uint64_t spend_height(bool already_spent, std::uint64_t previous,
+    std::uint64_t requested)
+{
+  return already_spent && previous > 0 && requested == 0 ? previous : requested;
+}
+
+inline bool may_clear_pending_spend(std::uint64_t spent_height)
+{
+  return spent_height == 0;
+}
+
+template<class TransactionId, class Payments>
+std::unordered_set<TransactionId> payment_ids(const Payments &payments,
+    std::uint64_t chain_size)
+{
+  std::unordered_set<TransactionId> result;
+  result.reserve(payments.size());
+  for (const auto &payment : payments)
+    if (valid_height(payment.second.m_block_height, chain_size))
+      result.insert(payment.second.m_tx_hash);
+  return result;
+}
+
+template<class TransactionId, class Confirmed>
+bool outgoing_is_confirmed(const TransactionId &id, const Confirmed &confirmed,
+    std::uint64_t chain_size)
+{
+  const auto outgoing = confirmed.find(id);
+  return outgoing != confirmed.end() && valid_height(outgoing->second.m_block_height, chain_size);
+}
+
+template<class TransactionId, class Confirmed, class PaymentIds>
+bool is_confirmed(const TransactionId &id, const Confirmed &confirmed,
+    const PaymentIds &payments, std::uint64_t chain_size)
+{
+  return outgoing_is_confirmed(id, confirmed, chain_size) || payments.count(id) != 0;
+}
+
+template<class PendingPayments, class Confirmed, class PaymentIds>
+std::size_t erase_confirmed_pending_payments(PendingPayments &pending,
+    const Confirmed &confirmed, const PaymentIds &payments, std::uint64_t chain_size)
+{
+  std::size_t removed = 0;
+  for (auto entry = pending.begin(); entry != pending.end(); )
+  {
+    if (is_confirmed(entry->second.m_pd.m_tx_hash, confirmed, payments, chain_size))
+    {
+      entry = pending.erase(entry);
+      ++removed;
+    }
+    else
+      ++entry;
+  }
+  return removed;
+}
+
+struct repair_result
+{
+  std::size_t outputs = 0;
+  std::size_t redundant_pending = 0;
+};
+
+// Repair only facts already established by locally confirmed transactions.
+// Never guess ownership, query a daemon, or derive a balance from history sums.
+// Reorg handling removes detached confirmed records before future processing.
+template<class Transfers, class KeyImages, class Confirmed, class Pending, class SetSpent>
+repair_result repair(Transfers &transfers, const KeyImages &key_images,
+    const Confirmed &confirmed, Pending &pending, std::uint64_t chain_size,
+    SetSpent set_spent)
+{
+  repair_result result;
+  std::unordered_map<std::size_t, std::uint64_t> confirmed_heights;
+  for (const auto &transaction : confirmed)
+  {
+    const auto height = transaction.second.m_block_height;
+    if (!valid_height(height, chain_size))
+      continue;
+    for (const auto &ring : transaction.second.m_rings)
+    {
+      const auto known = key_images.find(ring.first);
+      if (known == key_images.end() || known->second >= transfers.size())
+        continue;
+      const auto &transfer = transfers[known->second];
+      if (!transfer.m_key_image_known || transfer.m_key_image_partial ||
+          transfer.m_key_image != ring.first || transfer.m_block_height >= height)
+        continue;
+      const auto inserted = confirmed_heights.emplace(known->second, height);
+      if (!inserted.second && height < inserted.first->second)
+        inserted.first->second = height;
+    }
+    result.redundant_pending += pending.erase(transaction.first);
+  }
+  for (const auto &entry : confirmed_heights)
+  {
+    const auto &transfer = transfers[entry.first];
+    if (!transfer.m_spent || transfer.m_spent_height != entry.second)
+    {
+      set_spent(entry.first, entry.second);
+      ++result.outputs;
+    }
+  }
+  return result;
+}
+
+}} // namespace tools::confirmed_spent_state
