+//----------------------------------------------------------------------------------------------------
+void wallet2::repair_confirmed_spent_state()
+{
+  const auto confirmed_payment_txids = confirmed_spent_state::payment_ids<crypto::hash>(m_payments, m_blockchain.size());
+  const auto redundant_payments = confirmed_spent_state::erase_confirmed_pending_payments(
+    m_unconfirmed_payments, m_confirmed_txs, confirmed_payment_txids, m_blockchain.size());
+  const auto repaired = confirmed_spent_state::repair(m_transfers, m_key_images,
+    m_confirmed_txs, m_unconfirmed_txs, m_blockchain.size(),
+    [this](std::size_t index, std::uint64_t height) { set_spent(index, height); });
+  if (repaired.outputs || repaired.redundant_pending || redundant_payments)
+    MINFO("Confirmed spend cache repaired: outputs=" << repaired.outputs
+      << ", redundantPending=" << repaired.redundant_pending
+      << ", redundantPayments=" << redundant_payments);
 }
