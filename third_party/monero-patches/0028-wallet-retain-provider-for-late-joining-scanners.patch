 src/wallet/api/wallet.h      |  1 +
 src/wallet/api/wallet2_api.h |  1 +
 src/wallet/wallet2.cpp       | 69 +++++++++++++++++++++++++++---------
 src/wallet/wallet2.h         |  8 +++--
 5 files changed, 77 insertions(+), 18 deletions(-)

diff --git a/src/wallet/api/wallet.cpp b/src/wallet/api/wallet.cpp
index 675f6f4..4bd3352 100644
--- a/src/wallet/api/wallet.cpp
+++ b/src/wallet/api/wallet.cpp
@@ -1127,6 +1127,22 @@ std::shared_ptr<const Wallet::SharedBlockBatch> WalletImpl::fetchSharedBlockBatc
     }
 }
 
+std::shared_ptr<const Wallet::SharedBlockBatch> WalletImpl::fetchSharedBlockBatchFrom(uint64_t requestedCursor)
+{
+    boost::lock_guard<boost::mutex> guard(m_refreshMutex2);
+    clearStatus();
+    try
+    {
+        return std::make_shared<SharedBlockBatchImpl>(
+            m_wallet->fetch_shared_block_batch_from(requestedCursor));
+    }
+    catch (const std::exception &error)
+    {
+        setStatusError(error.what());
+        return {};
+    }
+}
+
 uint64_t WalletImpl::consumeSharedBlockBatch(const SharedBlockBatch &batch)
 {
     const auto *native = dynamic_cast<const SharedBlockBatchImpl*>(&batch);
