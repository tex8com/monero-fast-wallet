From 5f853b840950cfab81f77a22a2f3fd646c5bb77b Mon Sep 17 00:00:00 2001
From: TEX8 Patch Verification <patch-verification@localhost>
Date: Thu, 23 Jul 2026 16:59:48 -0500
Subject: [PATCH] grpc-stream: preserve getblocks chain-locator semantics

---
 src/wallet/grpc_stream/CMakeLists.txt         | 10 +++++++-
 src/wallet/grpc_stream/cuprate_stream.proto   |  5 ++++
 .../grpc_stream/grpc_block_stream_client.cpp  | 10 +++++---
 .../grpc_stream/grpc_block_stream_client.h    |  4 +++-
 src/wallet/wallet2.cpp                        | 23 ++++++++++++++++---
 src/wallet/wallet2.h                          |  3 ++-
 6 files changed, 46 insertions(+), 9 deletions(-)

diff --git a/src/wallet/grpc_stream/CMakeLists.txt b/src/wallet/grpc_stream/CMakeLists.txt
index 0eeb26f..2be95c4 100644
--- a/src/wallet/grpc_stream/CMakeLists.txt
+++ b/src/wallet/grpc_stream/CMakeLists.txt
@@ -22,7 +22,15 @@ if(NOT DEFINED GRPC_CPP_PLUGIN_PATH)
     find_program(GRPC_CPP_PLUGIN_PATH grpc_cpp_plugin REQUIRED)
 endif()
 if(NOT DEFINED PROTOC_PATH)
-    find_program(PROTOC_PATH protoc REQUIRED)
+    # The Monero depends prefix supplies the protobuf headers linked by the
+    # wallet. Prefer its matching protoc when available: a newer system
+    # protoc can emit generated files which the pinned headers cannot compile.
+    if(DEFINED MONERO_DEPENDS_PREFIX AND
+       EXISTS "${MONERO_DEPENDS_PREFIX}/native/bin/protoc")
+        set(PROTOC_PATH "${MONERO_DEPENDS_PREFIX}/native/bin/protoc")
+    else()
+        find_program(PROTOC_PATH protoc REQUIRED)
+    endif()
 endif()
 
 set(PROTO_FILE  "${CMAKE_CURRENT_SOURCE_DIR}/cuprate_stream.proto")
diff --git a/src/wallet/grpc_stream/cuprate_stream.proto b/src/wallet/grpc_stream/cuprate_stream.proto
index 44a069b..0fbb33b 100644
--- a/src/wallet/grpc_stream/cuprate_stream.proto
+++ b/src/wallet/grpc_stream/cuprate_stream.proto
@@ -69,6 +69,11 @@ message StreamBlocksRequest {
   // PERF log entry on the server. Lets the wallet correlate its own log
   // lines with server logs without a shared clock. Keep <= 64 chars.
   string client_request_id = 6;
+
+  // Optional compact chain locator, newest hash first. Each entry is exactly
+  // 32 bytes. When supplied, the server finds the first common block and
+  // streams from that height, matching getblocks.bin reorg semantics.
+  repeated bytes chain_locator = 7;
 }
 
 message BlockChunk {
diff --git a/src/wallet/grpc_stream/grpc_block_stream_client.cpp b/src/wallet/grpc_stream/grpc_block_stream_client.cpp
index c364364..b64d3e4 100644
--- a/src/wallet/grpc_stream/grpc_block_stream_client.cpp
+++ b/src/wallet/grpc_stream/grpc_block_stream_client.cpp
@@ -153,7 +153,8 @@ bool cuprate_grpc_stream_client::open_stream(uint64_t start_height,
                                              uint64_t stop_height,
                                              bool prune,
                                              uint32_t chunk_blocks_hint,
-                                             const std::string& client_request_id)
+                                             const std::string& client_request_id,
+                                             const std::vector<std::string>& chain_locator)
 {
     if (!p_->stub) {
         p_->last_error_code = -1;
@@ -186,17 +187,20 @@ bool cuprate_grpc_stream_client::open_stream(uint64_t start_height,
     req.set_chunk_blocks_hint(chunk_blocks_hint);
     req.set_no_miner_tx(false);
     req.set_client_request_id(client_request_id);
+    for (const std::string& hash : chain_locator)
+        req.add_chain_locator(hash);
 
     p_->ctx = std::make_unique<grpc::ClientContext>();
     p_->reader = p_->stub->StreamBlocks(p_->ctx.get(), req);
 
     std::fprintf(stderr,
-        "[GRPC client] OPEN client_req_id=%s start=%llu stop=%llu prune=%d chunk_hint=%u\n",
+        "[GRPC client] OPEN client_req_id=%s start=%llu stop=%llu prune=%d chunk_hint=%u locator_hashes=%zu\n",
         client_request_id.c_str(),
         (unsigned long long)start_height,
         (unsigned long long)stop_height,
         prune ? 1 : 0,
-        chunk_blocks_hint);
+        chunk_blocks_hint,
+        chain_locator.size());
 
     p_->recv_thread = std::thread([this]() {
         cuprate::stream::v1::BlockChunk chunk;
diff --git a/src/wallet/grpc_stream/grpc_block_stream_client.h b/src/wallet/grpc_stream/grpc_block_stream_client.h
index fcdd771..8ecc9af 100644
--- a/src/wallet/grpc_stream/grpc_block_stream_client.h
+++ b/src/wallet/grpc_stream/grpc_block_stream_client.h
@@ -29,6 +29,7 @@
 #include <cstdint>
 #include <memory>
 #include <string>
+#include <vector>
 
 namespace cuprate_grpc_stream {
 
@@ -61,7 +62,8 @@ public:
                      uint64_t stop_height,
                      bool prune,
                      uint32_t chunk_blocks_hint,
-                     const std::string& client_request_id);
+                     const std::string& client_request_id,
+                     const std::vector<std::string>& chain_locator = {});
 
     // Pop the next chunk's epee payload (blocking up to `timeout_ms`).
     // Returns false on timeout, end-of-stream, or error.
diff --git a/src/wallet/wallet2.cpp b/src/wallet/wallet2.cpp
index 2f761a5..045bb83 100644
--- a/src/wallet/wallet2.cpp
+++ b/src/wallet/wallet2.cpp
@@ -3302,7 +3302,8 @@ void wallet2::process_pool_info_extent(const cryptonote::COMMAND_RPC_GET_BLOCKS_
 }
 //----------------------------------------------------------------------------------------------------
 #ifdef MONERO_GRPC_STREAM
-bool wallet2::try_pull_blocks_grpc(bool first, uint64_t start_height, uint64_t &blocks_start_height,
+bool wallet2::try_pull_blocks_grpc(bool first, uint64_t start_height,
+    const std::list<crypto::hash> &short_chain_history, uint64_t &blocks_start_height,
     std::vector<cryptonote::block_complete_entry> &blocks,
     std::vector<cryptonote::COMMAND_RPC_GET_BLOCKS_FAST::block_output_indices> &o_indices,
     uint64_t &current_height)
@@ -3347,8 +3348,23 @@ bool wallet2::try_pull_blocks_grpc(bool first, uint64_t start_height, uint64_t &
     sid << "wallet-" << std::chrono::system_clock::now().time_since_epoch().count()
         << "-h" << effective_start;
     m_grpc_stream_session_id = sid.str();
+    std::vector<std::string> chain_locator;
+    chain_locator.reserve(std::min<size_t>(short_chain_history.size(), 256));
+    for (const crypto::hash& block_id : short_chain_history)
+    {
+      if (chain_locator.size() == 255)
+        break;
+      chain_locator.emplace_back(
+          reinterpret_cast<const char*>(&block_id), sizeof(block_id));
+    }
+    if (short_chain_history.size() > 255)
+    {
+      const crypto::hash& genesis_or_oldest = short_chain_history.back();
+      chain_locator.emplace_back(
+          reinterpret_cast<const char*>(&genesis_or_oldest), sizeof(genesis_or_oldest));
+    }
     if (!m_grpc_stream_client->open_stream(effective_start, /*stop=*/0, /*prune=*/true,
-        m_grpc_stream_chunk_hint, m_grpc_stream_session_id))
+        m_grpc_stream_chunk_hint, m_grpc_stream_session_id, chain_locator))
     {
       MWARNING("grpc_stream: open_stream failed at start=" << effective_start
         << " err=" << m_grpc_stream_client->last_error_message()
@@ -3468,7 +3484,8 @@ void wallet2::pull_blocks(bool first, bool try_incremental, uint64_t start_heigh
   if (!m_grpc_stream_endpoint.empty()
       && !m_grpc_stream_fallback_to_bin)
   {
-    if (try_pull_blocks_grpc(first, start_height, blocks_start_height, blocks, o_indices, current_height))
+    if (try_pull_blocks_grpc(first, start_height, short_chain_history,
+        blocks_start_height, blocks, o_indices, current_height))
     {
       if (first && !m_background_syncing)
       {
diff --git a/src/wallet/wallet2.h b/src/wallet/wallet2.h
index 82c5fac..9c330c9 100644
--- a/src/wallet/wallet2.h
+++ b/src/wallet/wallet2.h
@@ -1879,7 +1879,8 @@ private:
     // Try to satisfy a pull_blocks call via the cuprate gRPC stream instead
     // of bin RPC. Returns true on success (out params populated), false on
     // any error — caller should fall back to bin RPC for this iteration.
-    bool try_pull_blocks_grpc(bool first, uint64_t start_height, uint64_t &blocks_start_height,
+    bool try_pull_blocks_grpc(bool first, uint64_t start_height,
+        const std::list<crypto::hash> &short_chain_history, uint64_t &blocks_start_height,
         std::vector<cryptonote::block_complete_entry> &blocks,
         std::vector<cryptonote::COMMAND_RPC_GET_BLOCKS_FAST::block_output_indices> &o_indices,
         uint64_t &current_height);
