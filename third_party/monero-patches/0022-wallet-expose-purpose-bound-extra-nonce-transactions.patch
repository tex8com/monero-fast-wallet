     virtual PendingTransaction * createSweepUnmixableTransaction() override;
     bool submitTransaction(const std::string &fileName) override;
     virtual UnsignedTransaction * loadUnsignedTx(const std::string &unsigned_filename) override;
@@ -255,6 +263,15 @@ private:
     void pendingTxPostProcess(PendingTransactionImpl * pending);
     bool doInit(const std::string &daemon_address, const std::string &proxy_address, uint64_t upper_transaction_size_limit = 0, bool ssl = false);
     bool checkBackgroundSync(const std::string &message) const;
+    PendingTransaction * createTransactionMultDestWithExtraNonce(
+                                        const std::vector<std::string> &dst_addr,
+                                        const std::string &payment_id,
+                                        optional<std::vector<uint64_t>> amount,
+                                        uint32_t mixin_count,
+                                        PendingTransaction::Priority priority,
+                                        uint32_t subaddr_account,
+                                        std::set<uint32_t> subaddr_indices,
+                                        const std::string &extra_nonce);
 
 private:
     friend class PendingTransactionImpl;
diff --git a/src/wallet/api/wallet2_api.h b/src/wallet/api/wallet2_api.h
index c25ec44..a27aebd 100644
--- a/src/wallet/api/wallet2_api.h
+++ b/src/wallet/api/wallet2_api.h
@@ -905,6 +905,31 @@ struct Wallet
                                                    uint32_t subaddr_account = 0,
                                                    std::set<uint32_t> subaddr_indices = {}) = 0;
 
+    /*!
+     * \brief createTransactionWithExtraNonce creates a transaction carrying
+     *        one caller-provided standard tx_extra nonce.
+     * \param dst_addr          destination address as string
+     * \param amount            amount
+     * \param extra_nonce       canonical nonce payload, maximum 255 bytes
+     * \param mixin_count       mixin count. if 0 passed, wallet uses default
+     * \param priority          transaction priority
+     * \param subaddr_account   source account
+     * \param subaddr_indices   source subaddresses
+     * \return                  PendingTransaction object
+     *
+     * The caller supplies only the nonce payload. Core writes the standard
+     * TX_EXTRA_NONCE tag and canonical varint length, preventing a frontend
+     * from injecting a malformed raw tx_extra field.
+     */
+    virtual PendingTransaction * createTransactionWithExtraNonce(
+                                                   const std::string &dst_addr,
+                                                   optional<uint64_t> amount,
+                                                   const std::string &extra_nonce,
+                                                   uint32_t mixin_count,
+                                                   PendingTransaction::Priority = PendingTransaction::Priority_Low,
+                                                   uint32_t subaddr_account = 0,
+                                                   std::set<uint32_t> subaddr_indices = {}) = 0;
+
     /*!
      * \brief createSweepUnmixableTransaction creates transaction with unmixable outputs.
      * \return                  PendingTransaction object. caller is responsible to check PendingTransaction::status()
-- 
