+uint64_t wallet2::reconcile_cached_key_images(uint64_t &spent, uint64_t &unspent, ledger_key_image_sync_stats &stats) {
+  stats = {};
+  CHECK_AND_ASSERT_THROW_MES(
+      watch_only(),
+      "Cached Ledger spent-state destination is not view-only");
+  CHECK_AND_ASSERT_THROW_MES(
+      is_trusted_daemon(),
+      "Cached Ledger spent-state verification requires a trusted daemon");
+
+  std::vector<std::pair<crypto::key_image, crypto::signature>> cached_key_images;
+  cached_key_images.reserve(m_transfers.size());
+  for (size_t index = 0; index < m_transfers.size(); ++index)
+  {
+    const transfer_details &transfer = m_transfers[index];
+    CHECK_AND_ASSERT_THROW_MES(
+        transfer.m_key_image_known && !transfer.m_key_image_partial,
+        "Cached Ledger spent-state retry is missing key image " +
+            std::to_string(index));
+    cached_key_images.emplace_back(transfer.m_key_image, crypto::signature{});
+  }
+  stats.imported_output_count = cached_key_images.size();
+
+  if (cached_key_images.empty())
+  {
+    spent = 0;
+    unspent = 0;
+    return 0;
+  }
+
+  std::string destination_snapshot;
+  CHECK_AND_ASSERT_THROW_MES(
+      ::serialization::dump_binary(*this, destination_snapshot),
+      "Failed to stage cached Ledger key images before node verification");
+  i_wallet2_callback *destination_callback = m_callback;
+  m_callback = nullptr;
+
+  try
+  {
+    const auto update_started_at = std::chrono::steady_clock::now();
+    const uint64_t import_height = import_key_images(
+        cached_key_images,
+        0,
+        spent,
+        unspent,
+        true,
+        &stats.spent_status_rpc_duration_ms,
+        &stats.outgoing_rpc_duration_ms,
+        &stats.spent_status_unspent_output_count,
+        &stats.spent_status_blockchain_output_count,
+        &stats.spent_status_pool_output_count);
+    const uint64_t update_total_ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::steady_clock::now() - update_started_at).count();
+    const uint64_t rpc_total_ms =
+        stats.spent_status_rpc_duration_ms + stats.outgoing_rpc_duration_ms;
+    stats.state_update_duration_ms =
+        update_total_ms > rpc_total_ms ? update_total_ms - rpc_total_ms : 0;
+
+    m_device_last_key_image_sync = time(NULL);
+    const auto store_started_at = std::chrono::steady_clock::now();
+    store();
+    stats.store_duration_ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::steady_clock::now() - store_started_at).count();
+    m_callback = destination_callback;
+    return import_height;
+  }
+  catch (...)
+  {
+    const std::exception_ptr failure = std::current_exception();
+    const bool restored = ::serialization::parse_binary(
+        destination_snapshot,
+        *this);
+    m_callback = destination_callback;
+    CHECK_AND_ASSERT_THROW_MES(
+        restored,
+        "Cached Ledger node verification failed and wallet state could not be restored");
+    std::rethrow_exception(failure);
+  }
+}
