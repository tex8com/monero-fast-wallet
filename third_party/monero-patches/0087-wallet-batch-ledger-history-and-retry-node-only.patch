+uint64_t WalletImpl::reconcileCachedKeyImagesWithStats(uint64_t &spent, uint64_t &unspent, LedgerKeyImageSyncStats &stats)
+{
+    tools::ledger_key_image_sync_stats core_stats;
+    const uint64_t height = m_wallet->reconcile_cached_key_images(spent, unspent, core_stats);
+    stats.pendingOutputCount = core_stats.pending_output_count;
+    stats.importedOutputCount = core_stats.imported_output_count;
+    stats.derivedOutputCount = core_stats.derived_output_count;
+    stats.spentStatusUnspentOutputCount = core_stats.spent_status_unspent_output_count;
+    stats.spentStatusBlockchainOutputCount = core_stats.spent_status_blockchain_output_count;
+    stats.spentStatusPoolOutputCount = core_stats.spent_status_pool_output_count;
+    stats.derivationDurationMs = core_stats.derivation_duration_ms;
+    stats.spentStatusRpcDurationMs = core_stats.spent_status_rpc_duration_ms;
+    stats.outgoingRpcDurationMs = core_stats.outgoing_rpc_duration_ms;
+    stats.stateUpdateDurationMs = core_stats.state_update_duration_ms;
+    stats.storeDurationMs = core_stats.store_duration_ms;
+    return height;
+}
