+bool open_lane_repair(cuprate_grpc_block_range_pool::impl& p,
+    size_t index, uint64_t stripe_stop) {
+    auto& lane = p.lane_slots[index];
+    // Cancel the stalled reader before starting its replacement. Other lanes
+    // keep their queued public data and the global stream count cannot grow.
+    lane.client.reset();
+    auto client = std::make_unique<cuprate_grpc_stream_client>();
+    p.next_lane_repair_at = std::chrono::steady_clock::now() + kLaneRepairCooldown;
+    const std::string request_id = p.request_id + "-repair-"
+        + std::to_string(p.next_expected);
+    if (!client->connect(p.target, index)
+            || !client->open_stream(p.next_expected, stripe_stop, true,
+                std::min(kLaneRepairChunkBlocks, p.chunk_blocks_hint),
+                request_id, {}, kPerLaneQueueCapacity)) {
+        p.error_code = client->last_error_code();
+        p.error = client->last_error_message();
+        return false;
+    }
+    lane.client = std::move(client);
+    lane.recovering_stripe = true;
+    std::fprintf(stderr,
+        "[GRPC pool] REPAIR lane=%zu range=[%llu..%llu] after_wait_ms=%u\n",
+        index, (unsigned long long)p.next_expected,
+        (unsigned long long)stripe_stop, kLaneRepairWaitMs);
+    return true;
+}
