+bool write_chunk(grpc::ServerWriter<BlockChunk>& writer, uint64_t start,
+    uint32_t count)
+{
+    BlockChunk chunk;
+    chunk.set_start_height(start);
+    chunk.set_n_blocks(count);
+    chunk.set_chain_tip(last_height + 1);
+    chunk.set_payload(std::string(count, 'b'));
+    chunk.set_payload_bytes(count);
+    return writer.Write(chunk);
+}
