+
+    grpc::Status StreamBlockLane(grpc::ServerContext* context,
+        const StreamBlocksRequest* request,
+        grpc::ServerWriter<BlockChunk>* writer) override
+    {
+        if (request->lane_index() == 0 && request->start_height() == first_height) {
+            ++original_stalled_lane;
+            if (!delay_first_chunk_ && !write_chunk(*writer, first_height, 256))
+                return grpc::Status::OK;
+            while (!context->IsCancelled())
+                std::this_thread::sleep_for(5ms);
+            return grpc::Status::OK;
+        }
+        if (request->start_height() == resumed_height && request->lane_index() == 0)
+            ++resumed_lane;
+        else if (request->start_height() == first_height && request->lane_index() == 1)
+            ++healthy_lane;
+        else
+            return grpc::Status(grpc::StatusCode::INVALID_ARGUMENT, "unexpected lane");
+
+        if (request->lane_count() != 2 || request->stripe_span_blocks() != stripe_blocks
+                || request->stop_height() != last_height)
+            return grpc::Status(grpc::StatusCode::INVALID_ARGUMENT, "wrong stripe layout");
+        for (uint64_t start = request->start_height()
+                + request->lane_index() * stripe_blocks;
+                start <= last_height; start += 2 * stripe_blocks) {
+            const uint64_t end = std::min(start + stripe_blocks, last_height + 1);
+            if (!write_chunk(*writer, start, static_cast<uint32_t>(end - start)))
+                break;
+        }
+        return grpc::Status::OK;
+    }
+
+    grpc::Status StreamBlocks(grpc::ServerContext*,
+        const StreamBlocksRequest* request, grpc::ServerWriter<BlockChunk>* writer) override
+    {
+        ++repairs;
+        const uint64_t repair_start = first_height + (delay_first_chunk_ ? 0 : 256);
+        if (request->start_height() != repair_start
+                || request->stop_height() != first_height + stripe_blocks - 1
+                || request->chain_locator_size() != 0)
+            return grpc::Status(grpc::StatusCode::INVALID_ARGUMENT, "wrong repair range");
+        const uint64_t end = request->stop_height() + 1;
+        for (uint64_t start = repair_start; start < end; start += 64) {
+            if (!write_chunk(*writer, start + (invalid_repair_ ? 1 : 0), 64))
+                break;
+        }
+        return grpc::Status::OK;
+    }
+
+    std::atomic<unsigned> original_stalled_lane{0};
+    std::atomic<unsigned> healthy_lane{0};
+    std::atomic<unsigned> resumed_lane{0};
+    std::atomic<unsigned> repairs{0};
+
+private:
+    const bool delay_first_chunk_;
+    const bool invalid_repair_;
+};
+
+void check_repair(bool delay_first_chunk, bool invalid_repair)
+{
+    test_service service(delay_first_chunk, invalid_repair);
+    grpc::ServerBuilder builder;
+    int port = 0;
+    builder.AddListeningPort("127.0.0.1:0", grpc::InsecureServerCredentials(), &port);
+    builder.RegisterService(&service);
+    auto server = builder.BuildAndStart();
+    require(server && port > 0, "loopback server failed to start");
+
+    cuprate_grpc_block_range_pool pool;
+    require(pool.open("127.0.0.1:" + std::to_string(port),
+        first_height, last_height, 256, 2, "lane-repair-regression", {}),
+        "pool did not open");
+
+    const auto started = std::chrono::steady_clock::now();
+    uint64_t expected = first_height;
+    uint64_t repaired = 0;
+    std::string payload;
+    while (pool.next_chunk_payload(payload, 10000)) {
+        const uint32_t blocks = pool.last_chunk_n_blocks();
+        require(pool.last_chunk_start_height() == expected && blocks > 0,
+            "recovery produced a gap or duplicate");
+        require(payload.size() == blocks, "payload bookkeeping was lost");
+        if (pool.last_chunk_recovered()) {
+            require(pool.last_chunk_matches(expected, blocks),
+                "matching decoded metadata was rejected");
+            require(!pool.last_chunk_matches(expected + 1, blocks)
+                    && !pool.last_chunk_matches(expected, blocks + 1),
+                "mismatched decoded height or block count was accepted");
+            repaired += blocks;
+        }
+        expected += blocks;
+    }
+    const auto elapsed = std::chrono::steady_clock::now() - started;
+    require(elapsed < 8s, "expected lane consumed the original 10-second deadline");
+    require(service.repairs == 1 && service.original_stalled_lane == 1,
+        "the stalled lane did not get exactly one bounded repair");
+    require(service.healthy_lane == 1, "healthy lane was reopened");
+    if (invalid_repair) {
+        require(!pool.stream_ended_ok() && pool.last_error_code() == -1
+                && expected == first_height + 256 && repaired == 0,
+            "malformed replacement data advanced the ordered cursor");
+        require(service.resumed_lane == 0, "invalid data resumed the lane");
+    } else {
+        require(pool.stream_ended_ok() && expected == last_height + 1
+                && repaired == (delay_first_chunk ? stripe_blocks : 256),
+            "the repaired stream did not complete exactly the requested range");
+        require(service.resumed_lane == 1, "the lane did not rejoin its original stripes");
+    }
+    pool.close();
+    require(pool.open("127.0.0.1:" + std::to_string(port),
+        first_height, last_height, 256, 2, "lane-cancellation-regression", {}),
+        "pool did not reopen");
+    // Cancellation must also work before the receive thread creates a reader.
+    pool.close();
+    server->Shutdown();
+}
+} // namespace
+
+int main()
+{
+    try {
+        check_repair(true, false);
+        check_repair(false, false);
+        check_repair(false, true);
+        return 0;
+    } catch (const std::exception& error) {
+        std::cerr << error.what() << '\n';
+        return 1;
+    }
+}
