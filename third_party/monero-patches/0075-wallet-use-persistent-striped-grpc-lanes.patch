     std::fprintf(stderr,
-        "[GRPC client] OPEN client_req_id=%s start=%llu stop=%llu prune=%d chunk_hint=%u queue_capacity=%zu locator_hashes=%zu\n",
+        "[GRPC client] OPEN rpc=%s client_req_id=%s start=%llu stop=%llu prune=%d chunk_hint=%u queue_capacity=%zu locator_hashes=%zu stripe_span=%u lane_index=%u lane_count=%u\n",
+        lane_rpc ? "StreamBlockLane" : "StreamBlocks",
         client_request_id.c_str(),
         (unsigned long long)start_height,
         (unsigned long long)stop_height,
         prune ? 1 : 0,
         chunk_blocks_hint,
         p_->queue_capacity,
-        chain_locator.size());
+        chain_locator.size(),
+        stripe_span_blocks,
+        lane_index,
+        lane_count);
 
     p_->recv_thread = std::thread([this]() {
         cuprate::stream::v1::BlockChunk chunk;
diff --git a/src/wallet/grpc_stream/grpc_block_stream_client.h b/src/wallet/grpc_stream/grpc_block_stream_client.h
index 1e92a06..5b15262 100644
