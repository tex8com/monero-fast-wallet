+  std::string json_escape(const std::string& value)
+  {
+    std::ostringstream output;
+    for (const unsigned char byte : value)
+    {
+      switch (byte)
+      {
+        case '"': output << "\\\""; break;
+        case '\\': output << "\\\\"; break;
+        case '\b': output << "\\b"; break;
+        case '\f': output << "\\f"; break;
+        case '\n': output << "\\n"; break;
+        case '\r': output << "\\r"; break;
+        case '\t': output << "\\t"; break;
+        default:
+          if (byte < 0x20)
+          {
+            static constexpr char alphabet[] = "0123456789abcdef";
+            output << "\\u00" << alphabet[byte >> 4] << alphabet[byte & 0x0f];
+          }
+          else output << static_cast<char>(byte);
+      }
+    }
+    return output.str();
+  }
+
+  const rapidjson::Value& directory_member(const rapidjson::Value& object, const char* name)
+  {
+    if (!object.IsObject() || !object.HasMember(name))
+      throw std::runtime_error("Fast Wallet Worker Directory response was invalid");
+    return object[name];
+  }
+
+  std::string directory_string(const rapidjson::Value& object, const char* name,
+                               const std::size_t maximum_length, const bool allow_empty = false)
+  {
+    const rapidjson::Value& value = directory_member(object, name);
+    if (!value.IsString() || value.GetStringLength() > maximum_length ||
+        (!allow_empty && value.GetStringLength() == 0))
+      throw std::runtime_error("Fast Wallet Worker Directory response was invalid");
+    std::string output(value.GetString(), value.GetStringLength());
+    if (std::any_of(output.begin(), output.end(), [](const unsigned char byte) {
+          return byte == 0 || byte < 0x20;
+        }))
+      throw std::runtime_error("Fast Wallet Worker Directory response was invalid");
+    return output;
+  }
+
+  std::uint64_t directory_unsigned(const rapidjson::Value& object, const char* name)
+  {
+    const rapidjson::Value& value = directory_member(object, name);
+    if (!value.IsUint64())
+      throw std::runtime_error("Fast Wallet Worker Directory response was invalid");
+    return value.GetUint64();
+  }
+
+  std::vector<unsigned char> directory_hex(const std::string& value,
+                                           const std::size_t minimum_bytes,
+                                           const std::size_t maximum_bytes,
+                                           const char* description)
+  {
+    if (value.size() % 2 != 0 || value.size() < minimum_bytes * 2 ||
+        value.size() > maximum_bytes * 2)
+      throw std::runtime_error(std::string(description) + " is invalid");
+    return decode_lowercase_hex(value, value.size() / 2, description);
+  }
+
+  directory_worker parse_directory_worker(const rapidjson::Value& value,
+                                           const Monero::NetworkType network,
+                                           const std::uint64_t now,
+                                           const std::array<unsigned char, 32>& directory_public_key)
+  {
+    directory_worker worker;
+    worker.worker_id = directory_string(value, "workerId", 64);
+    const std::vector<unsigned char> expected_root = directory_hex(
+      worker.worker_id, 32, 32, "Worker Directory Worker ID");
+    worker.descriptor = directory_hex(
+      directory_string(value, "workerDescriptor", 8192), 1, 4096,
+      "Worker Directory descriptor");
+    const std::vector<unsigned char> certificate = directory_hex(
+      directory_string(value, "admissionCertificate", 8192), 1, 4096,
+      "Worker Directory admission certificate");
+    worker.operator_label = directory_string(value, "operatorLabel", 80);
+    worker.region = directory_string(value, "region", 80, true);
+    worker.policy_url = directory_string(value, "policyUrl", 256, true);
+    const std::uint64_t maximum_assignments = directory_unsigned(value, "maximumAssignments");
+    if (maximum_assignments == 0 || maximum_assignments > std::numeric_limits<std::uint32_t>::max())
+      throw std::runtime_error("Fast Wallet Worker Directory quota was invalid");
+    worker.maximum_assignments = static_cast<std::uint32_t>(maximum_assignments);
+    worker.last_seen_at = directory_unsigned(value, "lastSeenAt");
+
+    std::array<unsigned char, 32> verified_root{};
+    if (tex8_fast_wallet_protocol_descriptor_worker_root_id_v1(
+        worker.descriptor.data(), worker.descriptor.size(), static_cast<std::uint8_t>(network), now,
+        verified_root.data(), verified_root.size()) != TEX8_FAST_WALLET_PROTOCOL_OK ||
+        !std::equal(verified_root.begin(), verified_root.end(), expected_root.begin()))
+      throw std::runtime_error("Fast Wallet Worker Directory descriptor was invalid or mismatched");
+    std::uint32_t certified_maximum = 0;
+    if (tex8_fast_wallet_protocol_verify_worker_admission_v1(
+        worker.descriptor.data(), worker.descriptor.size(), static_cast<std::uint8_t>(network), now,
+        certificate.data(), certificate.size(), directory_public_key.data(),
+        directory_public_key.size(), &certified_maximum) != TEX8_FAST_WALLET_PROTOCOL_OK ||
+        certified_maximum != worker.maximum_assignments)
+      throw std::runtime_error("Fast Wallet Worker Directory admission certificate was invalid");
+    return worker;
+  }
+
+  std::vector<directory_worker> fetch_directory_workers(const options& input,
+                                                        const Monero::NetworkType network,
+                                                        const std::uint64_t now)
+  {
+    if (input.directory_origin.empty())
+      throw std::runtime_error("Worker Directory operation requires --directory-origin");
+    const std::string origin = require_https_origin(input.directory_origin, "--directory-origin");
+    const http_response response = https_request(origin, "GET", "/api/v1/community-workers", "",
+      nullptr, maximum_directory_response_bytes);
+    if (response.status != 200)
+      throw std::runtime_error("Fast Wallet Worker Directory request was rejected");
+    rapidjson::Document document;
+    document.Parse(response.body.data(), response.body.size());
+    if (document.HasParseError() || !document.IsObject() ||
+        directory_unsigned(document, "schemaVersion") != 1)
+      throw std::runtime_error("Fast Wallet Worker Directory response was invalid");
+    static_cast<void>(directory_unsigned(document, "sequence"));
+    static_cast<void>(directory_unsigned(document, "generatedAt"));
+    const std::vector<unsigned char> directory_key = directory_hex(
+      directory_string(document, "admissionPublicKey", 64), 32, 32,
+      "Worker Directory admission public key");
+    std::array<unsigned char, 32> directory_public_key{};
+    std::copy(directory_key.begin(), directory_key.end(), directory_public_key.begin());
+    const rapidjson::Value& workers = directory_member(document, "workers");
+    if (!workers.IsArray() || workers.Size() > maximum_directory_workers)
+      throw std::runtime_error("Fast Wallet Worker Directory response was invalid");
+    std::vector<directory_worker> output;
+    output.reserve(workers.Size());
+    std::set<std::string> unique_ids;
+    for (const rapidjson::Value& value : workers.GetArray())
+    {
+      directory_worker worker = parse_directory_worker(value, network, now, directory_public_key);
+      if (!unique_ids.insert(worker.worker_id).second)
+        throw std::runtime_error("Fast Wallet Worker Directory contained a duplicate Worker");
+      output.push_back(std::move(worker));
+    }
+    return output;
+  }
+
+  const directory_worker& selected_directory_worker(const options& input,
+                                                     const std::vector<directory_worker>& workers)
+  {
+    if (input.worker_id.empty())
+      throw std::runtime_error("public Worker selection requires --worker-id");
+    const std::vector<unsigned char> canonical_id = directory_hex(
+      input.worker_id, 32, 32, "public Worker ID");
+    static_cast<void>(canonical_id);
+    const auto found = std::find_if(workers.begin(), workers.end(), [&](const directory_worker& worker) {
+      return worker.worker_id == input.worker_id;
+    });
+    if (found == workers.end())
+      throw std::runtime_error("the selected public Worker is not currently approved and online");
+    return *found;
+  }
