     uint64_t pool_info_cost = res.added_pool_txs.size() * COST_PER_TX + (res.remaining_added_pool_txids.size() + res.removed_pool_txids.size()) * COST_PER_POOL_HASH;
     check_rpc_cost("/getblocks.bin", res.credits, pre_call_credits, 1 + res.blocks.size() * COST_PER_BLOCK + pool_info_cost);
   }
@@ -4021,6 +4025,11 @@ void wallet2::process_parsed_blocks(uint64_t start_height, const std::vector<cry
   auto t_gender1 = std::chrono::steady_clock::now();
   const double derivation_ms = std::chrono::duration<double, std::milli>(
     t_gender1 - t_gender0).count();
+  const uint64_t derivation_us = std::chrono::duration_cast<
