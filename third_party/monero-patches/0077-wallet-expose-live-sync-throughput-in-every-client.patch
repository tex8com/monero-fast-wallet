+uint64_t WalletImpl::walletSyncTransportBytesReceived() const
+{
+    boost::lock_guard<boost::mutex> guard(m_refreshMutex2);
+    return m_wallet->wallet_sync_transport_bytes_received();
+}
+
+uint64_t WalletImpl::walletSyncDerivationCount() const
+{
+    boost::lock_guard<boost::mutex> guard(m_refreshMutex2);
+    return m_wallet->wallet_sync_derivation_count();
+}
+
+uint64_t WalletImpl::walletSyncDerivationDurationUs() const
+{
+    boost::lock_guard<boost::mutex> guard(m_refreshMutex2);
+    return m_wallet->wallet_sync_derivation_duration_us();
+}
+
 std::shared_ptr<const Wallet::SharedBlockBatch> WalletImpl::fetchSharedBlockBatch()
 {
     boost::lock_guard<boost::mutex> guard(m_refreshMutex2);
