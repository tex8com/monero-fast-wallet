  */
 #pragma once
 
+#include <iomanip>
 #include <memory>
+#include <sstream>
 
 #include <boost/optional/optional.hpp>
 #include <boost/program_options/variables_map.hpp>
@@ -368,9 +370,24 @@ namespace cryptonote
         , m_blockchain_height(0)
         , m_blockchain_height_update_time()
         , m_print_time()
+        , m_rate_started_at()
+        , m_transport_bytes_at_start(0)
+        , m_derivation_count_at_start(0)
+        , m_derivation_duration_us_at_start(0)
       {
       }
 
+      void reset()
+      {
+        m_rate_started_at = std::chrono::steady_clock::now();
+        m_transport_bytes_at_start =
+          m_simple_wallet.m_wallet->wallet_sync_transport_bytes_received();
+        m_derivation_count_at_start =
+          m_simple_wallet.m_wallet->wallet_sync_derivation_count();
+        m_derivation_duration_us_at_start =
+          m_simple_wallet.m_wallet->wallet_sync_derivation_duration_us();
+      }
+
       void update(uint64_t height, bool force = false)
       {
         auto current_time = std::chrono::system_clock::now();
@@ -383,7 +400,40 @@ namespace cryptonote
 
         if (std::chrono::milliseconds(20) < current_time - m_print_time || force)
         {
-          std::cout << QT_TRANSLATE_NOOP("cryptonote::simple_wallet", "Height ") << height << " / " << m_blockchain_height << '\r' << std::flush;
+          const auto rate_now = std::chrono::steady_clock::now();
+          const double elapsed_seconds = std::chrono::duration<double>(
+            rate_now - m_rate_started_at).count();
+          const uint64_t transport_bytes =
+            m_simple_wallet.m_wallet->wallet_sync_transport_bytes_received();
+          const uint64_t derivation_count =
+            m_simple_wallet.m_wallet->wallet_sync_derivation_count();
+          const uint64_t derivation_duration_us =
+            m_simple_wallet.m_wallet->wallet_sync_derivation_duration_us();
+          const uint64_t downloaded_bytes = transport_bytes >= m_transport_bytes_at_start
+            ? transport_bytes - m_transport_bytes_at_start : 0;
+          const uint64_t completed_derivations = derivation_count >= m_derivation_count_at_start
+            ? derivation_count - m_derivation_count_at_start : 0;
+          const uint64_t measured_derivation_us =
+            derivation_duration_us >= m_derivation_duration_us_at_start
+              ? derivation_duration_us - m_derivation_duration_us_at_start : 0;
+          const double megabits_per_second = elapsed_seconds > 0.0
+            ? (static_cast<double>(downloaded_bytes) * 8.0)
+                / elapsed_seconds / 1000000.0
+            : 0.0;
+          const double derivations_per_second = measured_derivation_us > 0
+            ? static_cast<double>(completed_derivations) * 1000000.0
+                / static_cast<double>(measured_derivation_us)
+            : 0.0;
+          std::ostringstream line;
+          line << QT_TRANSLATE_NOOP("cryptonote::simple_wallet", "Block ")
+               << height
+               << QT_TRANSLATE_NOOP("cryptonote::simple_wallet", " of ")
+               << m_blockchain_height
+               << " · " << std::fixed << std::setprecision(2)
+               << megabits_per_second << " Mbit/s"
+               << " · " << std::setprecision(0)
+               << derivations_per_second << " derivations/s";
+          std::cout << line.str() << '\r' << std::flush;
           m_print_time = current_time;
         }
       }
@@ -409,6 +459,10 @@ namespace cryptonote
       uint64_t m_blockchain_height;
       std::chrono::system_clock::time_point m_blockchain_height_update_time;
       std::chrono::system_clock::time_point m_print_time;
+      std::chrono::steady_clock::time_point m_rate_started_at;
+      uint64_t m_transport_bytes_at_start;
+      uint64_t m_derivation_count_at_start;
+      uint64_t m_derivation_duration_us_at_start;
     };
 
   private:
