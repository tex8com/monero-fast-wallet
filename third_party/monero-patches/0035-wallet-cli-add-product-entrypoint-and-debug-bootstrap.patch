+set(MFW_PRODUCT_COMMIT "unknown" CACHE STRING "Monero Fast Wallet product commit")
+set(MFW_PRODUCT_DIRTY "unknown" CACHE STRING "Monero Fast Wallet product dirty state")
+set(MFW_CUPRATE_COMMIT "c041a8de1a0c27580e6816710c9443ff840287de" CACHE STRING "Pinned Cuprate product commit")
+set(MFW_SCANPACK_SCHEMA "1" CACHE STRING "ScanPack manifest schema")
+set(MFW_PRODUCT_CORE_ABI "bootstrap-0" CACHE STRING "Product core ABI identifier")
+set(MFW_FEATURE_MANIFEST_HASH "unknown" CACHE STRING "SHA-256 of the release feature manifest")
+set(MFW_BUILD_TARGET "${CMAKE_SYSTEM_NAME}-${CMAKE_SYSTEM_PROCESSOR}" CACHE STRING "Product build target")
+set(MFW_COMPILER "${CMAKE_CXX_COMPILER_ID}-${CMAKE_CXX_COMPILER_VERSION}" CACHE STRING "Product compiler identity")
+set(MFW_COMPILER_FLAGS "${CMAKE_CXX_FLAGS}" CACHE STRING "Product compiler flags")
+target_compile_definitions(fastwallet PRIVATE
+  MONERO_FAST_WALLET_PRODUCT_CLI=1
+  MFW_MONERO_UPSTREAM_COMMIT="${MFW_MONERO_UPSTREAM_COMMIT}"
+  MFW_MONERO_UPSTREAM_TREE="${MFW_MONERO_UPSTREAM_TREE}"
+  MFW_MONERO_SOURCE_COMMIT="${MFW_MONERO_SOURCE_COMMIT}"
+  MFW_MONERO_PATCHED_TREE="${MFW_MONERO_PATCHED_TREE}"
+  MFW_MONERO_PATCH_COUNT="${MFW_MONERO_PATCH_COUNT}"
+  MFW_PRODUCT_COMMIT="${MFW_PRODUCT_COMMIT}"
+  MFW_PRODUCT_DIRTY="${MFW_PRODUCT_DIRTY}"
+  MFW_CUPRATE_COMMIT="${MFW_CUPRATE_COMMIT}"
+  MFW_SCANPACK_SCHEMA="${MFW_SCANPACK_SCHEMA}"
+  MFW_PRODUCT_CORE_ABI="${MFW_PRODUCT_CORE_ABI}"
+  MFW_FEATURE_MANIFEST_HASH="${MFW_FEATURE_MANIFEST_HASH}"
+  MFW_BUILD_TARGET="${MFW_BUILD_TARGET}"
+  MFW_COMPILER="${MFW_COMPILER}"
+  MFW_COMPILER_FLAGS="${MFW_COMPILER_FLAGS}")
+set_property(TARGET fastwallet PROPERTY OUTPUT_NAME "monero-fast-wallet-cli")
+install(TARGETS fastwallet DESTINATION bin)
