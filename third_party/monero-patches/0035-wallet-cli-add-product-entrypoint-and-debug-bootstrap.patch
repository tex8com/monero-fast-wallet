@@ -0,0 +1,287 @@
+// Copyright (c) 2026 TEX8
+// SPDX-License-Identifier: BSD-3-Clause
+
+#include "product_cli_debug.h"
+
+#include <boost/filesystem.hpp>
+#include <chrono>
+#include <ctime>
+#include <iomanip>
+#include <iostream>
+#include <sstream>
+#include <stdexcept>
+
+#include "version.h"
+
+#ifndef MFW_MONERO_UPSTREAM_COMMIT
+#define MFW_MONERO_UPSTREAM_COMMIT "unknown"
+#endif
+#ifndef MFW_MONERO_UPSTREAM_TREE
+#define MFW_MONERO_UPSTREAM_TREE "unknown"
+#endif
+#ifndef MFW_MONERO_SOURCE_COMMIT
+#define MFW_MONERO_SOURCE_COMMIT "unknown"
+#endif
+#ifndef MFW_MONERO_PATCHED_TREE
+#define MFW_MONERO_PATCHED_TREE "unknown"
+#endif
+#ifndef MFW_MONERO_PATCH_COUNT
+#define MFW_MONERO_PATCH_COUNT "unknown"
+#endif
+#ifndef MFW_PRODUCT_COMMIT
+#define MFW_PRODUCT_COMMIT "unknown"
+#endif
+#ifndef MFW_PRODUCT_DIRTY
+#define MFW_PRODUCT_DIRTY "unknown"
+#endif
+#ifndef MFW_CUPRATE_COMMIT
+#define MFW_CUPRATE_COMMIT "unknown"
+#endif
+#ifndef MFW_SCANPACK_SCHEMA
+#define MFW_SCANPACK_SCHEMA "unknown"
+#endif
+#ifndef MFW_PRODUCT_CORE_ABI
+#define MFW_PRODUCT_CORE_ABI "unknown"
+#endif
+#ifndef MFW_FEATURE_MANIFEST_HASH
+#define MFW_FEATURE_MANIFEST_HASH "unknown"
+#endif
+#ifndef MFW_BUILD_TARGET
+#define MFW_BUILD_TARGET "unknown"
+#endif
+#ifndef MFW_COMPILER
+#define MFW_COMPILER "unknown"
+#endif
+#ifndef MFW_COMPILER_FLAGS
+#define MFW_COMPILER_FLAGS "unknown"
+#endif
+
+namespace
+{
+  std::string json_escape(const std::string& value)
+  {
+    std::ostringstream output;
+    for (const unsigned char character : value)
+    {
+      switch (character)
+      {
+        case '\\': output << "\\\\"; break;
+        case '"': output << "\\\""; break;
+        case '\b': output << "\\b"; break;
+        case '\f': output << "\\f"; break;
+        case '\n': output << "\\n"; break;
+        case '\r': output << "\\r"; break;
+        case '\t': output << "\\t"; break;
+        default:
+          if (character < 0x20)
+          {
+            output << "\\u" << std::hex << std::setw(4) << std::setfill('0')
+                   << static_cast<unsigned int>(character) << std::dec;
+          }
+          else
+          {
+            output << static_cast<char>(character);
+          }
+      }
+    }
+    return output.str();
+  }
+
+  std::string utc_timestamp(bool compact)
+  {
+    const std::time_t now = std::time(nullptr);
+    std::tm utc{};
+#ifdef _WIN32
+    gmtime_s(&utc, &now);
+#else
+    gmtime_r(&now, &utc);
+#endif
+    std::ostringstream output;
+    output << std::put_time(&utc, compact ? "%Y%m%dT%H%M%SZ" : "%Y-%m-%dT%H:%M:%SZ");
+    return output.str();
+  }
+
+  std::string build_json()
+  {
+    std::ostringstream output;
+    output << "{"
+           << "\"product\":\"monero-fast-wallet-cli\","
+           << "\"monero_version\":\"" << json_escape(MONERO_VERSION_FULL) << "\","
+           << "\"official_monero_upstream_commit\":\"" << MFW_MONERO_UPSTREAM_COMMIT << "\","
+           << "\"official_monero_upstream_tree\":\"" << MFW_MONERO_UPSTREAM_TREE << "\","
+           << "\"patched_monero_source_commit\":\"" << MFW_MONERO_SOURCE_COMMIT << "\","
+           << "\"patched_monero_tree\":\"" << MFW_MONERO_PATCHED_TREE << "\","
+           << "\"patch_count\":" << MFW_MONERO_PATCH_COUNT << ","
+           << "\"cuprate_commit\":\"" << MFW_CUPRATE_COMMIT << "\","
+           << "\"scanpack_schema\":\"" << MFW_SCANPACK_SCHEMA << "\","
+           << "\"product_core_abi\":\"" << MFW_PRODUCT_CORE_ABI << "\","
+           << "\"feature_manifest_hash\":\"" << MFW_FEATURE_MANIFEST_HASH << "\","
+           << "\"build_target\":\"" << json_escape(MFW_BUILD_TARGET) << "\","
+           << "\"compiler\":\"" << json_escape(MFW_COMPILER) << "\","
+           << "\"compiler_flags\":\"" << json_escape(MFW_COMPILER_FLAGS) << "\","
+           << "\"wallet_core_linkage\":\"monero-wallet-static\","
+           << "\"product_commit\":\"" << MFW_PRODUCT_COMMIT << "\","
+           << "\"product_dirty\":" << (std::string(MFW_PRODUCT_DIRTY) == "true" ? "true" : "false")
+           << "}";
+    return output.str();
+  }
+}
+
+namespace mfw_cli
+{
+  bool debug_config::validate(std::string& error) const
+  {
+    if (level != "summary" && level != "detailed" && level != "trace")
+    {
+      error = "--debug-level must be summary, detailed, or trace";
+      return false;
+    }
+    if (format != "text" && format != "jsonl" && format != "both")
+    {
+      error = "--debug-format must be text, jsonl, or both";
+      return false;
+    }
+    if (metrics_interval_ms == 0 || max_size_mib == 0 || retention == 0)
+    {
+      error = "debug interval, size, and retention must be greater than zero";
+      return false;
+    }
+    return true;
+  }
+
+  std::uint64_t monotonic_nanoseconds()
+  {
+    return static_cast<std::uint64_t>(
+      std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count());
+  }
+
+  bool handle_early_product_command(int argc, char* argv[], int& exit_code)
+  {
+    if (argc == 3 && std::string(argv[1]) == "version" && std::string(argv[2]) == "--json")
+    {
+      std::cout << build_json() << std::endl;
+      exit_code = 0;
+      return true;
+    }
+    return false;
+  }
+
+  debug_session::debug_session(const debug_config& config,
+                               std::chrono::steady_clock::time_point process_started)
+    : m_enabled(config.enabled),
+      m_config(config),
+      m_process_started(process_started)
+  {
+    if (!m_enabled)
+      return;
+
+    boost::filesystem::path output = config.output_directory.empty()
+      ? boost::filesystem::path("mfw-debug") /
+          (utc_timestamp(true) + "-" + std::to_string(monotonic_nanoseconds()))
+      : boost::filesystem::path(config.output_directory);
+    boost::filesystem::create_directories(output);
+    m_output_directory = output.string();
+
+    if (config.format == "jsonl" || config.format == "both")
+    {
+      m_jsonl.open((output / "debug-events.jsonl").string(), std::ios::out | std::ios::app);
+      if (!m_jsonl)
+        throw std::runtime_error("could not open debug-events.jsonl");
+    }
+    if (config.format == "text" || config.format == "both")
+    {
+      m_text.open((output / "debug-text.log").string(), std::ios::out | std::ios::app);
+      if (!m_text)
+        throw std::runtime_error("could not open debug-text.log");
+    }
+
+    {
+      std::ofstream environment((output / "debug-environment.json").string());
+      environment << "{\"schema_version\":1,\"build\":" << build_json()
+                  << ",\"started_at_utc\":\"" << utc_timestamp(false) << "\"}\n";
+    }
+    {
+      std::ofstream manifest((output / "debug-manifest.json").string());
+      manifest << "{\"schema_version\":1,\"status\":\"running\","
+               << "\"debug_level\":\"" << json_escape(config.level) << "\","
+               << "\"debug_format\":\"" << json_escape(config.format) << "\","
+               << "\"metrics_interval_ms\":" << config.metrics_interval_ms << ","
+               << "\"max_size_mib\":" << config.max_size_mib << ","
+               << "\"retention\":" << config.retention << "}\n";
+    }
+    event("product_cli", "debug_session_start", "ok");
+  }
+
+  debug_session::~debug_session()
+  {
+    if (!m_enabled)
+      return;
+    try
+    {
+      const std::uint64_t total_ns = static_cast<std::uint64_t>(
+        std::chrono::duration_cast<std::chrono::nanoseconds>(
+          std::chrono::steady_clock::now() - m_process_started).count());
+      const char* final_event_status = m_failed ? "failed" : "ok";
+      const char* final_artifact_status = m_failed ? "failed" : "complete";
+      event("product_cli", "process_end", final_event_status, total_ns);
+      const boost::filesystem::path output(m_output_directory);
+      std::ofstream summary((output / "debug-summary.json").string());
+      summary << "{\"schema_version\":1,\"status\":\"" << final_artifact_status << "\","
+              << "\"debug_level\":\"" << json_escape(m_config.level) << "\","
+              << "\"events\":" << m_event_count << ","
+              << "\"duration_ns_raw\":" << total_ns << ","
+              << "\"duration_ms\":" << std::fixed << std::setprecision(3)
+              << static_cast<double>(total_ns) / 1000000.0 << "}\n";
+      std::ofstream manifest((output / "debug-manifest.json").string());
+      manifest << "{\"schema_version\":1,\"status\":\"" << final_artifact_status << "\","
+               << "\"debug_level\":\"" << json_escape(m_config.level) << "\","
+               << "\"debug_format\":\"" << json_escape(m_config.format) << "\","
+               << "\"metrics_interval_ms\":" << m_config.metrics_interval_ms << ","
+               << "\"max_size_mib\":" << m_config.max_size_mib << ","
+               << "\"retention\":" << m_config.retention << "}\n";
+    }
+    catch (...)
+    {
+      // A diagnostic writer must never terminate the wallet during teardown.
+    }
+  }
+
+  void debug_session::event(const std::string& component,
+                            const std::string& phase,
+                            const std::string& status,
+                            std::uint64_t duration_ns,
+                            const std::string& error_code)
+  {
+    if (!m_enabled)
+      return;
+    if (status == "failed" || !error_code.empty())
+      m_failed = true;
+    ++m_sequence;
+    ++m_event_count;
+    const std::uint64_t timestamp_ns = monotonic_nanoseconds();
+    const double duration_ms = static_cast<double>(duration_ns) / 1000000.0;
+    if (m_jsonl)
+    {
+      m_jsonl << "{\"schema_version\":1,\"event_sequence\":" << m_sequence
+              << ",\"monotonic_timestamp_ns_raw\":" << timestamp_ns
+              << ",\"wall_timestamp_utc\":\"" << utc_timestamp(false) << "\""
+              << ",\"component\":\"" << json_escape(component) << "\""
+              << ",\"phase\":\"" << json_escape(phase) << "\""
+              << ",\"status\":\"" << json_escape(status) << "\""
+              << ",\"duration_ns_raw\":" << duration_ns
+              << ",\"duration_ms\":" << std::fixed << std::setprecision(3) << duration_ms
+              << ",\"error_code\":\"" << json_escape(error_code) << "\"}\n";
+      m_jsonl.flush();
+    }
+    if (m_text)
+    {
+      m_text << m_sequence << ' ' << component << ' ' << phase << ' ' << status
+             << " duration_ms=" << std::fixed << std::setprecision(3) << duration_ms;
+      if (!error_code.empty())
+        m_text << " error_code=" << error_code;
+      m_text << '\n';
+      m_text.flush();
+    }
+  }
+}
