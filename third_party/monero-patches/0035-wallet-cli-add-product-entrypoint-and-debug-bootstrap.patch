+find_package(Git REQUIRED)
+execute_process(
+  COMMAND "${GIT_EXECUTABLE}" -C "${CMAKE_SOURCE_DIR}" rev-parse HEAD
+  OUTPUT_VARIABLE MFW_MONERO_SOURCE_COMMIT
+  OUTPUT_STRIP_TRAILING_WHITESPACE)
+execute_process(
+  COMMAND "${GIT_EXECUTABLE}" -C "${CMAKE_SOURCE_DIR}" rev-parse "HEAD^{tree}"
+  OUTPUT_VARIABLE MFW_MONERO_PATCHED_TREE
+  OUTPUT_STRIP_TRAILING_WHITESPACE)
