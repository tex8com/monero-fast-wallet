@@ -0,0 +1,59 @@
+// Copyright (c) 2026 TEX8
+// SPDX-License-Identifier: BSD-3-Clause
+
+#pragma once
+
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+#include <fstream>
+#include <string>
+
+namespace mfw_cli
+{
+  struct debug_config
+  {
+    bool enabled = false;
+    std::string level = "detailed";
+    std::string output_directory;
+    std::string format = "both";
+    std::uint64_t metrics_interval_ms = 1000;
+    std::uint64_t max_size_mib = 128;
+    std::uint64_t retention = 10;
+
+    bool validate(std::string& error) const;
+  };
+
+  std::uint64_t monotonic_nanoseconds();
+  bool handle_early_product_command(int argc, char* argv[], int& exit_code);
+
+  class debug_session
+  {
+  public:
+    debug_session(const debug_config& config,
+                  std::chrono::steady_clock::time_point process_started);
+    ~debug_session();
+
+    debug_session(const debug_session&) = delete;
+    debug_session& operator=(const debug_session&) = delete;
+
+    void event(const std::string& component,
+               const std::string& phase,
+               const std::string& status,
+               std::uint64_t duration_ns = 0,
+               const std::string& error_code = "");
+    bool enabled() const noexcept { return m_enabled; }
+    const std::string& output_directory() const noexcept { return m_output_directory; }
+
+  private:
+    bool m_enabled = false;
+    debug_config m_config;
+    std::chrono::steady_clock::time_point m_process_started;
+    std::string m_output_directory;
+    std::ofstream m_jsonl;
+    std::ofstream m_text;
+    std::uint64_t m_sequence = 0;
+    std::uint64_t m_event_count = 0;
+    bool m_failed = false;
+  };
+}
