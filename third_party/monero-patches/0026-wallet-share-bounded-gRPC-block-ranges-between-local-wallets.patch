 constexpr size_t kMaxChannels = 8;
 constexpr uint32_t kMinRangeBlocks = 16;
 constexpr uint32_t kMaxRangeBlocks = 512;
+constexpr size_t kSharedCacheMaxEntries = 128;
+constexpr size_t kSharedCacheMaxBytes = 96 * 1024 * 1024;
+constexpr uint64_t kStableDepth = 64;
+constexpr auto kSharedCacheTtl = std::chrono::minutes(2);
+
+struct cached_chunk {
+    std::string payload;
+    uint64_t start_height = 0;
+    uint64_t chunk_seq = 0;
+    uint64_t chain_tip = 0;
+    uint32_t n_blocks = 0;
+    uint32_t payload_bytes = 0;
+    std::string server_request_id;
+};
+
+class shared_range {
+public:
+    shared_range(std::string target, uint64_t start, uint64_t stop,
+        uint32_t chunk_hint, std::string request_id,
+        std::vector<std::string> locator)
+      : target_(std::move(target)), start_(start), stop_(stop),
+        chunk_hint_(chunk_hint), request_id_(std::move(request_id)),
+        locator_(std::move(locator)), expected_(start),
+        last_access_(std::chrono::steady_clock::now()) {}
+
+    ~shared_range() {
+        client_.close();
+    }
+
+    bool open(int& error_code, std::string& error) {
+        if (!client_.connect(target_) || !client_.open_stream(
+                start_, stop_, true, chunk_hint_, request_id_, locator_, 1)) {
+            error_code = client_.last_error_code();
+            error = client_.last_error_message();
+            return false;
+        }
+        return true;
+    }
+
+    bool next(size_t& cursor, cached_chunk& out, uint32_t timeout_ms,
+        int& error_code, std::string& error) {
+        const auto deadline = std::chrono::steady_clock::now()
+            + std::chrono::milliseconds(timeout_ms);
+
+        for (;;) {
+            {
+                std::unique_lock<std::mutex> lock(mu_);
+                last_access_ = std::chrono::steady_clock::now();
+                if (cursor < chunks_.size()) {
+                    out = chunks_[cursor++];
+                    return true;
+                }
+                if (complete_) {
+                    error_code = error_code_;
+                    error = error_;
+                    return false;
+                }
+                if (fetching_) {
+                    if (!cv_.wait_until(lock, deadline, [&] {
+                            return cursor < chunks_.size() || complete_ || !fetching_;
+                        })) {
+                        error_code = -2;
+                        error = "timed out waiting for a shared block range";
+                        return false;
+                    }
+                    continue;
+                }
+                fetching_ = true;
+            }
+
+            std::string payload;
+            const bool received = client_.next_chunk_payload(payload, timeout_ms);
+            cached_chunk chunk;
+            if (received) {
+                chunk.payload = std::move(payload);
+                chunk.start_height = client_.last_chunk_start_height();
+                chunk.chunk_seq = client_.last_chunk_seq();
+                chunk.chain_tip = client_.last_chunk_chain_tip();
+                chunk.n_blocks = client_.last_chunk_n_blocks();
+                chunk.payload_bytes = client_.last_chunk_payload_bytes();
+                chunk.server_request_id = client_.last_chunk_server_request_id();
+            }
+
+            bool close_client = false;
+            {
+                std::lock_guard<std::mutex> lock(mu_);
+                fetching_ = false;
+                last_access_ = std::chrono::steady_clock::now();
+                if (received) {
+                    const uint64_t end = chunk.start_height
+                        + static_cast<uint64_t>(chunk.n_blocks);
+                    if (chunk.start_height != expected_ || chunk.n_blocks == 0
+                        || end > stop_ + 1 || end < chunk.start_height) {
+                        error_code_ = -1;
+                        error_ = "shared range gap, overlap, or invalid chunk";
+                        complete_ = true;
+                        close_client = true;
+                    } else {
+                        expected_ = end;
+                        chain_tip_ = chunk.chain_tip;
+                        payload_bytes_ += chunk.payload.size();
+                        chunks_.push_back(std::move(chunk));
+                        if (expected_ == stop_ + 1) {
+                            complete_ = true;
+                            close_client = true;
+                        }
+                    }
+                } else if (client_.stream_ended_ok()) {
+                    complete_ = true;
+                    if (expected_ != stop_ + 1) {
+                        error_code_ = -1;
+                        error_ = "shared block range ended before its requested stop height";
+                    }
+                } else if (client_.last_error_code() != 0) {
+                    error_code_ = client_.last_error_code();
+                    error_ = client_.last_error_message();
+                    complete_ = true;
+                }
+                cv_.notify_all();
+            }
+            if (close_client) {
+                client_.close();
+            }
+            if (!received && !complete()) {
+                error_code = -2;
+                error = "timed out receiving a shared block range";
+                return false;
+            }
+        }
+    }
+
+    bool complete() const {
+        std::lock_guard<std::mutex> lock(mu_);
+        return complete_;
+    }
+
+    bool retainable() const {
+        std::lock_guard<std::mutex> lock(mu_);
+        return complete_ && error_.empty()
+            && chain_tip_ > stop_ && chain_tip_ - stop_ > kStableDepth;
+    }
+
+    size_t payload_bytes() const {
+        std::lock_guard<std::mutex> lock(mu_);
+        return payload_bytes_;
+    }
+
+    std::chrono::steady_clock::time_point last_access() const {
+        std::lock_guard<std::mutex> lock(mu_);
+        return last_access_;
+    }
+
+private:
+    std::string target_;
+    uint64_t start_ = 0;
+    uint64_t stop_ = 0;
+    uint32_t chunk_hint_ = 0;
+    std::string request_id_;
+    std::vector<std::string> locator_;
+    cuprate_grpc_stream_client client_;
+
+    mutable std::mutex mu_;
+    std::condition_variable cv_;
+    std::vector<cached_chunk> chunks_;
+    size_t payload_bytes_ = 0;
+    uint64_t expected_ = 0;
+    uint64_t chain_tip_ = 0;
+    bool fetching_ = false;
+    bool complete_ = false;
+    int error_code_ = 0;
+    std::string error_;
+    std::chrono::steady_clock::time_point last_access_;
+};
+
+void append_u64(std::string& key, uint64_t value) {
+    for (unsigned shift = 0; shift < 64; shift += 8)
+        key.push_back(static_cast<char>((value >> shift) & 0xff));
+}
+
+std::string range_key(const std::string& target, uint64_t start, uint64_t stop,
+    uint32_t chunk_hint, const std::vector<std::string>& locator) {
+    std::string key;
+    key.reserve(target.size() + locator.size() * 40 + 40);
+    append_u64(key, target.size());
+    key.append(target);
+    append_u64(key, start);
+    append_u64(key, stop);
+    append_u64(key, chunk_hint);
+    append_u64(key, locator.size());
+    for (const auto& hash : locator) {
+        append_u64(key, hash.size());
+        key.append(hash);
+    }
+    return key;
 }
 
+class shared_range_cache {
+public:
+    std::shared_ptr<shared_range> acquire(const std::string& target,
+        uint64_t start, uint64_t stop, uint32_t chunk_hint,
+        const std::string& request_id, const std::vector<std::string>& locator,
+        bool& reused, int& error_code, std::string& error) {
+        const std::string key = range_key(target, start, stop, chunk_hint, locator);
+        std::lock_guard<std::mutex> lock(mu_);
+        prune_locked();
+        const auto existing = entries_.find(key);
+        if (existing != entries_.end()) {
+            reused = true;
+            ++hits_;
+            std::fprintf(stderr,
+                "[GRPC shared] HIT range=[%llu..%llu] hits=%llu misses=%llu bytes=%zu\n",
+                (unsigned long long)start, (unsigned long long)stop,
+                (unsigned long long)hits_, (unsigned long long)misses_,
+                cache_bytes_locked());
+            return existing->second;
+        }
+
+        auto range = std::make_shared<shared_range>(target, start, stop,
+            chunk_hint, request_id, locator);
+        if (!range->open(error_code, error))
+            return nullptr;
+        entries_.emplace(key, range);
+        reused = false;
+        ++misses_;
+        std::fprintf(stderr,
+            "[GRPC shared] MISS range=[%llu..%llu] hits=%llu misses=%llu\n",
+            (unsigned long long)start, (unsigned long long)stop,
+            (unsigned long long)hits_, (unsigned long long)misses_);
+        return range;
+    }
+
+    void prune() {
+        std::lock_guard<std::mutex> lock(mu_);
+        prune_locked();
+    }
+
+private:
+    size_t cache_bytes_locked() const {
+        size_t bytes = 0;
+        for (const auto& entry : entries_)
+            bytes += entry.second->payload_bytes();
+        return bytes;
+    }
+
+    void prune_locked() {
+        const auto now = std::chrono::steady_clock::now();
+        for (auto it = entries_.begin(); it != entries_.end();) {
+            const auto& range = it->second;
+            const bool map_only = range.use_count() == 1;
+            const bool expired = now - range->last_access() > kSharedCacheTtl;
+            if (map_only && (!range->retainable() || expired))
+                it = entries_.erase(it);
+            else
+                ++it;
+        }
+
+        size_t bytes = cache_bytes_locked();
+        while ((entries_.size() > kSharedCacheMaxEntries
+                || bytes > kSharedCacheMaxBytes) && !entries_.empty()) {
+            auto oldest = entries_.end();
+            for (auto it = entries_.begin(); it != entries_.end(); ++it) {
+                if (it->second.use_count() != 1 || !it->second->complete())
+                    continue;
+                if (oldest == entries_.end()
+                    || it->second->last_access() < oldest->second->last_access())
+                    oldest = it;
+            }
+            if (oldest == entries_.end())
+                break;
+            bytes -= std::min(bytes, oldest->second->payload_bytes());
+            entries_.erase(oldest);
+        }
+    }
+
+    std::mutex mu_;
+    std::unordered_map<std::string, std::shared_ptr<shared_range>> entries_;
+    uint64_t hits_ = 0;
+    uint64_t misses_ = 0;
+};
+
+shared_range_cache& process_range_cache() {
+    static shared_range_cache cache;
+    return cache;
+}
+
+uint64_t canonical_first_stop(uint64_t start, uint64_t requested_stop,
+    uint32_t range_blocks) {
+    const uint64_t remainder = start % range_blocks;
+    const uint64_t length = remainder == 0 ? range_blocks : range_blocks - remainder;
+    if (start > std::numeric_limits<uint64_t>::max() - (length - 1))
+        return requested_stop;
+    return std::min(requested_stop, start + length - 1);
+}
+} // namespace
