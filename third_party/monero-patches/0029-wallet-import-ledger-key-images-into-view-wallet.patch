From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TEX8 Patch Integrator <patches@tex8.local>
Date: Wed, 5 Aug 2026 14:30:00 -0500
Subject: [PATCH] wallet: import Ledger key images into view wallet

Keep the hardware source and local view-only companion in one trusted native
process. The Ledger signs every key image; the destination verifies every
signature against the corresponding owned output before querying its trusted
daemon for the spent state. No private key or raw key image crosses the app
bridge.

diff --git a/src/wallet/api/wallet.cpp b/src/wallet/api/wallet.cpp
index 4bd3352..b0caa64 100644
--- a/src/wallet/api/wallet.cpp
+++ b/src/wallet/api/wallet.cpp
@@ -3173,6 +3173,14 @@ uint64_t WalletImpl::coldKeyImageSync(uint64_t &spent, uint64_t &unspent)
     return m_wallet->cold_key_image_sync(spent, unspent);
 }
 
+uint64_t WalletImpl::coldKeyImageSyncTo(Wallet &destination, uint64_t &spent, uint64_t &unspent)
+{
+    auto *destination_impl = dynamic_cast<WalletImpl *>(&destination);
+    if (destination_impl == nullptr)
+        throw runtime_error("Cold key-image destination is not a compatible wallet");
+    return m_wallet->cold_key_image_sync_to(*destination_impl->m_wallet, spent, unspent);
+}
