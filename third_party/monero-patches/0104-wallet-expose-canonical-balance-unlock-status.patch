From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TEX8 Monero Patch Integrator <monero-patches@tex8.local>
Date: Tue, 3 Nov 2026 16:00:00 -0500
Subject: [PATCH] wallet: expose canonical balance unlock status

Expose Core's account balance, unlocked balance and native maximum blocks/time
remaining in one local summary. Keep pending mempool/change contributions
explicit: their final unlock height cannot be known before they are mined.
No history-based estimates, daemon requests or wallet mutation are introduced.

---
diff --git a/src/wallet/api/wallet2_api.h b/src/wallet/api/wallet2_api.h
--- a/src/wallet/api/wallet2_api.h
+++ b/src/wallet/api/wallet2_api.h
@@ -725,6 +725,18 @@
             result += balance(i);
         return result;
     }
+    // Canonical Core state only: block/time values describe the latest
+    // confirmed locked output, not an estimate from transaction history.
+    // Pending balance cannot have a full-unlock block count before mining.
+    struct BalanceUnlockStatus {
+        uint64_t balance = 0;
+        uint64_t unlockedBalance = 0;
+        uint64_t blocksToUnlock = 0;
+        uint64_t timeToUnlock = 0;
+        bool hasPendingBalance = false;
+        bool unlockInfoKnown = false;
+    };
+    virtual BalanceUnlockStatus balanceUnlockStatus(uint32_t accountIndex = 0) const = 0;
     virtual uint64_t unlockedBalance(uint32_t accountIndex = 0) const = 0;
     uint64_t unlockedBalanceAll() const {
         uint64_t result = 0;
diff --git a/src/wallet/api/wallet.h b/src/wallet/api/wallet.h
--- a/src/wallet/api/wallet.h
+++ b/src/wallet/api/wallet.h
@@ -136,6 +136,7 @@
     bool setProxy(const std::string &address) override;
     uint64_t balance(uint32_t accountIndex = 0) const override;
     std::map<uint32_t, uint64_t> balancePerSubaddress(uint32_t accountIndex = 0) const override;
+    BalanceUnlockStatus balanceUnlockStatus(uint32_t accountIndex = 0) const override;
     uint64_t unlockedBalance(uint32_t accountIndex = 0) const override;
     uint64_t blockChainHeight() const override;
     uint64_t approximateBlockChainHeight() const override;
diff --git a/src/wallet/api/wallet.cpp b/src/wallet/api/wallet.cpp
--- a/src/wallet/api/wallet.cpp
+++ b/src/wallet/api/wallet.cpp
@@ -1479,6 +1479,17 @@
 std::map<uint32_t, uint64_t> WalletImpl::balancePerSubaddress(uint32_t accountIndex) const
 {
     return m_wallet->balance_per_subaddress(accountIndex, false);
+}
+
+Wallet::BalanceUnlockStatus WalletImpl::balanceUnlockStatus(uint32_t accountIndex) const
+{
+    BalanceUnlockStatus result;
+    result.balance = m_wallet->balance(accountIndex, false);
+    result.unlockedBalance = m_wallet->unlocked_balance(
+        accountIndex, false, &result.blocksToUnlock, &result.timeToUnlock);
+    result.hasPendingBalance = m_wallet->has_unconfirmed_balance(accountIndex);
+    result.unlockInfoKnown = !m_wallet->light_wallet();
+    return result;
 }
 
 uint64_t WalletImpl::unlockedBalance(uint32_t accountIndex) const
diff --git a/src/wallet/wallet2.h b/src/wallet/wallet2.h
--- a/src/wallet/wallet2.h
+++ b/src/wallet/wallet2.h
@@ -1241,6 +1241,7 @@
     // locked & unlocked balance of given or current subaddress account
     uint64_t balance(uint32_t subaddr_index_major, bool strict) const;
     uint64_t unlocked_balance(uint32_t subaddr_index_major, bool strict, uint64_t *blocks_to_unlock = NULL, uint64_t *time_to_unlock = NULL);
+    bool has_unconfirmed_balance(uint32_t subaddr_index_major) const;
     // locked & unlocked balance per subaddress of given or current subaddress account
     std::map<uint32_t, uint64_t> balance_per_subaddress(uint32_t subaddr_index_major, bool strict) const;
     std::map<uint32_t, std::pair<uint64_t, std::pair<uint64_t, uint64_t>>> unlocked_balance_per_subaddress(uint32_t subaddr_index_major, bool strict);
diff --git a/src/wallet/wallet2.cpp b/src/wallet/wallet2.cpp
--- a/src/wallet/wallet2.cpp
+++ b/src/wallet/wallet2.cpp
@@ -8716,6 +8716,34 @@
   return amount_per_subaddr;
 }
 //----------------------------------------------------------------------------------------------------
+bool wallet2::has_unconfirmed_balance(uint32_t index_major) const
+{
+  // Match precisely the unconfirmed additions in balance_per_subaddress(false),
+  // rather than inferring pending amounts from incomplete transaction history.
+  for (const auto &entry : m_unconfirmed_txs)
+  {
+    const auto &transfer = entry.second;
+    if (transfer.m_subaddr_account != index_major ||
+        transfer.m_state == unconfirmed_transfer_details::failed)
+      continue;
+    if (transfer.m_change > 0)
+      return true;
+    for (const auto &destination : transfer.m_dests)
+    {
+      const auto index = get_subaddress_index(destination.addr);
+      if (destination.amount > 0 && index && index->major == index_major)
+        return true;
+    }
+  }
+  for (const auto &entry : m_unconfirmed_payments)
+  {
+    if (entry.second.m_pd.m_subaddr_index.major == index_major &&
+        entry.second.m_pd.m_amount > 0)
+      return true;
+  }
+  return false;
+}
+//----------------------------------------------------------------------------------------------------
 std::map<uint32_t, std::pair<uint64_t, std::pair<uint64_t, uint64_t>>> wallet2::unlocked_balance_per_subaddress(uint32_t index_major, bool strict)
 {
   std::map<uint32_t, std::pair<uint64_t, std::pair<uint64_t, uint64_t>>> amount_per_subaddr;
