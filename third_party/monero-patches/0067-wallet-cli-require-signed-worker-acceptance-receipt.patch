+  std::string json_string(const std::string& body, const char* name,
+                          const std::size_t maximum_length)
+  {
+    const std::string key = std::string("\"") + name + "\"";
+    const std::size_t found = body.find(key);
+    if (found == std::string::npos)
+      throw std::runtime_error("Fast Wallet service response was invalid");
+    std::size_t cursor = found + key.size();
+    while (cursor < body.size() && std::isspace(static_cast<unsigned char>(body[cursor]))) ++cursor;
+    if (cursor == body.size() || body[cursor++] != ':')
+      throw std::runtime_error("Fast Wallet service response was invalid");
+    while (cursor < body.size() && std::isspace(static_cast<unsigned char>(body[cursor]))) ++cursor;
+    if (cursor == body.size() || body[cursor++] != '"')
+      throw std::runtime_error("Fast Wallet service response was invalid");
+    const std::size_t start = cursor;
+    while (cursor < body.size() && body[cursor] != '"')
+    {
+      if (body[cursor] == '\\' || static_cast<unsigned char>(body[cursor]) < 0x20)
+        throw std::runtime_error("Fast Wallet service response was invalid");
+      ++cursor;
+    }
+    if (cursor == body.size() || cursor == start || cursor - start > maximum_length)
+      throw std::runtime_error("Fast Wallet service response was invalid");
+    return body.substr(start, cursor - start);
+  }
