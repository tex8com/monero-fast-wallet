+  void verify_worker_receipt(const std::vector<unsigned char>& descriptor,
+                             const Monero::NetworkType network,
+                             const std::uint64_t now,
+                             const persisted_hosted_watch& state,
+                             const std::string& relay_origin)
+  {
+    if (bytes_are_zero(state.relay_message_id.data(), state.relay_message_id.size()))
+      throw std::runtime_error("Fast Wallet Worker Relay message ID is missing");
+    const std::string message_id = hex_encode(
+      state.relay_message_id.data(), state.relay_message_id.size());
+    const std::string path = "/v1/envelopes/" + message_id + "/receipt";
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(12);
+    while (std::chrono::steady_clock::now() < deadline)
+    {
+      const http_response response = https_request(relay_origin, "GET", path.c_str(), "", nullptr);
+      if (response.status == 202 && json_string(response.body, "status", 16) == "pending")
+      {
+        std::this_thread::sleep_for(std::chrono::milliseconds(250));
+        continue;
+      }
+      if (response.status != 200 || json_string(response.body, "status", 16) != "accepted")
+        throw std::runtime_error("Fast Wallet Worker receipt is unavailable");
+      const std::string receipt_text = json_string(response.body, "receipt", 408);
+      const std::vector<unsigned char> receipt = decode_lowercase_hex(
+        receipt_text, 204, "Fast Wallet Worker receipt");
+      const std::uint64_t verification_time = now == 0 ? unix_seconds() : now;
+      if (tex8_fast_wallet_protocol_verify_worker_receipt_v1(
+          descriptor.data(), descriptor.size(), static_cast<std::uint8_t>(network),
+          verification_time, state.relay_message_id.data(), receipt.data(), receipt.size()) !=
+          TEX8_FAST_WALLET_PROTOCOL_OK)
+        throw std::runtime_error("Fast Wallet Worker receipt signature is invalid");
+      return;
+    }
+    throw std::runtime_error("Fast Wallet Worker receipt is still pending; rerun worker enroll");
   }
 
