+std::shared_ptr<const Wallet::SharedBlockBatch> WalletImpl::fetchSharedBlockBatch()
+{
+    boost::lock_guard<boost::mutex> guard(m_refreshMutex2);
+    clearStatus();
+    try
+    {
+        return std::make_shared<SharedBlockBatchImpl>(
+            m_wallet->fetch_shared_block_batch());
+    }
+    catch (const std::exception &error)
+    {
+        setStatusError(error.what());
+        return {};
+    }
+}
+
+uint64_t WalletImpl::consumeSharedBlockBatch(const SharedBlockBatch &batch)
+{
+    const auto *native = dynamic_cast<const SharedBlockBatchImpl*>(&batch);
+    if (native == nullptr)
+    {
+        setStatusError("shared block batch was created by a different Core");
+        return 0;
+    }
+    boost::lock_guard<boost::mutex> guard(m_refreshMutex2);
+    clearStatus();
+    try
+    {
+        return m_wallet->consume_shared_block_batch(native->value());
+    }
+    catch (const std::exception &error)
+    {
+        setStatusError(error.what());
+        return 0;
+    }
+}
