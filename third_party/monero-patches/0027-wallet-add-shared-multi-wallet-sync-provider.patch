+//----------------------------------------------------------------------------------------------------
+std::shared_ptr<const wallet2::shared_block_batch> wallet2::fetch_shared_block_batch()
+{
+  THROW_WALLET_EXCEPTION_IF(m_offline, error::wallet_internal_error,
+    "cannot fetch a shared block batch while offline");
+
+  m_run.store(true, std::memory_order_relaxed);
+  std::list<crypto::hash> short_chain_history;
+  get_short_chain_history(short_chain_history,
+    (m_first_refresh_done || is_trusted_daemon()) ? 1 : FIRST_REFRESH_GRANULARITY);
+
+  const uint64_t target_cursor = wallet_sync_target_cursor();
+  uint64_t blocks_start_height = 0;
+  if (target_cursor > m_blockchain.size())
+  {
+    fast_refresh(target_cursor, blocks_start_height, short_chain_history);
+    short_chain_history.clear();
+    get_short_chain_history(short_chain_history,
+      (m_first_refresh_done || is_trusted_daemon()) ? 1 : FIRST_REFRESH_GRANULARITY);
+  }
+
+  auto batch = std::make_shared<shared_block_batch>();
+  batch->network = m_nettype;
+  std::vector<cryptonote::COMMAND_RPC_GET_BLOCKS_FAST::block_output_indices> o_indices;
+  pull_blocks(false, true, 0, batch->start_height, short_chain_history,
+    batch->blocks, o_indices, batch->current_height);
+  THROW_WALLET_EXCEPTION_IF(batch->blocks.size() != o_indices.size(),
+    error::wallet_internal_error, "shared block/output-index size mismatch");
+
+  batch->parsed_blocks.resize(batch->blocks.size());
+  tools::threadpool& tpool = tools::threadpool::getInstanceForCompute();
+  tools::threadpool::waiter waiter(tpool);
+  for (size_t i = 0; i < batch->blocks.size(); ++i)
+  {
+    tpool.submit(&waiter, boost::bind(&wallet2::parse_block_round, this,
+      std::cref(batch->blocks[i].block),
+      std::ref(batch->parsed_blocks[i].block),
+      std::ref(batch->parsed_blocks[i].hash),
+      std::ref(batch->parsed_blocks[i].error)), true);
+  }
+  THROW_WALLET_EXCEPTION_IF(!waiter.wait(), error::wallet_internal_error,
+    "shared block parser failed");
+
+  boost::mutex parse_error_lock;
+  bool parse_error = false;
+  for (size_t i = 0; i < batch->blocks.size(); ++i)
+  {
+    THROW_WALLET_EXCEPTION_IF(batch->parsed_blocks[i].error,
+      error::wallet_internal_error, "invalid block in shared batch");
+    const uint8_t hf_version = batch->parsed_blocks[i].block.major_version;
+    bool wallet_is_outdated = false;
+    bool daemon_is_outdated = false;
+    check_block_hard_fork_version(m_nettype, hf_version,
+      batch->start_height + i, wallet_is_outdated, daemon_is_outdated);
+    THROW_WALLET_EXCEPTION_IF(
+      !m_allow_mismatched_daemon_version &&
+        (wallet_is_outdated || daemon_is_outdated),
+      error::incorrect_fork_version,
+      "unexpected hard-fork version in shared batch");
+    batch->parsed_blocks[i].o_indices = std::move(o_indices[i]);
+    batch->parsed_blocks[i].txes.resize(batch->blocks[i].txs.size());
+    for (size_t j = 0; j < batch->blocks[i].txs.size(); ++j)
+    {
+      tpool.submit(&waiter, [&, i, j]() {
+        if (!parse_and_validate_tx_base_from_blob(
+              batch->blocks[i].txs[j].blob,
+              batch->parsed_blocks[i].txes[j]))
+        {
+          boost::unique_lock<boost::mutex> lock(parse_error_lock);
+          parse_error = true;
+        }
+      }, true);
+    }
+  }
+  THROW_WALLET_EXCEPTION_IF(!waiter.wait(), error::wallet_internal_error,
+    "shared transaction parser failed");
+  THROW_WALLET_EXCEPTION_IF(parse_error, error::wallet_internal_error,
+    "invalid transaction in shared batch");
+
+  return batch;
+}
+//----------------------------------------------------------------------------------------------------
+uint64_t wallet2::consume_shared_block_batch(const shared_block_batch &batch)
+{
+  THROW_WALLET_EXCEPTION_IF(batch.network != m_nettype,
+    error::wallet_internal_error, "shared batch network mismatch");
+  THROW_WALLET_EXCEPTION_IF(batch.blocks.size() != batch.parsed_blocks.size(),
+    error::wallet_internal_error, "shared batch size mismatch");
+  if (batch.blocks.empty())
+    return 0;
+  THROW_WALLET_EXCEPTION_IF(
+    batch.start_height > std::numeric_limits<uint64_t>::max() - batch.blocks.size(),
+    error::wallet_internal_error, "shared batch height overflow");
+
+  size_t offset = 0;
+  // A newly restored wallet does not need a private copy of every historical
+  // block hash. The provider may return a public overlap before this wallet's
+  // restore height, so select the exact target block and anchor to its parent.
+  // This keeps wallets with different restore heights on the same fetched
+  // batch without silently skipping a gap.
+  const uint64_t target = wallet_sync_target_cursor();
+  const uint64_t batch_end = batch.start_height + batch.blocks.size();
+  if (m_blockchain.size() < target)
+  {
+    THROW_WALLET_EXCEPTION_IF(batch.start_height > target,
+      error::wallet_internal_error, "gap before wallet restore target");
+    if (target >= batch_end)
+      return 0;
+    offset = static_cast<size_t>(target - batch.start_height);
+    m_blockchain.reset_from_checkpoint(
+      target, batch.parsed_blocks[offset].block.prev_id);
+  }
+
+  if (batch.start_height < m_blockchain.offset())
+  {
+    offset = std::max(offset,
+      static_cast<size_t>(m_blockchain.offset() - batch.start_height));
+    if (offset >= batch.blocks.size())
+      return 0;
+  }
+  const uint64_t effective_start = batch.start_height + offset;
+  THROW_WALLET_EXCEPTION_IF(effective_start > m_blockchain.size(),
+    error::wallet_internal_error, "gap before shared block batch");
+
+  std::vector<cryptonote::block_complete_entry> blocks(
+    batch.blocks.begin() + offset, batch.blocks.end());
+  std::vector<parsed_block> parsed(
+    batch.parsed_blocks.begin() + offset, batch.parsed_blocks.end());
+  uint64_t blocks_added = 0;
+  process_parsed_blocks(effective_start, blocks, parsed, blocks_added, nullptr);
+  m_node_rpc_proxy.set_height(m_blockchain.size());
+  m_has_ever_refreshed_from_node = true;
+  m_first_refresh_done = true;
+  return blocks_added;
+}
+//----------------------------------------------------------------------------------------------------
+std::shared_ptr<const wallet2::shared_pool_snapshot> wallet2::fetch_shared_pool_snapshot()
+{
+  auto snapshot = std::make_shared<shared_pool_snapshot>();
+  snapshot->network = m_nettype;
+  snapshot->captured_unix_ms = static_cast<uint64_t>(
+    std::chrono::duration_cast<std::chrono::milliseconds>(
+      std::chrono::system_clock::now().time_since_epoch()).count());
+
+  cryptonote::COMMAND_RPC_GET_TRANSACTION_POOL_HASHES_BIN::request req;
+  cryptonote::COMMAND_RPC_GET_TRANSACTION_POOL_HASHES_BIN::response res;
+  {
+    const boost::lock_guard<boost::recursive_mutex> lock{m_daemon_rpc_mutex};
+    req.client = get_client_signature();
+    const bool ok = epee::net_utils::invoke_http_json(
+      "/get_transaction_pool_hashes.bin", req, res, *m_http_client, rpc_timeout);
+    THROW_ON_RPC_RESPONSE_ERROR(ok, {}, res,
+      "get_transaction_pool_hashes.bin", error::get_tx_pool_error);
+  }
+
+  m_node_rpc_proxy.get_transactions(res.tx_hashes,
+    [&res, &snapshot](
+      const cryptonote::COMMAND_RPC_GET_TRANSACTIONS::request &tx_req,
+      const cryptonote::COMMAND_RPC_GET_TRANSACTIONS::response &tx_res,
+      bool ok)
+    {
+      read_pool_txs(tx_req, tx_res, ok, res.tx_hashes, snapshot->txs);
+    });
+  return snapshot;
+}
+//----------------------------------------------------------------------------------------------------
+void wallet2::consume_shared_pool_snapshot(const shared_pool_snapshot &snapshot)
+{
+  THROW_WALLET_EXCEPTION_IF(snapshot.network != m_nettype,
+    error::wallet_internal_error, "shared pool network mismatch");
+  std::vector<std::tuple<cryptonote::transaction, crypto::hash, bool>> process_txs;
+  update_pool_state_from_pool_data(false, {}, snapshot.txs, process_txs, true);
+  process_pool_state(process_txs);
+}
+//----------------------------------------------------------------------------------------------------
+void wallet2::detach_wallet_to_height(
+    uint64_t height, const crypto::hash &expected_previous_hash)
+{
+  THROW_WALLET_EXCEPTION_IF(height == 0 || height > m_blockchain.size(),
+    error::wallet_internal_error, "invalid shared detach height");
+  THROW_WALLET_EXCEPTION_IF(!m_blockchain.is_in_bounds(height - 1),
+    error::wallet_internal_error, "shared detach checkpoint is unavailable");
+  THROW_WALLET_EXCEPTION_IF(m_blockchain[height - 1] != expected_previous_hash,
+    error::wallet_internal_error, "shared detach checkpoint hash mismatch");
+  if (height < m_blockchain.size())
+    handle_reorg(height, nullptr);
+}
