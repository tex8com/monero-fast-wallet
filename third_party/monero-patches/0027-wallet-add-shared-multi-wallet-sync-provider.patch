+bool WalletImpl::detachWalletToHeight(
+    uint64_t height, const std::string &expectedPreviousHash)
+{
+    crypto::hash expected;
+    if (!epee::string_tools::hex_to_pod(expectedPreviousHash, expected))
+    {
+        setStatusError("invalid shared detach checkpoint hash");
+        return false;
+    }
+    boost::lock_guard<boost::mutex> guard(m_refreshMutex2);
+    clearStatus();
+    try
+    {
+        m_wallet->detach_wallet_to_height(height, expected);
+        return true;
+    }
+    catch (const std::exception &error)
+    {
+        setStatusError(error.what());
+        return false;
+    }
+}
