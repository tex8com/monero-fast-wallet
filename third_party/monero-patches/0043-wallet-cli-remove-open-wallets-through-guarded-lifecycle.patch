@@ -105,6 +105,9 @@ namespace cryptonote
     boost::optional<epee::wipeable_string> new_wallet(const boost::program_options::variables_map& vm);
     boost::optional<epee::wipeable_string> open_wallet(const boost::program_options::variables_map& vm);
     bool close_wallet();
+#ifdef MONERO_FAST_WALLET_PRODUCT_CLI
+    bool remove_wallet(const std::vector<std::string> &args = std::vector<std::string>());
+#endif
 
     bool viewkey(const std::vector<std::string> &args = std::vector<std::string>());
     bool spendkey(const std::vector<std::string> &args = std::vector<std::string>());
