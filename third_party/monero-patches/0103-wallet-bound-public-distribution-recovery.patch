 constexpr size_t max_wire_bytes = 32 * 1024 * 1024;
 constexpr size_t max_decoded_bytes = 96 * 1024 * 1024;
 
+// Codes are fixed public-operation stages, never raw transport errors.
+enum class failure_stage {
+  none, connect, anchor_read, anchor_response, distribution_read,
+  distribution_response, wire_limit, network_validation,
+  chain_validation, snapshot_validation, cancelled, expired,
+  payment_required, worker_start, unknown
+};
+inline const char* failure_stage_code(failure_stage stage) {
+  switch (stage) {
+    case failure_stage::none: return "none";
+    case failure_stage::connect: return "connect";
+    case failure_stage::anchor_read: return "anchor-read";
+    case failure_stage::anchor_response: return "anchor-response";
+    case failure_stage::distribution_read: return "distribution-read";
+    case failure_stage::distribution_response: return "distribution-response";
+    case failure_stage::wire_limit: return "wire-limit";
+    case failure_stage::network_validation: return "network-validation";
+    case failure_stage::chain_validation: return "chain-validation";
+    case failure_stage::snapshot_validation: return "snapshot-validation";
+    case failure_stage::cancelled: return "cancelled";
+    case failure_stage::expired: return "expired";
+    case failure_stage::payment_required: return "payment-required";
+    case failure_stage::worker_start: return "worker-start";
+    default: return "unknown";
+  }
+}
+class cache_failure : public std::runtime_error {
+public:
+  explicit cache_failure(failure_stage value)
+    : std::runtime_error(failure_stage_code(value)), stage(value) {}
+  const failure_stage stage;
+};
+// Only an incomplete public transport operation is eligible for one retry.
+// Valid but malformed/untrusted responses never use this exception type.
+class transport_failure final : public cache_failure {
+public:
+  explicit transport_failure(failure_stage value): cache_failure(value) {}
+};
+
 struct cancellation {
   std::atomic<bool> stopped{false};
   const std::chrono::steady_clock::time_point deadline;
   explicit cancellation(std::chrono::milliseconds budget): deadline(std::chrono::steady_clock::now() + budget) {}
   void check() const {
-    if (stopped.load() || std::chrono::steady_clock::now() >= deadline)
-      throw std::runtime_error("public distribution work cancelled or expired");
+    if (stopped.load()) throw cache_failure(failure_stage::cancelled);
+    if (std::chrono::steady_clock::now() >= deadline)
+      throw cache_failure(failure_stage::expired);
   }
 };
 struct payment_required : std::runtime_error { payment_required(): std::runtime_error("public RPC requires payment") {} };
