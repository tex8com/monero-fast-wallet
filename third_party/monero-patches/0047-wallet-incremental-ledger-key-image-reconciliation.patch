 //----------------------------------------------------------------------------------------------------
 uint64_t wallet2::cold_key_image_sync_to(wallet2 &destination, uint64_t &spent, uint64_t &unspent) {
+  ledger_key_image_sync_stats stats;
+  return cold_key_image_sync_to(destination, spent, unspent, stats);
+}
+//----------------------------------------------------------------------------------------------------
+uint64_t wallet2::cold_key_image_sync_to(wallet2 &destination, uint64_t &spent, uint64_t &unspent, ledger_key_image_sync_stats &stats) {
+  stats = {};
   // Keep this API name for wallet-api ABI compatibility. Ledger does not
   // implement device_cold::ki_sync. The view-only destination has already
   // found the small set of wallet-owned outputs while scanning locally. Ask
@@ -13677,19 +13683,62 @@ uint64_t wallet2::cold_key_image_sync_to(wallet2 &destination, uint64_t &spent,
   CHECK_AND_ASSERT_THROW_MES(
       destination.watch_only(),
       "Key-image cache destination is not view-only");
+
+  auto &hwdev = get_account().get_device();
+  size_t import_offset = destination.m_transfers.size();
+  for (size_t index = 0; index < destination.m_transfers.size(); ++index)
+  {
+    const transfer_details &transfer = destination.m_transfers[index];
+    if (!transfer.m_key_image_known || transfer.m_key_image_partial)
+    {
+      import_offset = std::min(import_offset, index);
+      ++stats.pending_output_count;
+    }
+  }
+
+  // A second run is intentionally a no-op: no Ledger prompts, no daemon RPC,
+  // and no wallet-cache rewrite. This is the common fast path after the view
+  // wallet has already reconciled every owned output.
+  if (stats.pending_output_count == 0)
+  {
+    spent = 0;
+    unspent = 0;
+    for (const transfer_details &transfer : destination.m_transfers)
+    {
+      if (transfer.m_frozen)
+        continue;
+      if (transfer.m_spent)
+        spent += transfer.amount();
+      else
+        unspent += transfer.amount();
+    }
+    return destination.m_transfers.empty()
+        ? 0
+        : destination.m_transfers.back().m_block_height;
+  }
+
   CHECK_AND_ASSERT_THROW_MES(
       destination.is_trusted_daemon(),
       "Ledger spent-state verification requires a trusted daemon");
 
-  auto &hwdev = get_account().get_device();
   std::vector<std::pair<crypto::key_image, crypto::signature>> derived_key_images;
-  derived_key_images.reserve(destination.m_transfers.size());
+  derived_key_images.reserve(destination.m_transfers.size() - import_offset);
+  std::vector<std::pair<size_t, crypto::key_image>> pending_key_images;
+  pending_key_images.reserve(stats.pending_output_count);
   std::set<std::pair<uint32_t, uint32_t>> prepared_subaddresses;
-  destination.m_key_images.clear();
-  for (size_t index = 0; index < destination.m_transfers.size(); ++index)
+  const auto derivation_started_at = std::chrono::steady_clock::now();
+  for (size_t index = import_offset; index < destination.m_transfers.size(); ++index)
   {
     transfer_details &destination_transfer = destination.m_transfers[index];
 
+    if (destination_transfer.m_key_image_known && !destination_transfer.m_key_image_partial)
+    {
+      derived_key_images.emplace_back(
+          destination_transfer.m_key_image,
+          crypto::signature{});
+      continue;
+    }
+
     const auto subaddress = std::make_pair(
         destination_transfer.m_subaddr_index.major,
         destination_transfer.m_subaddr_index.minor);
@@ -13735,29 +13784,85 @@ uint64_t wallet2::cold_key_image_sync_to(wallet2 &destination, uint64_t &spent,
         "Ledger-derived ephemeral public key does not match owned output " +
             std::to_string(index));
 
-    destination_transfer.m_key_image = key_image;
-    destination_transfer.m_key_image_known = true;
-    destination_transfer.m_key_image_request = false;
-    destination_transfer.m_key_image_partial = false;
-    destination.m_key_images[destination_transfer.m_key_image] = index;
-    destination.m_pub_keys[destination_transfer.get_public_key()] = index;
+    pending_key_images.emplace_back(index, key_image);
     derived_key_images.emplace_back(key_image, crypto::signature{});
+    ++stats.derived_output_count;
   }
+  stats.derivation_duration_ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+      std::chrono::steady_clock::now() - derivation_started_at).count();
+  stats.imported_output_count = derived_key_images.size();
 
-  // The key image came directly from the authenticated hardware operation and
-  // was bound above to the locally discovered output public key. Pre-seeding
-  // the destination lets the existing import path skip file-signature checks,
-  // query the trusted daemon once, and retain Monero's normal outgoing/spent
-  // bookkeeping without exporting any key material from this process.
-  const uint64_t import_height = destination.import_key_images(
-      derived_key_images,
-      0,
-      spent,
-      unspent,
-      true);
-  m_device_last_key_image_sync = time(NULL);
-  destination.m_device_last_key_image_sync = m_device_last_key_image_sync;
-  return import_height;
+  CHECK_AND_ASSERT_THROW_MES(
+      stats.derived_output_count == stats.pending_output_count,
+      "Ledger key-image staging did not cover every pending owned output");
+
+  // Snapshot before the first live mutation. The destination is held behind a
+  // session mutation lock by every product caller, so a failed RPC, rejected
+  // device action, invalid response, or failed durable store cannot expose a
+  // partially reconciled wallet state.
+  std::string destination_snapshot;
+  CHECK_AND_ASSERT_THROW_MES(
+      ::serialization::dump_binary(destination, destination_snapshot),
+      "Failed to stage the view-only wallet before key-image reconciliation");
+  i_wallet2_callback *destination_callback = destination.m_callback;
+  destination.m_callback = nullptr;
+
+  try
+  {
+    for (const auto &pending : pending_key_images)
+    {
+      transfer_details &destination_transfer = destination.m_transfers[pending.first];
+      destination_transfer.m_key_image = pending.second;
+      destination_transfer.m_key_image_known = true;
+      destination_transfer.m_key_image_request = false;
+      destination_transfer.m_key_image_partial = false;
+      destination.m_key_images[pending.second] = pending.first;
+      destination.m_pub_keys[destination_transfer.get_public_key()] = pending.first;
+    }
+
+    // The key images came directly from authenticated hardware operations and
+    // were each bound above to the locally discovered output public key.
+    // Existing complete entries in the contiguous tail are reused without a
+    // second Ledger derivation; only pending owned outputs touch the device.
+    const auto update_started_at = std::chrono::steady_clock::now();
+    const uint64_t import_height = destination.import_key_images(
+        derived_key_images,
+        import_offset,
+        spent,
+        unspent,
+        true,
+        &stats.spent_status_rpc_duration_ms,
+        &stats.outgoing_rpc_duration_ms);
+    const uint64_t update_total_ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::steady_clock::now() - update_started_at).count();
+    const uint64_t rpc_total_ms =
+        stats.spent_status_rpc_duration_ms + stats.outgoing_rpc_duration_ms;
+    stats.state_update_duration_ms =
+        update_total_ms > rpc_total_ms ? update_total_ms - rpc_total_ms : 0;
+
+    const time_t completed_at = time(NULL);
+    destination.m_device_last_key_image_sync = completed_at;
+    const auto store_started_at = std::chrono::steady_clock::now();
+    destination.store();
+    stats.store_duration_ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::steady_clock::now() - store_started_at).count();
+
+    m_device_last_key_image_sync = completed_at;
+    destination.m_callback = destination_callback;
+    return import_height;
+  }
+  catch (...)
+  {
+    const std::exception_ptr failure = std::current_exception();
+    const bool restored = ::serialization::parse_binary(
+        destination_snapshot,
+        destination);
+    destination.m_callback = destination_callback;
+    CHECK_AND_ASSERT_THROW_MES(
+        restored,
+        "Ledger reconciliation failed and the staged view-wallet state could not be restored");
+    std::rethrow_exception(failure);
+  }
 }
