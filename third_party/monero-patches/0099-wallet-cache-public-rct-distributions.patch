diff --git a/src/wallet/rct_distribution_cache.h b/src/wallet/rct_distribution_cache.h
new file mode 100644
index 000000000..3ae54dcf1
--- /dev/null
+++ b/src/wallet/rct_distribution_cache.h
@@ -0,0 +1,277 @@
+// Copyright (c) 2026, TEX8 contributors. BSD-3-Clause, as the surrounding Core.
+#pragma once
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <stdexcept>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace tools { namespace rct_cache {
+constexpr uint64_t max_entries = 10000000;
+constexpr uint64_t max_outputs = UINT64_MAX / 4;
+constexpr size_t max_disk_bytes = 320 + size_t(max_entries) * 8;
+constexpr size_t max_wire_bytes = 32 * 1024 * 1024;
+constexpr size_t max_decoded_bytes = 96 * 1024 * 1024;
+
+struct cancellation {
+  std::atomic<bool> stopped{false};
+  const std::chrono::steady_clock::time_point deadline;
+  explicit cancellation(std::chrono::milliseconds budget): deadline(std::chrono::steady_clock::now() + budget) {}
+  void check() const {
+    if (stopped.load() || std::chrono::steady_clock::now() >= deadline)
+      throw std::runtime_error("public distribution work cancelled or expired");
+  }
+};
+struct payment_required : std::runtime_error { payment_required(): std::runtime_error("public RPC requires payment") {} };
+struct distribution {
+  uint64_t start = 0, base = 0;
+  std::vector<uint64_t> cumulative;
+};
+struct snapshot {
+  std::string profile, genesis, end_hash;
+  uint64_t start = 0, end = 0, base = 0;
+  std::vector<uint64_t> cumulative;
+};
+inline bool hash_shape(const std::string& hash) {
+  return hash.size() == 64 && std::all_of(hash.begin(), hash.end(), [](char c) {
+    return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f');
+  });
+}
+inline void validate(const snapshot& value) {
+  if (!hash_shape(value.profile) || !hash_shape(value.genesis) || !hash_shape(value.end_hash)
+      || value.start > value.end || value.end >= max_entries || value.base > max_outputs
+      || value.cumulative.empty() || value.cumulative.size() > max_entries
+      || value.cumulative.size() != value.end - value.start + 1
+      || value.cumulative.front() < value.base || value.cumulative.back() > max_outputs
+      || !std::is_sorted(value.cumulative.begin(), value.cumulative.end()))
+    throw std::runtime_error("invalid public distribution snapshot");
+}
+using digest_fn = std::function<std::string(const std::string&)>;
+inline void put_u64(std::string& bytes, uint64_t value) {
+  for (unsigned shift = 0; shift < 64; shift += 8) bytes.push_back(char(value >> shift));
+}
+inline uint64_t take_u64(const std::string& bytes, size_t& offset) {
+  if (offset > bytes.size() || bytes.size() - offset < 8) throw std::runtime_error("truncated cache");
+  uint64_t value = 0;
+  for (unsigned shift = 0; shift < 64; shift += 8) value |= uint64_t(uint8_t(bytes[offset++])) << shift;
+  return value;
+}
+inline std::string encode(const snapshot& value, const digest_fn& digest) {
+  validate(value);
+  std::string bytes("MFWRCT02", 8);
+  bytes += value.profile; bytes += value.genesis;
+  put_u64(bytes, value.start); put_u64(bytes, value.end); put_u64(bytes, value.base);
+  bytes += value.end_hash; put_u64(bytes, value.cumulative.size());
+  for (uint64_t count : value.cumulative) put_u64(bytes, count);
+  const std::string checksum = digest(bytes);
+  if (!hash_shape(checksum)) throw std::runtime_error("invalid cache checksum implementation");
+  bytes += checksum;
+  return bytes;
+}
+inline snapshot decode(const std::string& bytes, const std::string& profile,
+                       const std::string& genesis, const digest_fn& digest) {
+  if (bytes.size() < 296 || bytes.size() > max_disk_bytes || bytes.compare(0, 8, "MFWRCT02") != 0
+      || bytes.substr(bytes.size() - 64) != digest(bytes.substr(0, bytes.size() - 64)))
+    throw std::runtime_error("invalid cache schema, size or checksum");
+  snapshot value;
+  value.profile = bytes.substr(8, 64); value.genesis = bytes.substr(72, 64);
+  if (value.profile != profile || value.genesis != genesis) throw std::runtime_error("cache profile mismatch");
+  size_t offset = 136;
+  value.start = take_u64(bytes, offset); value.end = take_u64(bytes, offset); value.base = take_u64(bytes, offset);
+  value.end_hash = bytes.substr(offset, 64); offset += 64;
+  const uint64_t count = take_u64(bytes, offset);
+  if (count == 0 || count > max_entries || count > (bytes.size() - offset) / 8
+      || bytes.size() - offset != count * 8 + 64) throw std::runtime_error("invalid cache count");
+  value.cumulative.reserve(size_t(count));
+  for (uint64_t i = 0; i < count; ++i) value.cumulative.push_back(take_u64(bytes, offset));
+  validate(value);
+  return value;
+}
+
+class source {
+public:
+  virtual ~source() = default;
+  virtual uint64_t height() = 0; // block count, not top block index
+  virtual std::string hash(uint64_t height) = 0;
+  virtual distribution fetch(uint64_t from, uint64_t to) = 0; // both bounds inclusive
+};
+class staged_file {
+public:
+  virtual ~staged_file() = default;
+  virtual bool commit() = 0; // atomic rename only; preparation precedes publication lock
+};
+struct disk_store {
+  std::function<std::string()> load;
+  std::function<std::unique_ptr<staged_file>(const std::string&)> stage;
+};
+using source_factory = std::function<std::unique_ptr<source>(std::shared_ptr<cancellation>)>;
+
+// A job owns its transport and immutable configuration. In particular, it
+// never captures a wallet, HTTP factory owned by a wallet, or wallet mutex.
+class service : public std::enable_shared_from_this<service> {
+public:
+  service(std::string profile, std::string genesis, source_factory factory,
+          digest_fn digest, disk_store disk,
+          std::chrono::milliseconds budget = std::chrono::seconds(180))
+    : profile_(std::move(profile)), genesis_(std::move(genesis)), factory_(std::move(factory)),
+      digest_(std::move(digest)), disk_(std::move(disk)), budget_(budget) {}
+  bool prefetch() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (payment_required_) return false;
+    const auto now = std::chrono::steady_clock::now();
+    const auto delay = last_success_ ? std::chrono::seconds(15) : std::chrono::seconds(5);
+    if ((!job_ || job_->done) && now - last_attempt_ < delay) return true;
+    return start_locked();
+  }
+  bool get(uint64_t& start, std::vector<uint64_t>& cumulative) {
+    std::unique_lock<std::mutex> lock(mutex_);
+    if (payment_required_ || !start_locked()) return false;
+    const auto own_job = job_;
+    const auto deadline = own_job->token->deadline + std::chrono::seconds(6);
+    if (!condition_.wait_until(lock, deadline, [&] { return own_job->done; })) {
+      own_job->token->stopped = true; own_job->done = true; own_job->success = false;
+      if (job_ == own_job) ++generation_;
+      condition_.notify_all(); return false;
+    }
+    if (!own_job->success || own_job->token->stopped || !own_job->result) return false;
+    start = own_job->result->start;
+    cumulative = own_job->result->cumulative;
+    return true;
+  }
+  bool requires_payment() { std::lock_guard<std::mutex> lock(mutex_); return payment_required_; }
+  void cancel() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (job_ && !job_->done) {
+      job_->token->stopped = true; job_->done = true; job_->success = false;
+    }
+    ++generation_; last_success_ = false; last_attempt_ = {};
+    condition_.notify_all();
+  }
+private:
+  struct job {
+    std::shared_ptr<cancellation> token;
+    std::shared_ptr<const snapshot> result;
+    uint64_t generation;
+    bool done = false, success = false;
+  };
+  bool start_locked() {
+    if (job_ && !job_->done) return true;
+    last_attempt_ = std::chrono::steady_clock::now();
+    auto next = std::make_shared<job>();
+    next->token = std::make_shared<cancellation>(budget_);
+    next->generation = ++generation_;
+    job_ = next;
+    auto self = shared_from_this();
+    try { std::thread([self, next] { self->run(next); }).detach(); }
+    catch (...) { next->done = true; condition_.notify_all(); return false; }
+    return true;
+  }
+  std::shared_ptr<const snapshot> refresh(source& rpc, const std::shared_ptr<cancellation>& token, bool& changed) {
+    token->check();
+    if (rpc.hash(0) != genesis_) throw std::runtime_error("public distribution network mismatch");
+    token->check();
+    const uint64_t height = rpc.height();
+    if (height == 0 || height > max_entries) throw std::runtime_error("invalid daemon height");
+    const uint64_t end = height - 1;
+    std::shared_ptr<const snapshot> previous;
+    { std::lock_guard<std::mutex> lock(mutex_); previous = value_; }
+    if (!previous && disk_.load) {
+      try { previous = std::make_shared<snapshot>(decode(disk_.load(), profile_, genesis_, digest_)); }
+      catch (...) {} // A bad disk entry can never become a usable cache hit.
+    }
+    token->check();
+    const std::string end_hash = rpc.hash(end);
+    if (!hash_shape(end_hash)) throw std::runtime_error("invalid daemon block hash");
+    bool retain = previous && previous->end <= end && rpc.hash(previous->end) == previous->end_hash;
+    if (retain && previous->end == end) {
+      token->check();
+      changed = false;
+      return previous;
+    }
+    // Matching the retained prefix's LAST hash binds the whole prefix. If it
+    // changes (including equal-height/deep reorgs), refetch the full public
+    // distribution. A fixed overlap by itself cannot establish this property.
+    const uint64_t from = retain ? previous->end + 1 : 0;
+    token->check();
+    distribution response = rpc.fetch(from, end);
+    token->check();
+    if (response.start > end || response.cumulative.empty() || response.cumulative.size() > max_entries
+        || response.cumulative.size() != end - response.start + 1
+        || (retain && response.start != from) || (!retain && response.base != 0)
+        || response.base > max_outputs || response.cumulative.front() < response.base
+        || response.cumulative.back() > max_outputs
+        || !std::is_sorted(response.cumulative.begin(), response.cumulative.end())
+        || (retain && response.base != previous->cumulative.back()))
+      throw std::runtime_error("invalid cumulative distribution response");
+    // to_height is fixed to the observed tip. Check its hash after the body,
+    // as well as the retained prefix anchor, before publishing any bytes.
+    if (rpc.height() <= end || rpc.hash(end) != end_hash
+        || (retain && rpc.hash(previous->end) != previous->end_hash))
+      throw std::runtime_error("public distribution chain changed");
+    token->check();
+    auto result = std::make_shared<snapshot>();
+    result->profile = profile_; result->genesis = genesis_; result->end_hash = end_hash; result->end = end;
+    if (retain) {
+      result->start = previous->start; result->base = previous->base;
+      result->cumulative = previous->cumulative;
+      result->cumulative.insert(result->cumulative.end(), response.cumulative.begin(), response.cumulative.end());
+    } else {
+      result->start = response.start; result->base = response.base;
+      result->cumulative = std::move(response.cumulative);
+    }
+    validate(*result);
+    return result;
+  }
+  void run(const std::shared_ptr<job>& work) {
+    try {
+      const auto& token = work->token;
+      token->check();
+      auto rpc = factory_(token);
+      bool changed = true;
+      auto next = refresh(*rpc, token, changed);
+      token->check();
+      std::unique_ptr<staged_file> staged;
+      if (changed && disk_.stage) { try { staged = disk_.stage(encode(*next, digest_)); } catch (...) {} }
+      std::lock_guard<std::mutex> lock(mutex_);
+      token->check();
+      if (generation_ != work->generation || work->done) return;
+      // Result ownership is per job: a later refresh cannot turn a successful
+      // waiter's result into a false error before that waiter wakes up.
+      if (staged) staged->commit();
+      value_ = next; work->result = std::move(next);
+      work->success = true; work->done = true; last_success_ = true;
+      condition_.notify_all();
+    } catch (const payment_required&) {
+      std::lock_guard<std::mutex> lock(mutex_);
+      work->done = true; work->success = false;
+      if (job_ == work && work->generation == generation_ && !work->token->stopped) { payment_required_ = true; last_success_ = false; }
+      condition_.notify_all();
+    } catch (...) {
+      std::lock_guard<std::mutex> lock(mutex_);
+      work->done = true; work->success = false;
+      if (job_ == work) last_success_ = false;
+      condition_.notify_all();
+    }
+  }
+  const std::string profile_, genesis_;
+  const source_factory factory_;
+  const digest_fn digest_;
+  const disk_store disk_;
+  const std::chrono::milliseconds budget_;
+  std::mutex mutex_;
+  std::condition_variable condition_;
+  std::shared_ptr<job> job_;
+  std::shared_ptr<const snapshot> value_;
+  std::chrono::steady_clock::time_point last_attempt_{};
+  uint64_t generation_ = 0;
+  bool last_success_ = false, payment_required_ = false;
+};
+} }
