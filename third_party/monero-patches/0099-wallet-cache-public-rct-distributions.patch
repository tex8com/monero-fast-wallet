--- /dev/null
+++ b/src/wallet/rct_distribution_wire.h
@@ -0,0 +1,109 @@
+// Copyright (c) 2026, TEX8 contributors. BSD-3-Clause, as the surrounding Core.
+#pragma once
+#include "rct_distribution_cache.h"
+#include <cstring>
+
+namespace tools { namespace rct_cache {
+// Bounded EPEE reader for the public distribution response. In particular,
+// no untrusted array count is handed to an allocating generic deserializer.
+class wire_reader {
+public:
+  wire_reader(const std::string& bytes): bytes_(bytes) {}
+  uint64_t pod(size_t width) {
+    if (width > 8 || offset_ > bytes_.size() || bytes_.size() - offset_ < width) fail();
+    uint64_t result = 0;
+    for (size_t i = 0; i < width; ++i) result |= uint64_t(uint8_t(bytes_[offset_++])) << (8 * i);
+    return result;
+  }
+  uint64_t count(uint64_t maximum) {
+    if (offset_ >= bytes_.size()) fail();
+    const size_t width = size_t(1) << (uint8_t(bytes_[offset_]) & 3);
+    const uint64_t value = pod(width) >> 2;
+    if (value > maximum) fail();
+    return value;
+  }
+  std::string text(size_t size) {
+    if (offset_ > bytes_.size() || size > bytes_.size() - offset_) fail();
+    std::string result = bytes_.substr(offset_, size); offset_ += size; return result;
+  }
+  distribution read(uint64_t end, bool cumulative) {
+    if (bytes_.size() > max_decoded_bytes || pod(4) != 0x01011101 || pod(4) != 0x01020101 || pod(1) != 1) fail();
+    const auto fields = count(16);
+    bool ok = false, found = false, status_seen = false;
+    distribution result;
+    std::string status;
+    for (uint64_t i = 0; i < fields; ++i) {
+      const auto name = text(size_t(pod(1))); const auto type = pod(1);
+      if (name == "status") { if (status_seen || type != 10) fail(); status_seen = true; status = text(size_t(count(64))); ok = status == "OK"; }
+      else if (name == "distributions") {
+        if (found || type != (0x80 | 12) || count(1) != 1) fail();
+        found = true; result = item(end, cumulative);
+      } else skip(type);
+    }
+    if (offset_ != bytes_.size()) fail();
+    if (status == "PAYMENT_REQUIRED") throw payment_required();
+    if (!ok || !found) fail();
+    return result;
+  }
+private:
+  distribution item(uint64_t end, bool cumulative) {
+    distribution result;
+    const auto fields = count(12);
+    bool binary = false, compressed = false;
+    uint64_t amount = UINT64_MAX;
+    std::string data;
+    unsigned seen = 0;
+    for (uint64_t i = 0; i < fields; ++i) {
+      const auto name = text(size_t(pod(1))); const auto type = pod(1);
+      unsigned bit = 0;
+      if (name == "start_height") { bit = 1; if (type != 5) fail(); result.start = pod(8); }
+      else if (name == "base") { bit = 2; if (type != 5) fail(); result.base = pod(8); }
+      else if (name == "amount") { bit = 4; if (type != 5) fail(); amount = pod(8); }
+      else if (name == "binary") { bit = 8; if (type != 11) fail(); binary = pod(1) == 1; }
+      else if (name == "compress") { bit = 16; if (type != 11) fail(); compressed = pod(1) == 1; }
+      else if (name == "compressed_data") {
+        bit = 32; if (type != 10 && type != (0x80 | 8)) fail();
+        data = text(size_t(count(max_decoded_bytes)));
+      } else skip(type);
+      if (seen & bit) fail();
+      seen |= bit;
+    }
+    if (seen != 63 || amount != 0 || !binary || !compressed || result.start > end || end >= max_entries
+        || result.base > max_outputs) fail();
+    const uint64_t expected = end - result.start + 1;
+    result.cumulative.reserve(size_t(expected));
+    uint64_t total = result.base;
+    size_t cursor = 0;
+    while (cursor < data.size()) {
+      uint64_t value = 0; unsigned shift = 0; uint8_t byte;
+      do {
+        if (cursor >= data.size() || shift > 63) fail();
+        byte = uint8_t(data[cursor++]);
+        if (shift == 63 && byte > 1) fail();
+        value |= uint64_t(byte & 127) << shift; shift += 7;
+      } while (byte & 128);
+      if ((byte == 0 && shift > 7) || result.cumulative.size() >= expected) fail();
+      if (!cumulative) {
+        if (value > max_outputs - total) fail();
+        total += value; value = total;
+      }
+      if (value > max_outputs) fail();
+      result.cumulative.push_back(value);
+    }
+    if (result.cumulative.size() != expected) fail();
+    return result;
+  }
+  void skip(uint64_t type) {
+    switch (type) {
+      case 5: pod(8); break;
+      case 6: pod(4); break;
+      case 7: pod(2); break;
+      case 8: case 11: pod(1); break;
+      case 10: text(size_t(count(256))); break;
+      default: fail();
+    }
+  }
+  [[noreturn]] static void fail() { throw std::runtime_error("invalid bounded distribution wire response"); }
+  const std::string& bytes_; size_t offset_ = 0;
+};
+} }
