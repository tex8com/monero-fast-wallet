@@ -0,0 +1,303 @@
+// Copyright (c) 2026, TEX8 contributors. BSD-3-Clause, as the surrounding Core.
+#include "rct_distribution_rpc.h"
+#include "rct_distribution_wire.h"
+#include "net/http.h"
+#include "net/net_parse_helpers.h"
+#include "rpc/core_rpc_server_commands_defs.h"
+#include "storages/http_abstract_invoke.h"
+#include "crypto/hash.h"
+#include "string_tools.h"
+#include "common/util.h"
+#include "memwipe.h"
+#include <boost/filesystem.hpp>
+#include <fstream>
+#include <map>
+#include <zlib.h>
+#ifdef _WIN32
+#include <io.h>
+#include <fcntl.h>
+#include <sys/stat.h>
+#else
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#endif
+
+namespace tools { namespace rct_cache {
+namespace {
+std::mutex registry_mutex;
+std::string root_directory;
+std::map<std::string, std::weak_ptr<service>> registry;
+std::map<std::string, std::weak_ptr<service>> active_disk_profile;
+std::string digest(const std::string& bytes) {
+  return epee::string_tools::pod_to_hex(crypto::cn_fast_hash(bytes.data(), bytes.size()));
+}
+void identity_field(std::string& value, const std::string& field) {
+  put_u64(value, field.size()); value += field;
+}
+std::string profile_id(const profile& config, bool include_proxy) {
+  epee::net_utils::http::url_content url{};
+  if (!epee::net_utils::parse_url(config.address, url)) throw std::runtime_error("invalid distribution daemon profile");
+  std::string host = url.host;
+  std::transform(host.begin(), host.end(), host.begin(), [](unsigned char c) { return char(std::tolower(c)); });
+  std::string material("MFWRCT-profile-2");
+  put_u64(material, config.network);
+  identity_field(material, config.genesis); identity_field(material, host);
+  const uint64_t port = url.port ? url.port : (url.schema == "https" ? 443 : 80);
+  put_u64(material, port);
+  std::string schema = url.schema.empty() ? "http" : url.schema;
+  std::transform(schema.begin(), schema.end(), schema.begin(), [](unsigned char c) { return char(std::tolower(c)); });
+  identity_field(material, schema);
+  // The active flight is exact-proxy bound. Public disk data can survive an
+  // embedded Tor loopback-port change; every reuse validates hashes through
+  // the CURRENT route before these bytes can reach decoy selection.
+  if (include_proxy) identity_field(material, config.proxy);
+  put_u64(material, uint64_t(config.ssl.support)); put_u64(material, uint64_t(config.ssl.verification));
+  identity_field(material, config.ssl.ca_path);
+  identity_field(material, config.ssl.auth.certificate_path);
+  identity_field(material, config.ssl.auth.private_key_path);
+  for (const auto& fingerprint : config.ssl.cache_fingerprints())
+    identity_field(material, std::string(fingerprint.begin(), fingerprint.end()));
+  put_u64(material, bool(config.login));
+  if (config.login) {
+    identity_field(material, config.login->username);
+    // Do not turn the public disk filename into an offline password oracle.
+    // Exact credentials partition active jobs only; disk reuse must first
+    // authenticate fresh hash queries with the CURRENT credentials.
+    if (include_proxy) {
+      put_u64(material, config.login->password.size());
+      material.append(config.login->password.data(), config.login->password.size());
+    }
+  }
+  const std::string result = digest(material);
+  if (!material.empty()) memwipe(&material[0], material.size());
+  return result;
+}
+
+// No cross-thread disconnect(): upstream's disconnect takes the same lock as
+// invoke and cannot interrupt it. The worker instead owns the whole client,
+// checks cancellation for every body piece and bounds each blocking read.
+class bounded_client : public net::http::client {
+public:
+  explicit bounded_client(std::shared_ptr<cancellation> token): token_(std::move(token)) {}
+  void begin(size_t limit) { token_->check(); received_ = 0; raw_received_ = 0; header_.clear(); header_done_ = false; aborted_ = false; limit_ = limit; }
+  bool on_response_chunk(const std::string& piece) override {
+    if (!alive() || piece.size() > limit_ + 65536 - raw_received_) { aborted_ = true; return false; }
+    raw_received_ += piece.size();
+    if (!header_done_) {
+      header_.append(piece, 0, std::min<size_t>(piece.size(), 65536 - header_.size()));
+      header_done_ = header_.find("\r\n\r\n") != std::string::npos;
+      if (!header_done_ && header_.size() == 65536) { aborted_ = true; return false; }
+    }
+    return true;
+  }
+  bool handle_target_data(std::string& piece) override {
+    if (!alive() || piece.size() > limit_ - received_) { aborted_ = true; return false; }
+    received_ += piece.size();
+    return net::http::client::handle_target_data(piece);
+  }
+  bool on_header(const epee::net_utils::http::http_response_info&) override { if (!alive()) aborted_ = true; return !aborted_; }
+  bool aborted() const { return aborted_; }
+private:
+  bool alive() const { try { token_->check(); return true; } catch (...) { return false; } }
+  std::shared_ptr<cancellation> token_;
+  std::string header_;
+  bool header_done_ = false, aborted_ = false;
+  size_t received_ = 0, raw_received_ = 0, limit_ = max_wire_bytes;
+};
+std::string bounded_inflate(const std::string& bytes, const std::shared_ptr<cancellation>& token) {
+  z_stream stream{};
+  if (inflateInit2(&stream, 15 + 16) != Z_OK) throw std::runtime_error("distribution gzip initialization failed");
+  struct cleanup { z_stream& value; ~cleanup() { inflateEnd(&value); } } guard{stream};
+  stream.next_in = reinterpret_cast<Bytef*>(const_cast<char*>(bytes.data()));
+  stream.avail_in = uInt(bytes.size());
+  std::string result;
+  char chunk[32768];
+  int status;
+  do {
+    token->check();
+    stream.next_out = reinterpret_cast<Bytef*>(chunk); stream.avail_out = sizeof(chunk);
+    status = inflate(&stream, Z_NO_FLUSH);
+    const size_t produced = sizeof(chunk) - stream.avail_out;
+    if (produced > max_decoded_bytes - result.size()) throw std::runtime_error("distribution gzip limit exceeded");
+    result.append(chunk, produced);
+    if (status != Z_OK && status != Z_STREAM_END) throw std::runtime_error("invalid distribution gzip body");
+  } while (status != Z_STREAM_END);
+  if (stream.avail_in != 0) throw std::runtime_error("trailing distribution gzip data");
+  return result;
+}
+class rpc_source : public source {
+public:
+  rpc_source(profile config, std::shared_ptr<cancellation> token): token_(std::move(token)), client_(token_) {
+    if (!client_.set_proxy(config.proxy) || !client_.set_server(config.address, config.login, config.ssl))
+      throw std::runtime_error("distribution transport configuration failed");
+    // SOCKS/Onion setup has a separate bounded allowance; body reads stay
+    // short so cancellation can stop slow/trickled responses promptly.
+    if (!client_.connect(std::chrono::seconds(30))) throw std::runtime_error("distribution transport connection failed");
+    token_->check();
+  }
+  uint64_t height() override {
+    cryptonote::COMMAND_RPC_GET_INFO::request request{};
+    cryptonote::COMMAND_RPC_GET_INFO::response response{};
+    json("get_info", request, response);
+    if (response.height == 0 || response.height > max_entries) throw std::runtime_error("distribution tip outside limits");
+    return response.height;
+  }
+  std::string hash(uint64_t height) override {
+    cryptonote::COMMAND_RPC_GET_BLOCK_HEADER_BY_HEIGHT::request request{};
+    cryptonote::COMMAND_RPC_GET_BLOCK_HEADER_BY_HEIGHT::response response{};
+    request.height = height; request.fill_pow_hash = false;
+    json("get_block_header_by_height", request, response);
+    if (response.block_header.height != height || response.block_header.orphan_status
+        || !hash_shape(response.block_header.hash)) throw std::runtime_error("invalid distribution block anchor");
+    return response.block_header.hash;
+  }
+  distribution fetch(uint64_t from, uint64_t to) override {
+    token_->check();
+    cryptonote::COMMAND_RPC_GET_OUTPUT_DISTRIBUTION::request request{};
+    request.amounts = {0}; request.from_height = from; request.to_height = to;
+    request.binary = true; request.compress = true; request.cumulative = from != 0;
+    // The cold full response uses compact per-block counts just like upstream;
+    // incremental tails use absolute cumulative values, never base+value.
+    epee::byte_slice body;
+    if (!epee::serialization::store_t_to_binary(request, body, 1024)) throw std::runtime_error("distribution request encoding failed");
+    client_.begin(max_wire_bytes);
+    const epee::net_utils::http::http_response_info* response = nullptr;
+    if (!client_.invoke("/get_output_distribution.bin", "POST",
+        boost::string_ref(reinterpret_cast<const char*>(body.data()), body.size()), std::chrono::seconds(5), &response)
+        || client_.aborted() || !response || response->m_response_code != 200 || response->m_body.size() > max_wire_bytes)
+      throw std::runtime_error("public distribution request failed");
+    token_->check();
+    std::string bytes = response->m_header_info.m_content_encoding.find("gzip") != std::string::npos
+      ? bounded_inflate(response->m_body, token_) : response->m_body;
+    token_->check();
+    return wire_reader(bytes).read(to, request.cumulative);
+  }
+private:
+  template<class Request, class Response> void json(const char* method, Request& request, Response& response) {
+    token_->check(); client_.begin(256 * 1024);
+    const bool received = epee::net_utils::invoke_http_json_rpc("/json_rpc", method, request, response, client_, std::chrono::seconds(5));
+    if (received && !client_.aborted() && response.status == CORE_RPC_STATUS_PAYMENT_REQUIRED) throw payment_required();
+    if (!received || client_.aborted() || response.status != CORE_RPC_STATUS_OK) throw std::runtime_error("distribution anchor RPC failed");
+    token_->check();
+  }
+  std::shared_ptr<cancellation> token_;
+  bounded_client client_;
+};
+
+class atomic_file : public staged_file {
+public:
+  atomic_file(boost::filesystem::path target, const std::string& bytes): target_(std::move(target)) {
+    temporary_ = target_.parent_path() / boost::filesystem::unique_path(".rct-%%%%-%%%%-%%%%-%%%%.tmp");
+#ifdef _WIN32
+    const int fd = _wopen(temporary_.wstring().c_str(), _O_CREAT | _O_EXCL | _O_WRONLY | _O_BINARY, _S_IREAD | _S_IWRITE);
+#else
+    const int fd = ::open(temporary_.string().c_str(), O_CREAT | O_EXCL | O_WRONLY | O_NOFOLLOW, 0600);
+#endif
+    if (fd < 0) throw std::runtime_error("public cache staging unavailable");
+    bool ok = true;
+    size_t offset = 0;
+    while (offset < bytes.size()) {
+#ifdef _WIN32
+      const int written = _write(fd, bytes.data() + offset, unsigned(std::min<size_t>(bytes.size() - offset, 1024 * 1024)));
+#else
+      const auto written = ::write(fd, bytes.data() + offset, bytes.size() - offset);
+#endif
+      if (written < 0 && errno == EINTR) continue;
+      if (written <= 0) { ok = false; break; }
+      offset += size_t(written);
+    }
+#ifdef _WIN32
+    if (_commit(fd) != 0) ok = false;
+    _close(fd);
+#else
+    if (::fsync(fd) != 0) ok = false;
+    ::close(fd);
+#endif
+    if (!ok) { boost::system::error_code ignored; boost::filesystem::remove(temporary_, ignored); throw std::runtime_error("public cache staging failed"); }
+  }
+  ~atomic_file() override { boost::system::error_code ignored; boost::filesystem::remove(temporary_, ignored); }
+  bool commit() override { return !tools::replace_file(temporary_.string(), target_.string()); }
+private:
+  boost::filesystem::path target_, temporary_;
+};
+disk_store disk(const std::string& directory, const std::string& key) {
+  if (directory.empty()) return {};
+  const boost::filesystem::path root(directory);
+  boost::filesystem::create_directories(root);
+  if (boost::filesystem::is_symlink(boost::filesystem::symlink_status(root)) || !boost::filesystem::is_directory(root))
+    throw std::runtime_error("invalid public cache directory");
+  boost::filesystem::permissions(root, boost::filesystem::owner_all);
+  const auto path = root / (key + ".rct");
+  disk_store result;
+  result.load = [path] {
+#ifdef _WIN32
+    const int fd = _wopen(path.wstring().c_str(), _O_RDONLY | _O_BINARY);
+    struct _stat64 info{};
+    const bool valid = fd >= 0 && _fstat64(fd, &info) == 0 && (info.st_mode & _S_IFMT) == _S_IFREG;
+#else
+    const int fd = ::open(path.string().c_str(), O_RDONLY | O_NOFOLLOW);
+    struct stat info{};
+    const bool valid = fd >= 0 && ::fstat(fd, &info) == 0 && S_ISREG(info.st_mode);
+#endif
+    struct close_file { int fd; ~close_file() { if (fd >= 0) {
+#ifdef _WIN32
+      _close(fd);
+#else
+      ::close(fd);
+#endif
+    } } } guard{fd};
+    if (!valid || info.st_size < 0 || uint64_t(info.st_size) > max_disk_bytes)
+      throw std::runtime_error("public cache file outside limits");
+    std::string bytes(size_t(info.st_size), '\0');
+    size_t offset = 0;
+    while (offset < bytes.size()) {
+#ifdef _WIN32
+      const int got = _read(fd, &bytes[offset], unsigned(std::min<size_t>(bytes.size() - offset, 1024 * 1024)));
+#else
+      const auto got = ::read(fd, &bytes[offset], bytes.size() - offset);
+#endif
+      if (got < 0 && errno == EINTR) continue;
+      if (got <= 0) throw std::runtime_error("truncated public cache file");
+      offset += size_t(got);
+    }
+    return bytes;
+  };
+  result.stage = [path](const std::string& bytes) -> std::unique_ptr<staged_file> {
+    if (bytes.size() > max_disk_bytes) throw std::runtime_error("public cache file outside limits");
+    return std::unique_ptr<staged_file>(new atomic_file(path, bytes));
+  };
+  return result;
+}
+}
+void set_directory(const std::string& directory) {
+  std::lock_guard<std::mutex> lock(registry_mutex);
+  root_directory = directory;
+}
+std::shared_ptr<service> acquire(const profile& config) {
+  const std::string key = profile_id(config, true);
+  const std::string disk_key = profile_id(config, false);
+  std::lock_guard<std::mutex> lock(registry_mutex);
+  const std::string registry_key = root_directory + "/" + key;
+  if (root_directory.empty()) return {};
+  auto existing = registry[registry_key].lock();
+  const std::string disk_registry_key = root_directory + "/" + disk_key;
+  auto previous_route = active_disk_profile[disk_registry_key].lock();
+  if (previous_route && previous_route != existing) previous_route->cancel();
+  if (existing) { active_disk_profile[disk_registry_key] = existing; return existing; }
+  // Copy only public network settings and transport credentials into the
+  // factory. No wallet, wallet-owned factory, view/spend key or mutex escapes.
+  auto factory = [config](std::shared_ptr<cancellation> token) -> std::unique_ptr<source> {
+    return std::unique_ptr<source>(new rpc_source(config, std::move(token)));
+  };
+  disk_store store;
+  try { store = disk(root_directory, disk_key); } catch (...) {}
+  auto created = std::make_shared<service>(disk_key, config.genesis, std::move(factory), digest, std::move(store));
+  active_disk_profile[disk_registry_key] = created;
+  registry[registry_key] = created;
+  for (auto it = registry.begin(); it != registry.end();) {
+    if (it->second.expired()) it = registry.erase(it); else ++it;
+  }
+  return created;
+}
+} }
