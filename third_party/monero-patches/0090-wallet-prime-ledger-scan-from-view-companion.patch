+bool WalletImpl::prepareHardwareWalletScanFromViewOnly(
+    const Wallet &viewOnlyWallet)
+{
+    clearStatus();
+#ifdef WITH_DEVICE_LEDGER
+    if (m_wallet->get_device_type() != hw::device::LEDGER) {
+        setStatusError(tr("Hardware scan preparation requires a Ledger wallet"));
+        return false;
+    }
+
+    const auto *view_only = dynamic_cast<const WalletImpl*>(&viewOnlyWallet);
+    if (view_only == nullptr || !view_only->watchOnly() ||
+        view_only->m_wallet->get_device_type() != hw::device::SOFTWARE) {
+        setStatusError(tr("Hardware scan source must be a local view-only wallet"));
+        return false;
+    }
+    if (m_wallet->nettype() != view_only->m_wallet->nettype()) {
+        setStatusError(tr("Ledger and view-only wallets use different networks"));
+        return false;
+    }
+    const auto &hardware_address =
+        m_wallet->get_account().get_keys().m_account_address;
+    const auto &view_only_keys = view_only->m_wallet->get_account().get_keys();
+    if (hardware_address.m_view_public_key !=
+            view_only_keys.m_account_address.m_view_public_key ||
+        hardware_address.m_spend_public_key !=
+            view_only_keys.m_account_address.m_spend_public_key) {
+        setStatusError(tr("View-only wallet does not match this Ledger wallet"));
+        return false;
+    }
+
+    crypto::secret_key private_view_key = view_only_keys.m_view_secret_key;
+    const auto wipe_private_view_key =
+        epee::misc_utils::create_scope_leave_handler([&]() {
+            memwipe(private_view_key.data, sizeof(private_view_key.data));
+        });
+    try {
+        crypto::public_key derived_public_view_key;
+        if (!crypto::secret_key_to_public_key(
+                private_view_key, derived_public_view_key) ||
+            derived_public_view_key !=
+                m_wallet->get_account().get_keys().m_account_address.m_view_public_key) {
+            setStatusError(tr("Protected private view key does not match this Ledger wallet"));
+            return false;
+        }
+
+        auto& device = static_cast<hw::ledger::device_ledger&>(
+            m_wallet->get_account().get_device());
+        cryptonote::account_public_address connected_address;
+        if (!device.get_public_address(connected_address) ||
+            connected_address.m_view_public_key !=
+                hardware_address.m_view_public_key ||
+            connected_address.m_spend_public_key !=
+                hardware_address.m_spend_public_key) {
+            setStatusError(tr("Connected Ledger does not match this wallet"));
+            return false;
+        }
+        const bool installed = device.prime_view_key_for_scan(private_view_key);
+        if (!installed) {
+            setStatusError(tr("Protected Ledger private view key could not be installed"));
+            return false;
+        }
+        return true;
+    } catch (const std::exception &e) {
+        setStatusError(e.what());
+        return false;
+    }
+#else
+    (void)viewOnlyWallet;
+    setStatusError(tr("Ledger support is unavailable in this build"));
+    return false;
+#endif
+}
+
