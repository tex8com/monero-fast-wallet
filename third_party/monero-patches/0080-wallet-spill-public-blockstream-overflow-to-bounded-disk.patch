 // decide "stream live right now".
 std::atomic<int64_t>& last_successful_chunk_unix_ms();
 
+// Process-wide counters for the public BlockStream transport. They contain
+// only public blockchain payload accounting; no wallet identifier, key,
+// address, ownership result, or transaction metadata crosses this boundary.
+// The bridge samples these monotonically increasing counters so a downloader
+// that is legitimately running ahead into the disk spool remains observable
+// while the wallet scanner consumes older batches.
+std::atomic<uint64_t>& transport_payload_bytes_received();
+
+uint64_t spool_bytes_buffered();
+uint64_t spool_peak_bytes();
+uint64_t spool_write_count();
+uint64_t spool_read_count();
+uint64_t spool_backpressure_count();
+bool spool_enabled();
+
 } // namespace cuprate_grpc_stream
+
+extern "C" {
+uint64_t monero_grpc_transport_payload_bytes_received();
+uint64_t monero_grpc_spool_bytes_buffered();
+uint64_t monero_grpc_spool_peak_bytes();
+uint64_t monero_grpc_spool_write_count();
+uint64_t monero_grpc_spool_read_count();
+uint64_t monero_grpc_spool_backpressure_count();
+int monero_grpc_spool_enabled();
+}
