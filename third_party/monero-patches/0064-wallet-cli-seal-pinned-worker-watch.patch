+  void write_private_new_binary_file(const boost::filesystem::path& path,
+                                     const unsigned char* bytes,
+                                     const std::size_t length,
+                                     const char* description)
+  {
+    if (path.empty() || bytes == nullptr || length == 0)
+      throw std::runtime_error(std::string(description) + " path is invalid");
+    const auto parent = path.parent_path().empty()
+      ? boost::filesystem::current_path() : path.parent_path();
+    if (!boost::filesystem::exists(parent) || boost::filesystem::is_symlink(parent) ||
+        !boost::filesystem::is_directory(parent) || boost::filesystem::exists(path) ||
+        boost::filesystem::is_symlink(path))
+      throw std::runtime_error(std::string(description) + " already exists or its path is unsafe");
+#ifndef _WIN32
+    const int output = ::open(path.string().c_str(), O_WRONLY | O_CREAT | O_EXCL, S_IRUSR | S_IWUSR);
+    if (output < 0)
+      throw std::runtime_error(std::string(description) + " could not be created");
+    std::size_t written = 0;
+    while (written < length)
+    {
+      const ssize_t result = ::write(output, bytes + written, length - written);
+      if (result <= 0)
+      {
+        ::close(output);
+        throw std::runtime_error(std::string(description) + " could not be written");
+      }
+      written += static_cast<std::size_t>(result);
+    }
+    if (::fsync(output) != 0 || ::close(output) != 0)
+    {
+      throw std::runtime_error(std::string(description) + " could not be committed");
+    }
+    sync_path(parent);
+#else
+    std::ofstream output(path.string(), std::ios::binary | std::ios::out);
+    output.write(reinterpret_cast<const char*>(bytes), length);
+    output.flush();
+    if (!output)
+    {
+      output.close();
+      throw std::runtime_error(std::string(description) + " could not be written");
+    }
+#endif
+    require_private_regular_file(path, description);
+    if (boost::filesystem::file_size(path) != length)
+    {
+      throw std::runtime_error(std::string(description) + " commit could not be verified");
+    }
+  }
