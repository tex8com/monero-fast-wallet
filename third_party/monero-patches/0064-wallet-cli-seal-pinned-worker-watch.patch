+  void seal_worker_watch(const options& input)
+  {
+    const persisted_fast_wallet metadata = read_metadata(input);
+    const Monero::NetworkType wallet_network = static_cast<Monero::NetworkType>(metadata.network);
+    if (input.network_explicit && input.network != wallet_network)
+      throw std::runtime_error("--network does not match the Fast Wallet network");
+    if (input.password_file.empty() || input.descriptor_file.empty() ||
+        input.assignment_handle_file.empty() || input.assignment_epoch == 0 ||
+        input.envelope_file.empty())
+      throw std::runtime_error("worker seal-watch requires password, descriptor, assignment and new envelope files");
+    if (input.restore_height != 0 && input.restore_height != metadata.restore_height)
+      throw std::runtime_error("--restore-height does not match this Fast Wallet");
+    static_cast<void>(plan(MFW_FAST_WALLET_OPERATION_ENROLL_WORKER, &metadata));
+
+    const persisted_paired_worker paired = read_paired_worker(input);
+    if (paired.network != metadata.network)
+      throw std::runtime_error("Fast Wallet Worker pairing network does not match this wallet");
+    const std::uint64_t now = input.now == 0 ? unix_seconds() : input.now;
+    if (now > std::numeric_limits<std::uint64_t>::max() - watch_lifetime_seconds)
+      throw std::runtime_error("Worker watch expiry is invalid");
+    const std::vector<unsigned char> descriptor = read_public_bounded_file(
+      input.descriptor_file, "Worker descriptor file", 4096);
+    std::array<unsigned char, 32> fresh_root{};
+    const std::int32_t verified = tex8_fast_wallet_protocol_descriptor_worker_root_id_v1(
+      descriptor.data(), descriptor.size(), static_cast<std::uint8_t>(metadata.network), now,
+      fresh_root.data(), fresh_root.size());
+    if (verified != TEX8_FAST_WALLET_PROTOCOL_OK || fresh_root != paired.worker_root_id)
+      throw std::runtime_error("Worker descriptor is invalid, expired, for another network, or does not match the pinned Worker");
+
+    std::string assignment_text = read_private_text_file(
+      input.assignment_handle_file, "Worker assignment handle file");
+    secret_string_guard assignment_text_guard(assignment_text);
+    std::vector<unsigned char> assignment_handle = decode_lowercase_hex(
+      assignment_text, 32, "Worker assignment handle file");
+    if (std::all_of(assignment_handle.begin(), assignment_handle.end(),
+                    [](const unsigned char value) { return value == 0; }))
+      throw std::runtime_error("Worker assignment handle file is invalid");
+
+    std::string password = read_private_text_file(input.password_file, "password file");
+    secret_string_guard password_guard(password);
+    Monero::WalletManager* manager = Monero::WalletManagerFactory::getWalletManager();
+    if (manager == nullptr) throw std::runtime_error("native Monero WalletManager is unavailable");
+    Monero::Wallet* wallet = nullptr;
+    std::array<unsigned char, TEX8_FAST_WALLET_PROTOCOL_WATCH_ENVELOPE_SIZE> envelope{};
+    try
+    {
+      wallet = manager->openWallet(input.wallet_path.string(), password, wallet_network);
+      wipe(password);
+      if (wallet == nullptr || wallet->status() != Monero::Wallet::Status_Ok)
+        throw std::runtime_error("Fast Wallet could not be opened");
+      if (wallet->nettype() != wallet_network)
+        throw std::runtime_error("Fast Wallet network does not match its lifecycle metadata");
+      std::string address = wallet->address();
+      secret_string_guard address_guard(address);
+      std::string private_view_key = wallet->secretViewKey();
+      secret_string_guard private_view_key_guard(private_view_key);
+      std::vector<unsigned char> private_view_key_bytes = decode_lowercase_hex(
+        private_view_key, 32, "Fast Wallet private View Key");
+      const std::int32_t sealed = tex8_fast_wallet_protocol_seal_watch_v1(
+        descriptor.data(), descriptor.size(), static_cast<std::uint8_t>(metadata.network),
+        assignment_handle.data(), input.assignment_epoch, now, now + watch_lifetime_seconds,
+        now, reinterpret_cast<const unsigned char*>(address.data()), address.size(),
+        private_view_key_bytes.data(), metadata.restore_height, envelope.data(), envelope.size());
+      std::fill(private_view_key_bytes.begin(), private_view_key_bytes.end(), 0);
+      if (sealed != TEX8_FAST_WALLET_PROTOCOL_OK)
+        throw std::runtime_error("Fast Wallet Worker watch encryption failed");
+      if (!manager->closeWallet(wallet, false))
+      {
+        wallet = nullptr;
+        throw std::runtime_error("Fast Wallet could not be closed after watch encryption");
+      }
+      wallet = nullptr;
+      write_private_new_binary_file(input.envelope_file, envelope.data(), envelope.size(),
+                                    "encrypted Worker watch envelope");
+      std::fill(envelope.begin(), envelope.end(), 0);
+      if (input.json)
+        std::cout << "{\"schema_version\":1,\"watch_envelope_sealed\":true,\"worker_enrolled\":false,\"network\":\""
+                  << network_name(wallet_network) << "\"}\n";
+      else
+        std::cout << "Encrypted Worker watch prepared locally. No View Key was displayed or transmitted.\n";
+    }
+    catch (...)
+    {
+      std::fill(assignment_handle.begin(), assignment_handle.end(), 0);
+      std::fill(envelope.begin(), envelope.end(), 0);
+      if (wallet != nullptr) manager->closeWallet(wallet, false);
+      throw;
+    }
+    std::fill(assignment_handle.begin(), assignment_handle.end(), 0);
+  }
 }
 
