+  std::vector<unsigned char> decode_lowercase_hex(const std::string& value,
+                                                   const std::size_t required_bytes,
+                                                   const char* description)
+  {
+    if (value.size() != required_bytes * 2)
+      throw std::runtime_error(std::string(description) + " has an invalid length");
+    std::vector<unsigned char> output(required_bytes);
+    for (std::size_t index = 0; index < required_bytes; ++index)
+    {
+      const char high = value[index * 2];
+      const char low = value[index * 2 + 1];
+      const auto nibble = [](const char character) -> unsigned char
+      {
+        if (character >= '0' && character <= '9') return static_cast<unsigned char>(character - '0');
+        if (character >= 'a' && character <= 'f') return static_cast<unsigned char>(character - 'a' + 10);
+        throw std::runtime_error("hex data is not canonical lowercase hex");
+      };
+      output[index] = static_cast<unsigned char>((nibble(high) << 4) | nibble(low));
+    }
+    return output;
+  }
