diff --git a/src/wallet/wallet2.cpp b/src/wallet/wallet2.cpp
index 646577b..6379383 100644
--- a/src/wallet/wallet2.cpp
+++ b/src/wallet/wallet2.cpp
@@ -3442,8 +3442,9 @@ bool wallet2::try_pull_blocks_grpc(bool first, uint64_t start_height,
