+
+impl LaneSchedule {
+    fn new(
+        start_height: u64,
+        stop_height: u64,
+        stripe_span_blocks: u32,
+        lane_index: u32,
+        lane_count: u32,
+    ) -> Result<Self, String> {
+        if stop_height == 0 || stop_height < start_height {
+            return Err("StreamBlockLane requires a finite non-empty range".to_string());
+        }
+        let stripe_span = usize::try_from(stripe_span_blocks)
+            .map_err(|_| "stripe span does not fit this server".to_string())?;
+        if !(MIN_CHUNK_BLOCKS..=MAX_CHUNK_BLOCKS).contains(&stripe_span) {
+            return Err(format!(
+                "stripe_span_blocks must be in {MIN_CHUNK_BLOCKS}..={MAX_CHUNK_BLOCKS}"
+            ));
+        }
+        let lane_count = usize::try_from(lane_count)
+            .map_err(|_| "lane count does not fit this server".to_string())?;
+        let lane_index = usize::try_from(lane_index)
+            .map_err(|_| "lane index does not fit this server".to_string())?;
+        if lane_count == 0 || lane_count > MAX_LANE_COUNT {
+            return Err(format!("lane_count must be in 1..={MAX_LANE_COUNT}"));
+        }
+        if lane_index >= lane_count {
+            return Err("lane_index must be smaller than lane_count".to_string());
+        }
+        let base_height = usize::try_from(start_height)
+            .map_err(|_| "start height does not fit this server".to_string())?;
+        let stop_height = usize::try_from(stop_height)
+            .map_err(|_| "stop height does not fit this server".to_string())?;
+        stripe_span
+            .checked_mul(lane_count)
+            .and_then(|stride| base_height.checked_add(stride))
+            .ok_or_else(|| "lane schedule overflows this server".to_string())?;
+        Ok(Self {
+            base_height,
+            stop_height,
+            stripe_span,
+            lane_index,
+            lane_count,
+        })
+    }
+
+    fn first_height(self) -> Result<Option<usize>, Error> {
+        let offset = self
+            .stripe_span
+            .checked_mul(self.lane_index)
+            .ok_or_else(|| Error::msg("lane first-height multiplication overflow"))?;
+        let first = self
+            .base_height
+            .checked_add(offset)
+            .ok_or_else(|| Error::msg("lane first-height overflow"))?;
+        Ok((first <= self.stop_height).then_some(first))
+    }
+
+    fn stripe_bounds(self, height: usize) -> Result<(usize, usize), Error> {
+        let relative = height
+            .checked_sub(self.base_height)
+            .ok_or_else(|| Error::msg("lane height precedes requested base"))?;
+        let stripe_ordinal = relative / self.stripe_span;
+        if stripe_ordinal % self.lane_count != self.lane_index {
+            return Err(Error::msg("height is outside the assigned lane stripes"));
+        }
+        let stripe_start = self
+            .base_height
+            .checked_add(
+                stripe_ordinal
+                    .checked_mul(self.stripe_span)
+                    .ok_or_else(|| Error::msg("lane stripe multiplication overflow"))?,
+            )
+            .ok_or_else(|| Error::msg("lane stripe start overflow"))?;
+        let stripe_end = stripe_start
+            .checked_add(self.stripe_span - 1)
+            .map_or(self.stop_height, |end| end.min(self.stop_height));
+        if height < stripe_start || height > stripe_end {
+            return Err(Error::msg("height is outside the current lane stripe"));
+        }
+        Ok((stripe_start, stripe_end))
+    }
+
+    fn fetch_stop_height(self, height: usize) -> Result<u64, Error> {
+        let (_, stripe_end) = self.stripe_bounds(height)?;
+        u64::try_from(stripe_end).map_err(Error::from)
+    }
+
+    fn following_height(self, start: usize, blocks: usize) -> Result<Option<usize>, Error> {
+        if blocks == 0 {
+            return Err(Error::msg("zero-sized lane chunk"));
+        }
+        let (stripe_start, stripe_end) = self.stripe_bounds(start)?;
+        let end = start
+            .checked_add(blocks)
+            .ok_or_else(|| Error::msg("lane chunk end overflow"))?;
+        let stripe_end_exclusive = stripe_end
+            .checked_add(1)
+            .ok_or_else(|| Error::msg("lane stripe end overflow"))?;
+        if end < stripe_end_exclusive {
+            return Ok(Some(end));
+        }
+        if end > stripe_end_exclusive {
+            return Err(Error::msg("lane chunk crossed its stripe boundary"));
+        }
+        let stride = self
+            .stripe_span
+            .checked_mul(self.lane_count)
+            .ok_or_else(|| Error::msg("lane stride overflow"))?;
+        let next = stripe_start
+            .checked_add(stride)
+            .ok_or_else(|| Error::msg("next lane stripe overflow"))?;
+        Ok((next <= self.stop_height).then_some(next))
+    }
+}
