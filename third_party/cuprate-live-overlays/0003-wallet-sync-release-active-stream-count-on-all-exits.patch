 static REQUEST_COUNTER: AtomicU64 = AtomicU64::new(0);
 static ACTIVE_STREAMS: AtomicU64 = AtomicU64::new(0);
 
+/// Owns one entry in `ACTIVE_STREAMS`. Keeping the guard inside the spawned
+/// producer future makes cancellation, early returns and unwinding release
+/// the telemetry slot as well as the normal completion path.
+struct ActiveStreamGuard;
+
+impl ActiveStreamGuard {
+    fn acquire() -> (Self, u64) {
+        let active = ACTIVE_STREAMS.fetch_add(1, Ordering::SeqCst) + 1;
+        (Self, active)
+    }
+
+    fn remaining_after_drop(&self) -> u64 {
+        ACTIVE_STREAMS.load(Ordering::SeqCst).saturating_sub(1)
+    }
+}
+
+impl Drop for ActiveStreamGuard {
+    fn drop(&mut self) {
+        // A saturating update keeps diagnostics safe even if a future code
+        // path accidentally tries to release an unregistered stream.
+        let _ = ACTIVE_STREAMS.fetch_update(Ordering::SeqCst, Ordering::SeqCst, |active| {
+            Some(active.saturating_sub(1))
+        });
+    }
+}
