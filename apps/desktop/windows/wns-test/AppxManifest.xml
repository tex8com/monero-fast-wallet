<?xml version="1.0" encoding="utf-8"?>
<!--
  Development-only MSIX wrapper for exercising WNS with the actual Store
  identity. Production builds are signed through the Microsoft Store; the
  local certificate used by the companion script is trusted only in the test
  VM and must never ship with a release.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">
  <Identity
    Name="TEX8LLP.Monero"
    Publisher="CN=DF621DE2-61A1-469F-AABA-73A338CFF2AE"
    Version="0.1.0.0"
    ProcessorArchitecture="arm64" />
  <Properties>
    <DisplayName>Monero Fast Wallet</DisplayName>
    <PublisherDisplayName>TEX8 LLP</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Applications>
    <Application Id="App" Executable="monero-wallet-desktop.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Monero Fast Wallet"
        Description="Self-custodial Monero wallet"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>
  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
