{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Least-privilege capability for the packaged desktop wallet window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "notification:default",
    "allow-wallet-core-status",
    "allow-app-protection-status",
    "allow-set-app-protection-password",
    "allow-verify-app-protection-password",
    "allow-clear-app-protection-password",
    "allow-lock-app",
    "allow-fetch-market-backup",
    "allow-ledger-transport-status",
    "allow-store-wallet-password",
    "allow-delete-wallet-password",
    "allow-create-wallet",
    "allow-restore-wallet",
    "allow-create-hardware-wallet",
    "allow-enable-ledger-read-only",
    "allow-create-ledger-read-only-from-device",
    "allow-open-wallet",
    "allow-close-wallet",
    "allow-rename-wallet",
    "allow-remove-registered-wallet",
    "allow-list-registered-wallets",
    "allow-activate-registered-wallet",
    "allow-mark-wallet-seed-backed-up",
    "allow-list-fast-wallets",
    "allow-open-fast-wallet",
    "allow-close-fast-wallet",
    "allow-create-fast-wallet",
    "allow-enable-fast-wallet",
    "allow-enable-ledger-fast-wallet",
    "allow-refresh-fast-wallet-status",
    "allow-poll-fast-wallet-push-signals",
    "allow-notification-installation-status",
    "allow-request-notification-installation",
    "allow-disable-notification-installation",
    "allow-consume-pending-notification-open",
    "allow-background-notification-agent-config-path",
    "allow-disable-fast-wallet",
    "allow-load-node-settings",
    "allow-save-node-settings",
    "allow-set-daemon",
    "allow-start-wallet-refresh",
    "allow-stop-wallet-refresh",
    "allow-wallet-address",
    "allow-wallet-recovery-seed",
    "allow-wallet-snapshot",
    "allow-registered-wallet-snapshots",
    "allow-wallet-balance",
    "allow-wallet-unlocked-balance",
    "allow-create-subaddress",
    "allow-wallet-transactions",
    "allow-prepare-transaction",
    "allow-commit-transaction",
    "allow-wallet-hardware-status",
    "allow-reconnect-hardware-wallet",
    "allow-show-hardware-wallet-address",
    "allow-community-load-profile",
    "allow-community-update-profile",
    "allow-community-list-nearby",
    "allow-community-list-contacts",
    "allow-community-request-contact",
    "allow-community-accept-contact",
    "allow-community-list-messages",
    "allow-community-send-message",
    "allow-community-block-profile",
    "allow-community-report-profile",
    "allow-community-delete-identity"
  ]
}
