# Monero Fast Wallet - Windows Push Notification Services (WNS)
# Package identity values may be used for local MSIX/WNS diagnostics.
# These placeholders identify a multi-tenant Entra app registered for the
# Windows App SDK notification flow. A packaged production app also needs its
# PFN mapped to that Entra app by Microsoft before WNS can deliver pushes.
# The client secret belongs only in the server secret store as
# NOTIFICATION_GATEWAY_WNS_CLIENT_SECRET. It must never be loaded by the
# desktop app, committed, or printed. Never commit .env.wns.local.

WNS_AZURE_APPLICATION_ID="<application-client-id>"
WNS_AZURE_TENANT_ID="<directory-tenant-id>"
WNS_AZURE_OBJECT_ID="<service-principal-object-id>"
WNS_PACKAGE_FAMILY_NAME="<store-package-family-name>"
WNS_PACKAGE_IDENTITY_NAME="<store-package-identity-name>"
