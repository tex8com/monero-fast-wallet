{
  "name": "MoneroWallet",
  "version": "0.0.1",
  "private": true,
  "packageManager": "npm@11.16.0",
  "scripts": {
    "android": "bash scripts/android-build-install.sh",
    "android:build": "bash scripts/android-build.sh",
    "android:build-install": "bash scripts/android-build-install.sh",
    "android:diagnostics": "bash scripts/android-diagnostics.sh",
    "android:logs": "bash scripts/android-logs.sh",
    "check:node": "bash scripts/check-node.sh",
    "ios": "react-native run-ios",
    "ios:build-install": "bash scripts/ios-build-install.sh",
    "ios:build-install-debug": "MONERO_WALLET_IOS_CONFIGURATION=Debug bash scripts/ios-build-install.sh",
    "ios:build-simulator-core": "bash scripts/ios-build-simulator-core.sh",
    "ios:diagnostics": "bash scripts/ios-diagnostics.sh",
    "ios:logs": "bash scripts/ios-logs.sh",
    "ios:metro": "bash scripts/ios-ensure-metro.sh",
    "firebase:check": "node scripts/check-firebase-config.js",
    "test:build-integrity": "node scripts/test-build-integrity-contract.js",
    "test:dependency-compat": "node scripts/test-brace-expansion-compat.js",
    "test:release-contract": "node scripts/test-release-signing-contract.js",
    "test:security": "npm run test:dependency-compat && npm run test:build-integrity && npm run test:release-contract && npm run lint && npm test -- --runInBand",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest"
  },
  "codegenConfig": {
    "name": "NativeMoneroWalletSpec",
    "type": "modules",
    "jsSrcsDir": "specs",
    "android": {
      "javaPackageName": "com.monerowallet"
    },
    "ios": {
      "modulesProvider": {
        "NativeMoneroWallet": "RCTNativeMoneroWallet"
      }
    }
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-firebase/app": "^24.0.0",
    "@react-native-firebase/messaging": "^24.0.0",
    "@react-native/new-app-screen": "0.85.1",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/native": "^7.2.2",
    "react": "19.2.3",
    "react-native": "0.85.1",
    "react-native-camera-kit": "^18.0.0",
    "react-native-clipboard": "^0.0.5",
    "react-native-gesture-handler": "^2.31.1",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-permissions": "^5.6.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "^4.24.0",
    "react-native-svg": "^15.15.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.85.1",
    "@react-native/eslint-config": "0.85.1",
    "@react-native/jest-preset": "0.85.1",
    "@react-native/metro-config": "0.85.1",
    "@react-native/typescript-config": "0.85.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "brace-expansion": "file:vendor/brace-expansion-compat",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-native-svg-transformer": "^1.5.3",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "overrides": {
    "brace-expansion": "$brace-expansion"
  },
  "allowScripts": {
    "@firebase/util@1.14.0": true,
    "protobufjs@7.6.5": true,
    "fsevents": false
  }
}
