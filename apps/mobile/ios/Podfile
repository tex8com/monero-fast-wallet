# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

require_relative '../node_modules/react-native-permissions/scripts/setup'

ENV['RCT_USE_PREBUILT_RNCORE'] = '0'

platform :ios, min_ios_version_supported
prepare_react_native_project!

# QR recipient scanning needs only the camera permission handler. Keeping this
# explicit prevents unused permission handlers from being compiled into iOS.
setup_permissions([
  'Camera',
])

linkage = ENV.fetch('USE_FRAMEWORKS', 'static')
Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
use_frameworks! :linkage => linkage.to_sym
$RNFirebaseAsStaticFramework = linkage == 'static'

target 'MoneroWallet' do
  config = use_native_modules!
  pod 'libPhoneNumber-iOS', '~> 1.7.3'
  # App-private Tor 0.4.9.11 for the same direct-Onion service transport used
  # by Android and Tauri. The MFN gRPC block stream remains separate.
  pod 'Tor', '409.11.1'

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # The pod ships an Objective-C wrapper named `Tor` plus the actual C
    # runtime as `tor.framework`. Framework names are case-insensitive at link
    # time, so the second framework can otherwise be treated as a duplicate.
    # Force-load the vendored runtime without changing the pod's public module.
    installer.aggregate_targets.map(&:user_project).uniq.each do |user_project|
      user_project.native_targets.each do |target|
        next unless target.name == 'MoneroWallet'

        target.build_configurations.each do |build_config|
          flags = Array(build_config.build_settings['OTHER_LDFLAGS'])
          flags.unshift('$(inherited)') unless flags.include?('$(inherited)')
          runtime = '$(PODS_XCFRAMEWORKS_BUILD_DIR)/Tor/CTor/tor.framework/tor'
          unless flags.include?(runtime)
            flags.concat(['-force_load', runtime])
          end
          build_config.build_settings['OTHER_LDFLAGS'] = flags
        end
      end
      user_project.save
    end
  end
end
