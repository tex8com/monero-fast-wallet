{
  "sourceLanguage": "en",
  "strings": {
    "NSLocationWhenInUseUsageDescription": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Location is used only when you enable nearby Monero Enthusiast discovery. The app reduces it to an approximate area and never displays your exact position."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Standort wird nur verwendet, wenn du die Monero Enthusiast-Suche in deiner Nähe aktivierst. Die App reduziert ihn auf ein ungefähres Gebiet und zeigt niemals deine genaue Position an."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "La ubicación solo se usa cuando activas el descubrimiento de Monero Enthusiast cercanos. La app la reduce a una zona aproximada y nunca muestra tu posición exacta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A localização só é usada quando você ativa a descoberta de Monero Enthusiast próximos. O app a reduz a uma área aproximada e nunca mostra sua posição exata."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Геопозиция используется только при включённом поиске Monero Enthusiast поблизости. Приложение округляет её до примерной области и никогда не показывает точное местоположение."
          }
        },
        "vi-VN": {
          "stringUnit": {
            "state": "translated",
            "value": "Vị trí chỉ được dùng khi bạn bật tìm Monero Enthusiast gần đó. Ứng dụng làm tròn thành khu vực gần đúng và không bao giờ hiển thị vị trí chính xác."
          }
        },
        "id-ID": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokasi hanya digunakan saat Anda mengaktifkan penemuan Monero Enthusiast terdekat. Aplikasi membulatkannya menjadi area perkiraan dan tidak pernah menampilkan posisi tepat Anda."
          }
        },
        "uk-UA": {
          "stringUnit": {
            "state": "translated",
            "value": "Геопозиція використовується лише коли ви вмикаєте пошук Monero Enthusiast поруч. Застосунок округлює її до приблизної області та ніколи не показує ваше точне місцезнаходження."
          }
        },
        "tr-TR": {
          "stringUnit": {
            "state": "translated",
            "value": "Konum yalnızca yakındaki Monero Enthusiast keşfini etkinleştirdiğinizde kullanılır. Uygulama konumu yaklaşık bir alana yuvarlar ve kesin konumunuzu asla göstermez."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थान का उपयोग केवल तभी होता है जब आप पास के Monero Enthusiast की खोज चालू करते हैं। ऐप इसे एक अनुमानित क्षेत्र तक सीमित करता है और आपका सटीक स्थान कभी नहीं दिखाता।"
          }
        },
        "ur-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "مقام صرف اس وقت استعمال ہوتا ہے جب آپ قریبی Monero Enthusiast کی تلاش فعال کرتے ہیں۔ ایپ اسے ایک تقریبی علاقے تک محدود کرتی ہے اور آپ کا عین مقام کبھی نہیں دکھاتی۔"
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "La localisation n'est utilisée que lorsque vous activez la recherche de Monero Enthusiast à proximité. L'app la réduit à une zone approximative et n'affiche jamais votre position exacte."
          }
        },
        "fil-PH": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginagamit lang ang lokasyon kapag in-enable mo ang paghahanap ng kalapit na Monero Enthusiast. Ginagawa itong tinatayang lugar ng app at hindi kailanman ipinapakita ang eksaktong posisyon mo."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報は、近くの Monero Enthusiast 検索を有効にした場合にのみ使用されます。アプリは概算エリアに丸め、正確な位置を表示しません。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "위치는 근처 Monero Enthusiast 탐색을 켤을 때만 사용됩니다. 앱은 위치를 대략적인 영역으로 반올림하며 정확한 위치를 표시하지 않습니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستخدم الموقع فقط عند تفعيل اكتشاف Monero Enthusiast القريبين. يحوّله التطبيق إلى منطقة تقريبية ولا يعرض موقعك الدقيق أبدًا."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "仅当您启用附近 Monero Enthusiast 发现功能时才会使用位置。应用会将其简化为大致区域，绝不显示您的准确位置。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在您啟用附近 Monero Enthusiast 探索時才會使用位置。應用程式會將其簡化為大致區域，絕不顯示您的精確位置。"
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth is used to connect to Ledger Nano hardware wallets."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth wird zur Verbindung mit Ledger-Nano-Hardware-Wallets verwendet."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth se usa para conectar wallets de hardware Ledger Nano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Bluetooth é usado para conectar carteiras de hardware Ledger Nano."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth используется для подключения аппаратных кошельков Ledger Nano."
          }
        },
        "vi-VN": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth được dùng để kết nối ví phần cứng Ledger Nano."
          }
        },
        "id-ID": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth digunakan untuk menghubungkan hardware wallet Ledger Nano."
          }
        },
        "uk-UA": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth використовується для підключення апаратних гаманців Ledger Nano."
          }
        },
        "tr-TR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth, Ledger Nano donanım cüzdanlarına bağlanmak için kullanılır."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth का उपयोग Ledger Nano हार्डवेयर वॉलेट से जुड़ने के लिए होता है।"
          }
        },
        "ur-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth کا استعمال Ledger Nano ہارڈویئر والٹ سے جڑنے کے لیے ہوتا ہے۔"
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth sert à connecter les portefeuilles matériels Ledger Nano."
          }
        },
        "fil-PH": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginagamit ang Bluetooth para kumonekta sa Ledger Nano hardware wallet."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth は Ledger Nano ハードウェアウォレットへの接続に使用されます。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth는 Ledger Nano 하드웨어 지갑 연결에 사용됩니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستخدم Bluetooth للاتصال بمحافظ Ledger Nano للأجهزة."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth 用于连接 Ledger Nano 硬件钱包。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth 用於連接 Ledger Nano 硬體錢包。"
          }
        }
      }
    },
