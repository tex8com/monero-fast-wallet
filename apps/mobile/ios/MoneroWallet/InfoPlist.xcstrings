    "NSCameraUsageDescription": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera access is used only to scan a Monero receiving-address QR code."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kamerazugriff wird nur zum Scannen eines QR-Codes mit einer Monero-Empfangsadresse verwendet."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a la cámara solo se usa para escanear el código QR de una dirección de recepción Monero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso à câmera só é usado para ler o código QR de um endereço de recebimento Monero."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к камере нужен только для сканирования QR-кода адреса получения Monero."
          }
        },
        "vi-VN": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền camera chỉ được dùng để quét mã QR địa chỉ nhận Monero."
          }
        },
        "id-ID": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses kamera hanya digunakan untuk memindai kode QR alamat penerimaan Monero."
          }
        },
        "uk-UA": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ до камери потрібен лише для сканування QR-коду адреси отримання Monero."
          }
        },
        "tr-TR": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera erişimi yalnızca bir Monero alıcı adresi QR kodunu taramak için kullanılır."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरा एक्सेस का उपयोग केवल Monero प्राप्ति पते के QR कोड को स्कैन करने के लिए होता है।"
          }
        },
        "ur-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "کیمرہ تک رسائی صرف Monero وصولی پتے کا QR کوڈ اسکین کرنے کے لیے استعمال ہوتی ہے۔"
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès à la caméra sert uniquement à scanner le code QR d'une adresse de réception Monero."
          }
        },
        "fil-PH": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginagamit lang ang camera para i-scan ang QR code ng Monero receiving address."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラは Monero 受取アドレスの QR コードのスキャンにのみ使用されます。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라는 Monero 수신 주소 QR 코드 스캔에만 사용됩니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستخدم الوصول إلى الكاميرا فقط لمسح رمز QR لعنوان استلام Monero."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "相机权限仅用于扫描 Monero 收款地址二维码。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "相機權限僅用於掃描 Monero 收款地址 QR 碼。"
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID is used to unlock Monero Fast Wallet securely on this device."
          }
        },
        "de-DE": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID wird verwendet, um Monero Fast Wallet auf diesem Gerät sicher zu entsperren."
          }
        },
        "es-ES": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID se usa para desbloquear Monero Fast Wallet de forma segura en este dispositivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Face ID é usado para desbloquear a Monero Fast Wallet com segurança neste dispositivo."
          }
        },
        "ru-RU": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID используется для безопасной разблокировки Monero Fast Wallet на этом устройстве."
          }
        },
        "vi-VN": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID được dùng để mở khóa Monero Fast Wallet an toàn trên thiết bị này."
          }
        },
        "id-ID": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID digunakan untuk membuka kunci Monero Fast Wallet dengan aman di perangkat ini."
          }
        },
        "uk-UA": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID використовується для безпечного розблокування Monero Fast Wallet на цьому пристрої."
          }
        },
        "tr-TR": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID, bu cihazda Monero Fast Wallet uygulamasını güvenli biçimde açmak için kullanılır."
          }
        },
        "hi-IN": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID का उपयोग इस डिवाइस पर Monero Fast Wallet को सुरक्षित रूप से अनलॉक करने के लिए होता है।"
          }
        },
        "ur-PK": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID کا استعمال اس ڈیوائس پر Monero Fast Wallet کو محفوظ طریقے سے کھولنے کے لیے ہوتا ہے۔"
          }
        },
        "fr-FR": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID sert à déverrouiller Monero Fast Wallet en toute sécurité sur cet appareil."
          }
        },
        "fil-PH": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginagamit ang Face ID para ligtas na i-unlock ang Monero Fast Wallet sa device na ito."
          }
        },
        "ja-JP": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID は、このデバイスで Monero Fast Wallet を安全にロック解除するために使用されます。"
          }
        },
        "ko-KR": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID는 이 기기에서 Monero Fast Wallet의 잠금을 안전하게 해제하는 데 사용됩니다."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستخدم Face ID لفتح Monero Fast Wallet بأمان على هذا الجهاز."
          }
        },
        "zh-CN": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID 用于在此设备上安全解锁 Monero Fast Wallet。"
          }
        },
        "zh-TW": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID 用於在此裝置上安全解鎖 Monero Fast Wallet。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
