# Managed by com.tex8.monerowallet.desktop.notification-agent.v1
[Unit]
Description=Monero Fast Wallet background notification agent
Documentation=https://tex8.com
StartLimitIntervalSec=0

[Service]
Type=simple
UMask=0077
ExecStart=@AGENT_EXEC@ --config @AGENT_CONFIG@
Environment=@AGENT_LIBRARY_ENV@
Restart=on-failure
RestartSec=15
TimeoutStopSec=10
# Preserve host UIDs for Arti's ownership checks and AppImage's fusermount.
# PrivateTmp in an unprivileged user service implicitly enables PrivateUsers.
PrivateUsers=false

[Install]
WantedBy=default.target
