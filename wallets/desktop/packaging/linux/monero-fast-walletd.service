# Managed by com.tex8.monerowallet.desktop.notification-agent.v1
[Unit]
Description=Monero Fast Wallet background notification agent
Documentation=https://tex8.com
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=@AGENT_EXEC@ --config @AGENT_CONFIG@
Environment=@AGENT_LIBRARY_ENV@
Restart=on-failure
RestartSec=15
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
