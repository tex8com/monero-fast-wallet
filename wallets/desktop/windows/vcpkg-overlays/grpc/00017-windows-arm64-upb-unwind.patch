diff --git a/CMakeLists.txt b/CMakeLists.txt
index fbfac7d..c53bff5 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -4757,6 +4757,15 @@ add_library(upb_wire_lib
   third_party/upb/upb/wire/reader.c
 )

+# LLVM-MinGW cannot emit SEH unwind metadata for encode_longvarint on
+# Windows ARM64. This file contains plain C serialization helpers and does
+# not throw across the ABI boundary, so omit unwind tables only here.
+if(WIN32 AND CMAKE_C_COMPILER_ID MATCHES "Clang"
+   AND CMAKE_SYSTEM_PROCESSOR MATCHES "^(ARM64|aarch64)$")
+  set_source_files_properties(third_party/upb/upb/wire/encode.c PROPERTIES
+    COMPILE_OPTIONS "-fno-asynchronous-unwind-tables;-fno-unwind-tables")
+endif()
+
 target_compile_features(upb_wire_lib PUBLIC cxx_std_17)

 set_target_properties(upb_wire_lib PROPERTIES
