MFW_CLAIM_BIND=127.0.0.1:8101
# Restricted RPC of the configured canonical MFN, loopback or private IP only.
MFW_CLAIM_DAEMON_ORIGIN=http://127.0.0.1:18089
MFW_CLAIM_DATABASE=/var/lib/mfw-claim-relay/queue.sqlite3
MFW_CLAIM_STORAGE_KEY_FILE=/etc/monero-fast-wallet/mfw-claim-storage.key
MFW_CLAIM_GATEWAY_ORIGIN=http://127.0.0.1:8090
MFW_CLAIM_NOTIFICATION_KEY_FILE=/etc/monero-fast-wallet/mfw-claim-notification.key
