[Unit]
Description=Monero enthusiast discovery service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=monero-community
Group=monero-community
Environment=ENTHUSIAST_DISCOVERY_BIND=127.0.0.1:8089
Environment=ENTHUSIAST_DISCOVERY_DB=/var/lib/enthusiast-discovery/community.json.enc
EnvironmentFile=/etc/monero-fast-wallet/enthusiast-discovery.env
ExecStart=/usr/local/bin/enthusiast-discovery
Restart=on-failure
RestartSec=3
StateDirectory=enthusiast-discovery
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/enthusiast-discovery
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
